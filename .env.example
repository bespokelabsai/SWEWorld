# =============================================================================
# SWEWorld — optional environment for the ingestion scripts
# =============================================================================
# The world image needs none of this: every service is configured at image build
# and the credentials live at http://pass.world.local (and in the passstore page
# baked into the image).
#
# This file only matters when running scripts/ingest_*.py from OUTSIDE the
# container against a running world. Inside the container the scripts fall back
# to these same defaults, so no .env is required there.
# =============================================================================

# Base domain. Every service is reached at <name>.$WORLD_DOMAIN through nginx.
WORLD_DOMAIN=world.local

# One identity, admin on every service.
WORLD_ADMIN_USER=worldadmin
WORLD_ADMIN_PASSWORD=worldadmin
WORLD_ADMIN_EMAIL=worldadmin@world.local

# Password given to persona mailboxes and Gitea accounts that ingestion creates.
# Uniform on purpose: these are disposable local credentials, and keeping them
# out of data/identities.yaml avoids per-user secrets in version control.
# At least 8 characters: Gitea refuses to create an account with less.
MAIL_PERSONA_PASSWORD=persona-world

# Gitea API token. Inside the world this is read from /etc/sweworld/gitea-token;
# set it here only when running the scripts from outside.
GITEA_API_TOKEN=

# BookStack API token (Settings -> API Tokens). Only needed for ingest_docs.py
# when run from outside the container.
BOOKSTACK_TOKEN_ID=
BOOKSTACK_TOKEN_SECRET=

# Mattermost team the chat history is imported into.
MM_TEAM_NAME=world

# Ports, when reaching the world from outside the container.
HTTP_PORT=80
SMTP_PORT=25
SUBMISSION_PORT=587
IMAP_PORT=143
