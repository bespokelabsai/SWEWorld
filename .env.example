# =============================================================================
# SWEWorld — environment template
# =============================================================================
# Copy to .env and fill in. Values marked [BOOTSTRAP] are written for you by
# scripts/bootstrap.sh after the stack is running — leave the placeholder until
# then. Values marked [MANUAL] require a browser step that cannot be automated.
#
#   cp .env.example .env && ./scripts/bootstrap.sh
#
# Nothing here should ever face a network. These are deliberately weak,
# human-readable credentials for a disposable local world.
#
# TLS: there are no certificate secrets in this file. scripts/gen-certs.sh
# generates a local CA into config/tls/ (gitignored). Every service is HTTPS --
# not a preference, but a requirement: Outline hardcodes a Secure flag on its
# OAuth cookie, so login over plain HTTP fails outright.
# =============================================================================


# -----------------------------------------------------------------------------
# Global
# -----------------------------------------------------------------------------
# Base domain. Every service is routed at <service>.$WORLD_DOMAIN through
# Traefik. Changing this means re-running scripts/hosts.sh and re-issuing the
# Gitea OAuth app (the redirect URI is domain-bound).
WORLD_DOMAIN=world.local

# Timezone applied to every container. Affects timestamps that ingested content
# will be interleaved with, so keep it stable once you generate data.
TZ=UTC


# =============================================================================
# ADMIN / AGENT CREDENTIALS  —  the single source of truth
# =============================================================================
# One identity, admin on every service. These are the credentials an agent
# operating in this world signs in with, and the ones the ingestion scripts
# authenticate as.
#
# Change WORLD_ADMIN_PASSWORD here and re-run ./scripts/bootstrap.sh — it
# propagates the value into the per-service variables below AND resets the
# password on any account that already exists. Nothing else to edit.
#
#   Gitea       https://git.world.local     $WORLD_ADMIN_USER  / $WORLD_ADMIN_PASSWORD
#   Mattermost  https://chat.world.local    $WORLD_ADMIN_USER  / $WORLD_ADMIN_PASSWORD
#   Outline     https://docs.world.local    "Sign in with Gitea" — same credentials,
#                                           no separate password (Outline has no
#                                           password login of its own)
#   Roundcube   https://mail.world.local    $WORLD_ADMIN_EMAIL / $WORLD_ADMIN_PASSWORD
#
# Gitea reserves the literal username "admin"; anything else is fine.
WORLD_ADMIN_USER=worldadmin
WORLD_ADMIN_PASSWORD=worldadmin-dev-password
WORLD_ADMIN_EMAIL=worldadmin@world.local


# -----------------------------------------------------------------------------
# Gitea  →  https://git.world.local
# -----------------------------------------------------------------------------
# Also acts as the OIDC identity provider for Outline (see OUTLINE_OIDC_* below).
GITEA_DB_NAME=gitea
GITEA_DB_USER=gitea
# Any string. Only ever travels over the internal docker network.
GITEA_DB_PASSWORD=change-me-gitea-db

# [DERIVED] Overwritten from WORLD_ADMIN_* by bootstrap.sh. Edit those, not
# these. They exist as separate keys only because docker compose cannot expand
# one .env value inside another.
GITEA_ADMIN_USER=worldadmin
GITEA_ADMIN_PASSWORD=worldadmin-dev-password
GITEA_ADMIN_EMAIL=worldadmin@world.local

# [BOOTSTRAP] Personal access token used by scripts/ingest_git.py to create
# repos and push. Generated by:
#   gitea admin user generate-access-token -u $GITEA_ADMIN_USER --scopes all
# To mint one by hand instead: Gitea UI → Settings → Applications →
# Generate New Token (scopes: repo, user).
GITEA_API_TOKEN=


# -----------------------------------------------------------------------------
# Outline  →  https://docs.world.local
# -----------------------------------------------------------------------------
OUTLINE_DB_NAME=outline
OUTLINE_DB_USER=outline
OUTLINE_DB_PASSWORD=change-me-outline-db

# Both must be 32 random bytes, hex-encoded. Generate with:
#   openssl rand -hex 32
# Outline refuses to boot if these are missing or malformed.
OUTLINE_SECRET_KEY=
OUTLINE_UTILS_SECRET=

# [BOOTSTRAP] OAuth2 client registered *in Gitea* on Outline's behalf. Created
# by bootstrap.sh via POST /api/v1/user/applications/oauth2 with redirect URI
#   https://docs.world.local/auth/oidc.callback
# To do it by hand: Gitea UI → Settings → Applications → OAuth2 Applications.
# Outline has no password login — without these you cannot sign in at all.
OUTLINE_OIDC_CLIENT_ID=
OUTLINE_OIDC_CLIENT_SECRET=

# [BOOTSTRAP] API token for scripts/ingest_docs.py. Outline exposes no endpoint
# to mint a token without a browser session, so scripts/mint_outline_token.py
# drives the Gitea OIDC login headlessly and writes the result here. That first
# login is also what provisions the Outline user and workspace — they cannot be
# pre-created. To do it by hand instead: sign in at https://docs.world.local via
# the "Gitea" button, then Settings → API Tokens → New token.
OUTLINE_API_TOKEN=


# -----------------------------------------------------------------------------
# MinIO (S3 storage backing Outline's uploads)
# -----------------------------------------------------------------------------
# Root credentials double as the S3 access key / secret Outline authenticates
# with — Outline reads them as AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
# MinIO enforces: user >= 3 chars, password >= 8 chars.
MINIO_ROOT_USER=worldminio
MINIO_ROOT_PASSWORD=change-me-minio-root
MINIO_BUCKET=outline


# -----------------------------------------------------------------------------
# Mattermost  →  https://chat.world.local
# -----------------------------------------------------------------------------
MM_DB_NAME=mattermost
MM_DB_USER=mattermost
MM_DB_PASSWORD=change-me-mattermost-db

# [DERIVED] Overwritten from WORLD_ADMIN_* by bootstrap.sh. Created through
# `mmctl --local`, which needs no token because it talks over a unix socket
# inside the container. The account is granted system_admin.
MM_ADMIN_USER=worldadmin
MM_ADMIN_PASSWORD=worldadmin-dev-password
MM_ADMIN_EMAIL=worldadmin@world.local

# Team the chat history is imported into. scripts/ingest_chat.py references
# this, and Mattermost's bulk import format keys every channel to a team name.
MM_TEAM_NAME=world
MM_TEAM_DISPLAY_NAME=World

# [BOOTSTRAP] Token for any REST calls that mmctl cannot cover. Generated by:
#   mmctl --local token generate $MM_ADMIN_USER ingest
# Note: ingest_chat.py primarily uses `mmctl import`, which runs in local mode
# and does not need this.
MM_API_TOKEN=


# -----------------------------------------------------------------------------
# Maddy (SMTP + IMAP)  →  smtp://localhost:587, imap://localhost:143
# Roundcube webmail    →  https://mail.world.local
# -----------------------------------------------------------------------------
# Mail domain for every persona address. Should match WORLD_DOMAIN so that
# identities.yaml can use one address per persona across git, chat, and mail.
MAIL_DOMAIN=world.local
MAIL_HOSTNAME=mx.world.local

# [DERIVED] Overwritten from WORLD_ADMIN_EMAIL / WORLD_ADMIN_PASSWORD by
# bootstrap.sh. This is the mailbox the agent reads in Roundcube. Per-persona
# mailboxes are created later from data/identities.yaml.
MAIL_ADMIN_USER=worldadmin@world.local
MAIL_ADMIN_PASSWORD=worldadmin-dev-password

# Default password assigned to every persona mailbox that ingest_mail.py
# creates. Uniform on purpose: the ingestion script authenticates as each
# persona in turn to APPEND into their mailbox, and one shared password keeps
# identities.yaml free of per-user secrets.
MAIL_PERSONA_PASSWORD=change-me-persona-mailboxes


# -----------------------------------------------------------------------------
# Ports published on the host
# -----------------------------------------------------------------------------
# Traefik owns HTTP/HTTPS; :80 only redirects to :443. Mail ports bypass Traefik
# entirely (it proxies HTTP only) because ingest_mail.py speaks raw IMAP.
HTTP_PORT=80
HTTPS_PORT=443
TRAEFIK_DASHBOARD_PORT=8080
SMTP_PORT=25
SUBMISSION_PORT=587
IMAP_PORT=143
IMAPS_PORT=993
