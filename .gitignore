# Real secrets, if a local .env is ever used by the ingestion scripts
.env

# Python
scripts/__pycache__/
__pycache__/
*.pyc
.venv/

# Written by ingest_docs.py, consumed by ingest_comments.py. Points at page ids
# in whichever database was last ingested, so it never belongs in the repo.
.docs-manifest.json

# Local scratch
*.log

# Inputs and artifacts for data_gen/, none of which belong in the repository.
# curator/ is a working clone of the real upstream repository — an input, read
# only, never a source. build/ and cache/ are regenerated by the data_gen stages.
curator/
data_gen/build/
data_gen/cache/

# The rewritten history: a ~78MB pack, plus a manifest that maps real git
# signatures and commit SHAs onto the synthetic ones. Both are generated, and
# the manifest is the one place outside data_gen/ that still holds real names.
#   python3 scripts/ingest_history.py --export
data/history/
