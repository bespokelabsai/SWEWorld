# Real secrets, if a local .env is ever used by the ingestion scripts
.env

# Python
scripts/__pycache__/
__pycache__/
*.pyc
.venv/

# Written by ingest_docs.py, consumed by ingest_comments.py. Points at page ids
# in whichever database was last ingested, so it never belongs in the repo.
.docs-manifest.json

# Local scratch
*.log

# Inputs and artifacts for data_gen/, none of which belong in the repository.
# curator/ is a working clone of the real upstream repository — an input, read
# only, never a source. build/ and cache/ are regenerated by the data_gen stages.
curator/
data_gen/build/
data_gen/cache/

# Harbor and Horizon run output. `jobs/` alone is 330MB of trial transcripts,
# and both are regenerated by re-running the trial. `.horizon/metadata.json` is
# deliberately NOT here: it is the binding to the task on the server, and losing
# it makes the next push create a SECOND task rather than a new version.
jobs/
harbor_tasks/**/.cache/
harbor_tasks/**/.validation/
harbor_tasks/**/.rollouts/

# task_generator/out/ IS tracked -- it holds the plant, the brief and the
# fixtures, none of which can be regenerated for free. Only the bulk inside it
# is ignored: six copies of the vendored curator tarball (16.5MB, re-copied by
# `cli.py horizon` from vendor/) and the authoring logs. The `.horizon/`
# bindings under the same directories are NOT ignored -- losing one makes the
# next push create a second task instead of a new version.
task_generator/out/*/logs/
task_generator/out/**/curator-src.tar.gz

# The rewritten history: a ~78MB pack, plus a manifest that maps real git
# signatures and commit SHAs onto the synthetic ones. Both are generated, and
# the manifest is the one place outside data_gen/ that still holds real names.
#   python3 scripts/ingest_history.py --export
data/history/
