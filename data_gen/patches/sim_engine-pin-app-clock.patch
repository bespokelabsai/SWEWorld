+def _pin_app_clock(agent, when):
+    """Stamp what a tool writes with the turn that wrote it, not a parallel counter.
+
+    An app's clock is the CLIENT's object -- it reaches the library only through
+    `attach_tools` -- so the engine cannot stamp app writes itself. What it can
+    do is say when "now" is, which is the one thing the store was guessing.
+
+    Before this, a store advanced its own cursor seven minutes per call from the
+    day's start while the engine computed turn times in this loop and handed
+    them to nobody. In a 121-day corpus that put all 108 wiki pages between
+    09:14 and 10:38 on thirteen distinct clock values, none of them related to
+    the conversation that produced the page -- so a channel opening at 09:00
+    with "the design doc is up on the wiki" was announcing a file stamped 09:14,
+    and 96 chat messages ended up contradicting a page's own timestamp.
+
+    Best-effort on purpose: an app clock with no `set_now` keeps its own
+    behaviour, so a client that has not adopted this is not broken by it.
+    """
+    get = getattr(agent, "_extra_app_clock", None)
+    if get is None:
+        return
+    setter = getattr(get(), "set_now", None)
+    if setter is not None:
+        setter(when)
+
