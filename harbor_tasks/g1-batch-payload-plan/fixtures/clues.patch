--- /dev/null
+++ b/src/bespokelabs/curator/request_processor/batch_payload_planner.py
@@ -0,0 +1,249 @@
+"""Pure planning helpers for splitting a dataset into batch payloads.
+
+The planner is deliberately free of I/O and of any request processor state: it
+takes the measured payload size of every request, in dataset order, and returns
+the contiguous spans that each fit inside a provider's batch limits. Callers are
+responsible for measuring the requests and for writing the resulting plan to
+disk.
+"""
+
+import dataclasses
+import hashlib
+import json
+from dataclasses import dataclass
+from typing import Sequence
+
+PLAN_FILE_NAME = "batch_plan.json"
+PLAN_FORMAT_VERSION = 1
+
+_PLAN_ID_LENGTH = 12
+
+
+@dataclass(frozen=True)
+class BatchLimits:
+    """Provider limits a planned batch has to respect.
+
+    Attributes:
+        max_requests_per_batch: Maximum number of requests allowed in one batch.
+        max_bytes_per_batch: Maximum size in bytes of the payload file of one batch.
+        max_batches_per_plan: Maximum number of batches a single plan may contain.
+    """
+
+    max_requests_per_batch: int
+    max_bytes_per_batch: int
+    max_batches_per_plan: int = 512
+
+
+@dataclass(frozen=True)
+class PlannedBatch:
+    """A single contiguous span of dataset rows that will be submitted as one batch.
+
+    Attributes:
+        index: Position of the batch in the plan, also used to name its files.
+        start_idx: Index of the first dataset row in the batch.
+        end_idx: Index just past the last dataset row in the batch.
+        num_requests: Number of requests in the batch.
+        num_bytes: Size in bytes of the payload file the batch produces.
+    """
+
+    index: int
+    start_idx: int
+    end_idx: int
+    num_requests: int
+    num_bytes: int
+
+
+class BatchPayloadTooLargeError(ValueError):
+    """Raised when a batch payload is larger than the provider allows.
+
+    Attributes:
+        num_requests: Number of requests in the offending payload.
+        size_bytes: Size in bytes of the offending payload.
+        limit_bytes: Maximum size in bytes the provider supports.
+    """
+
+    def __init__(self, *, num_requests: int, size_bytes: int, limit_bytes: int) -> None:
+        """Initialize the error.
+
+        Args:
+            num_requests: Number of requests in the offending payload.
+            size_bytes: Size in bytes of the offending payload.
+            limit_bytes: Maximum size in bytes the provider supports.
+        """
+        self.num_requests = num_requests
+        self.size_bytes = size_bytes
+        self.limit_bytes = limit_bytes
+        super().__init__(self._describe())
+
+    def _describe(self) -> str:
+        return (
+            f"Batch payload of {self.num_requests:,} requests is {self.size_bytes:,} bytes, "
+            f"which is more than the maximum of {self.limit_bytes:,} bytes per batch. "
+            "Please reduce your batch size or request content size (via prompt_func and response_format)."
+        )
+
+
+class SingleRequestTooLargeError(BatchPayloadTooLargeError):
+    """Raised when one request on its own is larger than a whole batch may be.
+
+    No split can make such a row submittable, so planning fails instead of
+    emitting an empty batch.
+
+    Attributes:
+        row_idx: Index of the offending dataset row.
+        num_requests: Always ``1``.
+        size_bytes: Size in bytes of the offending request.
+        limit_bytes: Maximum size in bytes the provider supports.
+    """
+
+    def __init__(self, *, row_idx: int, size_bytes: int, limit_bytes: int) -> None:
+        """Initialize the error.
+
+        Args:
+            row_idx: Index of the offending dataset row.
+            size_bytes: Size in bytes of the offending request.
+            limit_bytes: Maximum size in bytes the provider supports.
+        """
+        self.row_idx = row_idx
+        super().__init__(num_requests=1, size_bytes=size_bytes, limit_bytes=limit_bytes)
+
+    def _describe(self) -> str:
+        return (
+            f"Request at row {self.row_idx:,} is {self.size_bytes:,} bytes on its own, "
+            f"which is more than the maximum of {self.limit_bytes:,} bytes per batch. "
+            "No batch size can make it submittable, please reduce the request content size (via prompt_func and response_format)."
+        )
+
+
+class BatchPlanTooFragmentedError(ValueError):
+    """Raised when a plan needs more batches than a single run may submit.
+
+    Attributes:
+        num_batches: Number of batches the plan wanted.
+        limit: Maximum number of batches a plan may contain.
+    """
+
+    def __init__(self, *, num_batches: int, limit: int) -> None:
+        """Initialize the error.
+
+        Args:
+            num_batches: Number of batches the plan wanted.
+            limit: Maximum number of batches a plan may contain.
+        """
+        super().__init__(
+            f"Batch plan contains {num_batches:,} batches, which is more than the maximum of {limit:,} batches per plan. "
+            "Please reduce the number of requests or their content size."
+        )
+        self.num_batches = num_batches
+        self.limit = limit
+
+
+def payload_size_bytes(api_specific_request: dict) -> int:
+    """Measure the payload size of a single API-specific request.
+
+    Args:
+        api_specific_request: API-specific request dictionary.
+
+    Returns:
+        int: Size in bytes of the request as it is written into a batch file.
+    """
+    return len(json.dumps(api_specific_request).encode())
+
+
+def payload_bytes(sizes: Sequence[int]) -> int:
+    """Compute the exact size of the batch file the given payloads produce.
+
+    Batch files join the requests with newlines, so a batch of ``n`` requests
+    carries ``n - 1`` separators on top of the request sizes themselves.
+
+    Args:
+        sizes: Payload sizes in bytes, one per request.
+
+    Returns:
+        int: Size in bytes of the joined batch file, ``0`` for no requests.
+    """
+    if not sizes:
+        return 0
+    return sum(sizes) + len(sizes) - 1
+
+
+def plan_batches(sizes: Sequence[int], limits: BatchLimits) -> list[PlannedBatch]:
+    """Split measured requests into contiguous batches that respect the limits.
+
+    Walks the sizes once, in index order, greedily filling each batch until
+    adding the next request would exceed either limit. The resulting spans are
+    ordered, contiguous and cover every request exactly once.
+
+    Args:
+        sizes: Payload sizes in bytes, one per request, in dataset order.
+        limits: Provider limits the planned batches have to respect.
+
+    Returns:
+        list[PlannedBatch]: The planned batches, empty if there are no requests.
+
+    Raises:
+        SingleRequestTooLargeError: If one request is larger than a whole batch may be.
+        BatchPlanTooFragmentedError: If the plan needs more batches than allowed.
+    """
+    plan: list[PlannedBatch] = []
+    start_idx = 0
+    batch_bytes = 0
+
+    for idx, size in enumerate(sizes):
+        if size > limits.max_bytes_per_batch:
+            raise SingleRequestTooLargeError(row_idx=idx, size_bytes=size, limit_bytes=limits.max_bytes_per_batch)
+
+        num_requests = idx - start_idx
+        # Every request but the first in a batch also carries its newline separator.
+        candidate_bytes = batch_bytes + size + (1 if num_requests else 0)
+        if num_requests and (num_requests + 1 > limits.max_requests_per_batch or candidate_bytes > limits.max_bytes_per_batch):
+            plan.append(PlannedBatch(index=len(plan), start_idx=start_idx, end_idx=idx, num_requests=num_requests, num_bytes=batch_bytes))
+            start_idx = idx
+            batch_bytes = size
+        else:
+            batch_bytes = candidate_bytes
+
+    if start_idx < len(sizes):
+        plan.append(PlannedBatch(index=len(plan), start_idx=start_idx, end_idx=len(sizes), num_requests=len(sizes) - start_idx, num_bytes=batch_bytes))
+
+    if len(plan) > limits.max_batches_per_plan:
+        raise BatchPlanTooFragmentedError(num_batches=len(plan), limit=limits.max_batches_per_plan)
+
+    return plan
+
+
+def plan_fingerprint(plan: Sequence[PlannedBatch]) -> str:
+    """Compute a short, stable identifier for a plan.
+
+    Only the spans and their payload sizes are hashed, so a plan keeps its
+    identity regardless of how the batches happen to be numbered or counted.
+
+    Args:
+        plan: The planned batches, in index order.
+
+    Returns:
+        str: The first twelve hex characters of the digest of the plan.
+    """
+    canonical = ";".join(f"{batch.start_idx}-{batch.end_idx}:{batch.num_bytes}" for batch in plan)
+    return hashlib.sha256(canonical.encode("utf-8")).hexdigest()[:_PLAN_ID_LENGTH]
+
+
+def plan_document(plan: Sequence[PlannedBatch], limits: BatchLimits) -> dict:
+    """Build the serializable description of a plan written to `PLAN_FILE_NAME`.
+
+    Args:
+        plan: The planned batches, in index order.
+        limits: Provider limits the plan was built against.
+
+    Returns:
+        dict: The plan document, ready to be dumped as JSON.
+    """
+    return {
+        "plan_format_version": PLAN_FORMAT_VERSION,
+        "plan_id": plan_fingerprint(plan),
+        "limits": dataclasses.asdict(limits),
+        "num_batches": len(plan),
+        "num_requests": sum(batch.num_requests for batch in plan),
+        "num_bytes": sum(batch.num_bytes for batch in plan),
+        "batches": [dataclasses.asdict(batch) for batch in plan],
+    }
