+    def _remove_planned_request_files(self) -> None:
+        """Remove the request and metadata files a previous plan left behind.
+
+        Only the files that planning itself writes are removed, so responses and
+        batch objects from earlier runs in the same working directory survive.
+
+        Side Effects:
+            - Deletes requests_*.jsonl and metadata_*.json from the working directory
+        """
+        stale_files = glob.glob(os.path.join(self.working_dir, "requests_*.jsonl")) + glob.glob(os.path.join(self.working_dir, "metadata_*.json"))
+        for stale_file in stale_files:
+            os.remove(stale_file)
+        if stale_files:
+            logger.debug(f"Removed {len(stale_files)} request file(s) from a previous plan in {self.working_dir}")
+
