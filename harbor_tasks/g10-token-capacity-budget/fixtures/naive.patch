diff --git a/src/bespokelabs/curator/status_tracker/capacity_budget.py b/src/bespokelabs/curator/status_tracker/capacity_budget.py
new file mode 100644
index 0000000..f8b83bd
--- /dev/null
+++ b/src/bespokelabs/curator/status_tracker/capacity_budget.py
@@ -0,0 +1,156 @@
+"""Capacity budget primitives shared by the online request path.
+
+This module owns two things:
+
+- decoding the rate limit headers returned by the providers into a
+  :class:`RateLimitReading`, and
+- the constants used as per-minute limits when a provider tells us nothing.
+
+The per-minute buckets themselves live on
+:class:`~bespokelabs.curator.status_tracker.online_status_tracker.OnlineStatusTracker`.
+"""
+
+import math
+import re
+import typing as t
+from dataclasses import dataclass
+from enum import Enum
+
+from bespokelabs.curator.types.token_usage import _TokenUsage
+
+# Per-minute limits used when nobody (config, headers) told us a limit.
+DEFAULT_MAX_REQUESTS_PER_MINUTE = 200
+DEFAULT_MAX_TOKENS_PER_MINUTE_COMBINED = 100_000
+DEFAULT_MAX_INPUT_TOKENS_PER_MINUTE = 100_000
+DEFAULT_MAX_OUTPUT_TOKENS_PER_MINUTE = 40_000
+
+# Where an effective limit came from.
+LIMIT_ORIGIN_CONFIGURED = "configured"
+LIMIT_ORIGIN_DEFAULTED = "defaulted"
+LIMIT_ORIGIN_UNLIMITED = "unlimited"
+
+# Header names we consult, in the order they are consulted.
+REQUEST_LIMIT_HEADERS = ("x-ratelimit-limit-requests", "anthropic-ratelimit-requests-limit")
+INPUT_TOKEN_LIMIT_HEADERS = ("x-ratelimit-limit-input-tokens", "anthropic-ratelimit-input-tokens-limit")
+OUTPUT_TOKEN_LIMIT_HEADERS = ("x-ratelimit-limit-output-tokens", "anthropic-ratelimit-output-tokens-limit")
+TOTAL_TOKEN_LIMIT_HEADERS = ("x-ratelimit-limit-tokens", "anthropic-ratelimit-tokens-limit")
+
+_LIMIT_VALUE_PATTERN = re.compile(r"^(\d+(?:\.\d+)?)([kKmM]?)$")
+_LIMIT_VALUE_MULTIPLIERS = {"": 1, "k": 1_000, "K": 1_000, "m": 1_000_000, "M": 1_000_000}
+
+
+class TokenLimitStrategy(str, Enum):
+    """Token limit Strategy enum."""
+
+    combined = "combined"
+    seperate = "seperate"
+    default = "combined"
+
+
+class CapacityExceedsLimitError(ValueError):
+    """Raised when a request can never fit within a per-minute limit.
+
+    Attributes:
+        axis: The capacity axis that is too small ("total", "input" or "output").
+        requested: The amount of capacity the request needs.
+        limit: The per-minute limit for that axis.
+    """
+
+    def __init__(self, axis: str, requested: int, limit: float):
+        """Initialize the CapacityExceedsLimitError."""
+        super().__init__(f"request needs {requested} {axis} capacity but the per-minute limit is {int(limit)}")
+        self.axis = axis
+        self.requested = requested
+        self.limit = limit
+
+
+@dataclass(frozen=True)
+class RateLimitReading:
+    """Rate limits decoded from a provider's response headers.
+
+    Attributes:
+        max_requests_per_minute: Requests per minute, or None when no header was usable.
+        max_tokens_per_minute: Tokens per minute, or None when no header was usable.
+        token_limit_strategy: The strategy implied by the headers that were present.
+        source_headers: The exact header names the reading was built from.
+    """
+
+    max_requests_per_minute: int | None
+    max_tokens_per_minute: int | _TokenUsage | None
+    token_limit_strategy: TokenLimitStrategy
+    source_headers: tuple[str, ...]
+
+
+def parse_limit_value(raw: object) -> int | None:
+    """Decode a single rate limit header value.
+
+    Accepts plain integers and strings such as "40000", "1.5k" or "2M". A malformed
+    value is treated as an absent one, never as an error.
+
+    Args:
+        raw: The raw header value.
+
+    Returns:
+        A positive int, or None when the value is missing, non-positive or malformed.
+    """
+    if isinstance(raw, bool):
+        return None
+    if isinstance(raw, int):
+        return raw if raw > 0 else None
+    if not isinstance(raw, str):
+        return None
+
+    match = _LIMIT_VALUE_PATTERN.match(raw.strip())
+    if match is None:
+        return None
+
+    value = math.floor(float(match.group(1)) * _LIMIT_VALUE_MULTIPLIERS[match.group(2)])
+    return value if value > 0 else None
+
+
+def _first_usable(headers: t.Mapping[str, object], names: t.Sequence[str]) -> tuple[str | None, int | None]:
+    """Return the first header name in `names` that is present and parseable."""
+    for name in names:
+        value = parse_limit_value(headers.get(name))
+        if value is not None:
+            return name, value
+    return None, None
+
+
+def read_rate_limit_headers(headers: t.Mapping[str, object]) -> RateLimitReading:
+    """Decode provider rate limit headers.
+
+    Only the documented `*-limit-*` headers are consulted; remaining/reset headers are
+    ignored, and no numeric fallback is substituted here. Separate input and output
+    limits win over a total token limit when both are present.
+
+    Args:
+        headers: Response headers, matched case-insensitively.
+
+    Returns:
+        The decoded RateLimitReading.
+    """
+    lowered = {str(name).lower(): value for name, value in headers.items()}
+
+    request_header, max_requests_per_minute = _first_usable(lowered, REQUEST_LIMIT_HEADERS)
+    input_header, input_tokens = _first_usable(lowered, INPUT_TOKEN_LIMIT_HEADERS)
+    output_header, output_tokens = _first_usable(lowered, OUTPUT_TOKEN_LIMIT_HEADERS)
+
+    source_headers = [] if request_header is None else [request_header]
+
+    if input_tokens is not None and output_tokens is not None:
+        token_limit_strategy = TokenLimitStrategy.seperate
+        max_tokens_per_minute = _TokenUsage(input=input_tokens, output=output_tokens)
+        source_headers.extend([input_header, output_header])
+    else:
+        token_limit_strategy = TokenLimitStrategy.combined
+        total_header, max_tokens_per_minute = _first_usable(lowered, TOTAL_TOKEN_LIMIT_HEADERS)
+        if total_header is not None:
+            source_headers.append(total_header)
+
+    return RateLimitReading(
+        max_requests_per_minute=max_requests_per_minute,
+        max_tokens_per_minute=max_tokens_per_minute,
+        token_limit_strategy=token_limit_strategy,
+        source_headers=tuple(source_headers),
+    )
