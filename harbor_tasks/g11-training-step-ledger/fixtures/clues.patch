index 0000000..6448474
--- /dev/null
+++ b/src/bespokelabs/curator/finetune/step_ledger.py
@@ -0,0 +1,417 @@
+"""Step ledger for fine-tuning: one definition of a training step.
+
+A "step" in this module always means an *optimizer* step, never a batch. A
+:class:`StepPlan` is cut once, up front, from the dataset and the training
+config, and every downstream number -- the learning rate schedule, the logging
+cadence, the checkpoint cadence and the resume position -- is derived from it,
+so that a run, its checkpoints and a later resume all agree on the same shape.
+
+This module is a leaf: it imports no clock, no calendar and no global RNG, and
+the trainer types it talks about are only imported for type checking, so that
+``TrainingResult.step_plan`` can be typed without an import cycle.
+"""
+
+import json
+import math
+from dataclasses import dataclass
+from typing import TYPE_CHECKING, Any, Dict, Mapping, Sequence, Tuple
+
+import xxhash
+
+if TYPE_CHECKING:
+    from bespokelabs.curator.finetune.config import TinkerTrainerConfig
+    from bespokelabs.curator.finetune.types import CheckpointInfo
+
+# The unit a plan counts its steps in.
+STEP_UNIT_OPTIMIZER = "optimizer_step"
+STEP_UNIT_PACKED = "packed_epoch_step"
+
+# Version tag on a dataset fingerprint, so an older signature never compares
+# equal to one produced by a different payload encoding.
+DATASET_SIGNATURE_PREFIX = "ds1"
+
+# Checkpoint names order with the run: same prefix, zero-padded step, so a
+# plain directory listing comes back in the order the run wrote them.
+CHECKPOINT_NAME_TEMPLATE = "{prefix}-s{step:06d}"
+
+# The complete set of reasons a checkpoint may be written for, in the order a
+# record lists them.
+CHECKPOINT_REASONS = ("interval", "epoch", "final")
+
+# Default floor of the decay, as a fraction of the base learning rate.
+MIN_LR_RATIO = 0.1
+
+
+class StepLedgerError(ValueError):
+    """Raised when a plan, a reason label or a resume request is not coherent."""
+
+
+class ResumePlanMismatch(StepLedgerError):  # noqa: N818 - named for what it reports, not for the suffix
+    """Raised when a checkpoint was taken in a different shape than the current plan.
+
+    Attributes:
+        checkpoint_name: Name of the checkpoint that was refused
+        mismatched_fields: Names of the fields that disagree, sorted alphabetically
+        expected: The values the current plan requires, keyed by field name
+        found: The values the checkpoint carries, keyed by field name
+    """
+
+    def __init__(
+        self,
+        checkpoint_name: str,
+        mismatched_fields: Sequence[str],
+        expected: Mapping[str, Any],
+        found: Mapping[str, Any],
+    ):
+        """Initialize the mismatch with the fields that disagree and their values."""
+        self.checkpoint_name = checkpoint_name
+        self.mismatched_fields: Tuple[str, ...] = tuple(mismatched_fields)
+        self.expected: Dict[str, Any] = dict(expected)
+        self.found: Dict[str, Any] = dict(found)
+        super().__init__(
+            f"Cannot resume from checkpoint {checkpoint_name!r}: "
+            f"{', '.join(self.mismatched_fields)} does not match this run "
+            f"(expected {self.expected}, found {self.found})"
+        )
+
+
+@dataclass(frozen=True)
+class StepPlan:
+    """The shape of a training run, in optimizer steps.
+
+    Attributes:
+        step_unit: What one step counts, either STEP_UNIT_OPTIMIZER or STEP_UNIT_PACKED
+        num_examples: Number of examples in the dataset the plan was cut from
+        batch_size: Examples per batch
+        epochs: Number of passes over the dataset
+        gradient_accumulation_steps: Batches accumulated into one optimizer step
+        batches_per_epoch: Batches in one pass over the dataset
+        total_batches: Batches in the whole run
+        total_steps: Optimizer steps in the whole run
+        trailing_window_batches: Batches in the run's final accumulation window
+        dataset_signature: Fingerprint of the data the plan was cut from
+    """
+
+    step_unit: str
+    num_examples: int
+    batch_size: int
+    epochs: int
+    gradient_accumulation_steps: int
+    batches_per_epoch: int
+    total_batches: int
+    total_steps: int
+    trailing_window_batches: int
+    dataset_signature: str
+
+    def step_of_batch(self, batch_ordinal: int) -> int:
+        """Return the optimizer step the given 1-based batch ordinal belongs to."""
+        return math.ceil(batch_ordinal / self.gradient_accumulation_steps)
+
+    def is_step_boundary(self, batch_ordinal: int) -> bool:
+        """Whether the given 1-based batch ordinal closes an accumulation window.
+
+        The last batch of the run always closes one: a short trailing window is
+        still a whole optimizer step.
+        """
+        return batch_ordinal % self.gradient_accumulation_steps == 0 or batch_ordinal == self.total_batches
+
+    def epoch_of_batch(self, batch_ordinal: int) -> int:
+        """Return the 1-based epoch the given 1-based batch ordinal falls in."""
+        return math.ceil(batch_ordinal / self.batches_per_epoch)
+
+    def batch_slice(self, batch_ordinal: int) -> Tuple[int, int]:
+        """Return the ``(start, end)`` slice into the example list for a batch ordinal."""
+        start = ((batch_ordinal - 1) % self.batches_per_epoch) * self.batch_size
+        return start, min(start + self.batch_size, self.num_examples)
+
+    def logging_steps(self, log_every_n_steps: int) -> Tuple[int, ...]:
+        """Return the ascending steps whose ordinal is divisible by ``log_every_n_steps``."""
+        if log_every_n_steps < 1:
+            raise StepLedgerError(f"log_every_n_steps must be >= 1, got {log_every_n_steps}")
+        return tuple(step for step in range(1, self.total_steps + 1) if step % log_every_n_steps == 0)
+
+    def epoch_closing_steps(self) -> Tuple[int, ...]:
+        """Return the ascending steps that close the window containing an epoch's last batch."""
+        steps = {self.step_of_batch(epoch * self.batches_per_epoch) for epoch in range(1, self.epochs + 1)}
+        return tuple(sorted(steps))
+
+    def loss_history_steps(self, log_every_n_steps: int) -> Tuple[int, ...]:
+        """Return the ascending steps that contribute one entry to ``loss_history``.
+
+        That is the union of the logging steps and, for every epoch, the step
+        that closes the window containing that epoch's last batch.
+        """
+        return tuple(sorted(set(self.logging_steps(log_every_n_steps)) | set(self.epoch_closing_steps())))
+
+
+@dataclass(frozen=True)
+class ResumePlan:
+    """Where a run picks up from, once a checkpoint has been accepted.
+
+    Attributes:
+        checkpoint_name: Name of the checkpoint being resumed from
+        start_batch_ordinal: Number of batches already done, i.e. the 0-based
+            offset of the next batch to run
+        start_epoch: 1-based epoch the next batch falls in
+        start_batch_in_epoch: 0-based offset of the next batch within that epoch
+        completed_steps: Optimizer steps already taken
+        remaining_batches: Batches still to run
+    """
+
+    checkpoint_name: str
+    start_batch_ordinal: int
+    start_epoch: int
+    start_batch_in_epoch: int
+    completed_steps: int
+    remaining_batches: int
+
+
+def dataset_signature(examples: Sequence[Mapping[str, Any]]) -> str:
+    """Fingerprint a dataset by the content of every example, in order.
+
+    Reordering the examples or editing a single character changes the
+    signature; the order of keys within an example does not.
+
+    Args:
+        examples: The examples the plan is cut from
+
+    Returns:
+        A signature of the form ``ds1-<count>-<digest>``
+    """
+    payload = json.dumps(list(examples), sort_keys=True, separators=(",", ":"), default=str, ensure_ascii=True).encode("utf-8")
+    return f"{DATASET_SIGNATURE_PREFIX}-{len(examples)}-{xxhash.xxh64(payload).hexdigest()}"
+
+
+def plan_steps(
+    num_examples: int,
+    *,
+    batch_size: int,
+    epochs: int,
+    gradient_accumulation_steps: int = 1,
+    dataset_signature: str = "",
+) -> StepPlan:
+    """Cut a step plan for a batched training loop.
+
+    The accumulation window is counted over the whole run and is not reset at an
+    epoch boundary, so a window may span one. A short final window still counts
+    as one whole optimizer step.
+
+    Args:
+        num_examples: Number of examples in the dataset
+        batch_size: Examples per batch
+        epochs: Number of passes over the dataset
+        gradient_accumulation_steps: Batches accumulated into one optimizer step
+        dataset_signature: Fingerprint of the data the plan is cut from
+
+    Returns:
+        The StepPlan for the run
+
+    Raises:
+        StepLedgerError: If the dataset is empty or any of the sizes is below 1
+    """
+    if num_examples < 1:
+        raise StepLedgerError("Cannot plan a training run over an empty dataset")
+    if batch_size < 1:
+        raise StepLedgerError(f"batch_size must be >= 1, got {batch_size}")
+    if epochs < 1:
+        raise StepLedgerError(f"epochs must be >= 1, got {epochs}")
+    if gradient_accumulation_steps < 1:
+        raise StepLedgerError(f"gradient_accumulation_steps must be >= 1, got {gradient_accumulation_steps}")
+
+    batches_per_epoch = math.ceil(num_examples / batch_size)
+    total_batches = batches_per_epoch * epochs
+    total_steps = math.ceil(total_batches / gradient_accumulation_steps)
+
+    return StepPlan(
+        step_unit=STEP_UNIT_OPTIMIZER,
+        num_examples=num_examples,
+        batch_size=batch_size,
+        epochs=epochs,
+        gradient_accumulation_steps=gradient_accumulation_steps,
+        batches_per_epoch=batches_per_epoch,
+        total_batches=total_batches,
+        total_steps=total_steps,
+        trailing_window_batches=total_batches - (total_steps - 1) * gradient_accumulation_steps,
+        dataset_signature=dataset_signature,
+    )
+
+
+def plan_steps_for_config(config: "TinkerTrainerConfig", examples: Sequence[Mapping[str, Any]]) -> StepPlan:
+    """Cut a step plan from a trainer config and the examples it will run over.
+
+    Args:
+        config: The trainer config the run is configured by
+        examples: The examples the run will train on
+
+    Returns:
+        The StepPlan for the run
+    """
+    return plan_steps(
+        len(examples),
+        batch_size=config.batch_size,
+        epochs=config.epochs,
+        gradient_accumulation_steps=config.gradient_accumulation_steps,
+        dataset_signature=dataset_signature(examples),
+    )
+
+
+def plan_packed_steps(num_examples: int, *, epochs: int, dataset_signature: str = "") -> StepPlan:
+    """Cut a step plan for a managed trainer that packs each epoch into one step.
+
+    Args:
+        num_examples: Number of examples in the dataset
+        epochs: Number of passes over the dataset, one packed step each
+        dataset_signature: Fingerprint of the data the plan is cut from
+
+    Returns:
+        The StepPlan for the run
+
+    Raises:
+        StepLedgerError: If the dataset is empty or ``epochs`` is below 1
+    """
+    if num_examples < 1:
+        raise StepLedgerError("Cannot plan a training run over an empty dataset")
+    if epochs < 1:
+        raise StepLedgerError(f"epochs must be >= 1, got {epochs}")
+
+    return StepPlan(
+        step_unit=STEP_UNIT_PACKED,
+        num_examples=num_examples,
+        batch_size=num_examples,
+        epochs=epochs,
+        gradient_accumulation_steps=1,
+        batches_per_epoch=1,
+        total_batches=epochs,
+        total_steps=epochs,
+        trailing_window_batches=1,
+        dataset_signature=dataset_signature,
+    )
+
+
+def learning_rate_at(
+    step: int,
+    total_steps: int,
+    base_lr: float,
+    warmup_steps: int,
+    *,
+    min_lr_ratio: float = MIN_LR_RATIO,
+) -> float:
+    """Return the learning rate for a 1-based optimizer step.
+
+    The schedule is an even ramp up to ``base_lr``, reached *on* the last warmup
+    step, followed by a straight linear decay that lands on
+    ``base_lr * min_lr_ratio`` at ``total_steps`` and holds there past the
+    planned end. ``warmup_steps`` is clipped to the length of the run rather
+    than rejected, so a short run still reaches ``base_lr``.
+
+    Args:
+        step: The 1-based optimizer step
+        total_steps: Total optimizer steps planned for the run
+        base_lr: The peak learning rate
+        warmup_steps: Optimizer steps spent ramping up to ``base_lr``
+        min_lr_ratio: Floor of the decay, as a fraction of ``base_lr``
+
+    Returns:
+        The learning rate for that step
+    """
+    effective_warmup = min(warmup_steps, total_steps)
+    if effective_warmup > 0 and step <= effective_warmup:
+        return base_lr * (step / effective_warmup)
+
+    decay_steps = total_steps - effective_warmup
+    if decay_steps <= 0:
+        return base_lr * min_lr_ratio
+
+    progress = min(max((step - effective_warmup) / decay_steps, 0.0), 1.0)
+    return base_lr * (min_lr_ratio + (1.0 - min_lr_ratio) * (1.0 - progress))
+
+
+def canonical_reasons(reasons: Sequence[str]) -> Tuple[str, ...]:
+    """Normalize checkpoint reason labels to the canonical set, order and multiplicity.
+
+    Args:
+        reasons: The labels to normalize; an empty sequence is allowed
+
+    Returns:
+        The distinct labels, in CHECKPOINT_REASONS order
+
+    Raises:
+        StepLedgerError: If any label is not in CHECKPOINT_REASONS
+    """
+    unknown = [reason for reason in reasons if reason not in CHECKPOINT_REASONS]
+    if unknown:
+        raise StepLedgerError(f"Unknown checkpoint reason(s) {unknown}; expected any of {list(CHECKPOINT_REASONS)}")
+    return tuple(reason for reason in CHECKPOINT_REASONS if reason in reasons)
+
+
+def checkpoint_name(prefix: str, step: int) -> str:
+    """Return the deterministic checkpoint name for a step.
+
+    Args:
+        prefix: The configured checkpoint name prefix
+        step: The optimizer step the checkpoint is taken at
+
+    Returns:
+        The checkpoint name, e.g. ``"checkpoint-s000002"``
+    """
+    return CHECKPOINT_NAME_TEMPLATE.format(prefix=prefix, step=step)
+
+
+def plan_resume(plan: StepPlan, checkpoint: "CheckpointInfo") -> ResumePlan:
+    """Work out where a run resumes from, refusing a reshaped run.
+
+    Validation runs in a fixed order: the shape the checkpoint was taken in,
+    then whether the plan still has batches left, then whether the checkpoint's
+    own step and batch count agree.
+
+    Args:
+        plan: The plan for the run about to start
+        checkpoint: The checkpoint that was loaded
+
+    Returns:
+        The ResumePlan the run picks up from
+
+    Raises:
+        ResumePlanMismatch: If the checkpoint was taken in a different shape,
+            the plan is already exhausted, or the checkpoint is inconsistent
+    """
+    shape = (
+        ("batch_size", plan.batch_size, checkpoint.batch_size),
+        ("dataset_signature", plan.dataset_signature, checkpoint.dataset_signature),
+        ("gradient_accumulation_steps", plan.gradient_accumulation_steps, checkpoint.gradient_accumulation_steps),
+    )
+    mismatched = [(name, expected, found) for name, expected, found in shape if expected != found]
+    if mismatched:
+        raise ResumePlanMismatch(
+            checkpoint_name=checkpoint.name,
+            mismatched_fields=sorted(name for name, _, _ in mismatched),
+            expected={name: expected for name, expected, _ in mismatched},
+            found={name: found for name, _, found in mismatched},
+        )
+
+    batches_completed = checkpoint.batches_completed
+    if batches_completed >= plan.total_batches:
+        raise ResumePlanMismatch(
+            checkpoint_name=checkpoint.name,
+            mismatched_fields=("epochs",),
+            expected={"epochs": plan.epochs, "total_batches": plan.total_batches},
+            found={"batches_completed": batches_completed},
+        )
+
+    expected_step = plan.step_of_batch(batches_completed)
+    if checkpoint.step != expected_step:
+        raise ResumePlanMismatch(
+            checkpoint_name=checkpoint.name,
+            mismatched_fields=("step",),
+            expected={"step": expected_step},
+            found={"step": checkpoint.step},
+        )
+
+    return ResumePlan(
+        checkpoint_name=checkpoint.name,
+        start_batch_ordinal=batches_completed,
+        start_epoch=batches_completed // plan.batches_per_epoch + 1,
+        start_batch_in_epoch=batches_completed % plan.batches_per_epoch,
+        completed_steps=checkpoint.step,
+        remaining_batches=plan.total_batches - batches_completed,
+    )
