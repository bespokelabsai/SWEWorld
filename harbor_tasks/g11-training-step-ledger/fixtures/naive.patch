index 0000000..bf4e704
--- /dev/null
+++ b/src/bespokelabs/curator/finetune/step_ledger.py
@@ -0,0 +1,382 @@
+"""Step ledger for fine-tuning: one step unit, one checkpoint identity, one resume contract.
+
+A training run is described by a single immutable :class:`StepPlan` built up-front from
+the dataset size and the training hyper-parameters. The plan is the only authority on
+
+* how many batches the run walks (``total_batches``),
+* how many *optimizer* steps those batches amount to (``total_steps``) -- the unit in
+  which ``warmup_steps``, ``log_every_n_steps`` and ``checkpoint_every_n_steps`` speak,
+* which batch belongs to which step and epoch, and
+* the identity of the dataset the plan was built for (``dataset_signature``).
+
+Resuming a run is validated against that plan by :func:`plan_resume`, which refuses --
+loudly, via :class:`ResumePlanMismatch` -- a checkpoint that was taken in a different
+shape than the run about to be started.
+
+This module is a leaf: it imports nothing from the rest of ``finetune`` at runtime (and
+no clock and no RNG), so any module of the package may import it.
+"""
+
+import json
+import math
+from dataclasses import dataclass
+from typing import TYPE_CHECKING, Any, List, Mapping, Sequence, Tuple
+
+from xxhash import xxh64
+
+if TYPE_CHECKING:
+    from bespokelabs.curator.finetune.config import TinkerTrainerConfig
+    from bespokelabs.curator.finetune.types import CheckpointInfo
+
+# The unit ``total_steps`` is counted in. Tinker drives its own batch loop, so a step is
+# an optimizer step; Fireworks packs a whole epoch server-side into a single step.
+STEP_UNIT_OPTIMIZER = "optimizer_step"
+STEP_UNIT_PACKED = "packed_epoch_step"
+
+# Version prefix of the dataset signature, so a future change of the digest payload is
+# distinguishable from a content change.
+DATASET_SIGNATURE_PREFIX = "ds1"
+
+
+class StepLedgerError(ValueError):
+    """Raised when a step plan cannot be built from the given parameters."""
+
+
+class ResumePlanMismatch(StepLedgerError):
+    """Raised when a checkpoint cannot be resumed into the plan of the current run.
+
+    Attributes:
+        checkpoint_name: Name of the checkpoint that was rejected.
+        mismatched_fields: Names of the fields that disagree, sorted alphabetically.
+        expected: The values the current plan requires, keyed by field name.
+        found: The values the checkpoint carries, keyed by field name.
+    """
+
+    def __init__(
+        self,
+        checkpoint_name: str,
+        mismatched_fields: Tuple[str, ...],
+        expected: dict,
+        found: dict,
+    ):
+        """Initialize the mismatch with the checkpoint identity and the offending fields."""
+        self.checkpoint_name = checkpoint_name
+        self.mismatched_fields = tuple(mismatched_fields)
+        self.expected = expected
+        self.found = found
+        fields = ", ".join(self.mismatched_fields)
+        super().__init__(f"Checkpoint {checkpoint_name!r} cannot be resumed: {fields} differ(s) (expected {expected}, found {found})")
+
+
+@dataclass(frozen=True)
+class StepPlan:
+    """An immutable description of every batch and optimizer step of a training run.
+
+    Attributes:
+        step_unit: What ``total_steps`` counts (:data:`STEP_UNIT_OPTIMIZER` or
+            :data:`STEP_UNIT_PACKED`).
+        num_examples: Number of examples in the dataset.
+        batch_size: Number of examples per batch.
+        epochs: Number of passes over the dataset.
+        gradient_accumulation_steps: Batches accumulated per optimizer step.
+        batches_per_epoch: Batches in one pass over the dataset.
+        total_batches: Batches over the whole run.
+        total_steps: Optimizer steps over the whole run.
+        trailing_window_batches: Batches in the final accumulation window, which may be
+            shorter than ``gradient_accumulation_steps`` but still counts as one step.
+        dataset_signature: Signature of the dataset the plan was built for.
+    """
+
+    step_unit: str
+    num_examples: int
+    batch_size: int
+    epochs: int
+    gradient_accumulation_steps: int
+    batches_per_epoch: int
+    total_batches: int
+    total_steps: int
+    trailing_window_batches: int
+    dataset_signature: str
+
+    def step_of_batch(self, batch_ordinal: int) -> int:
+        """Return the 1-based optimizer step the given 1-based batch belongs to."""
+        return math.ceil(batch_ordinal / self.gradient_accumulation_steps)
+
+    def is_step_boundary(self, batch_ordinal: int) -> bool:
+        """Whether the optimizer steps after this 1-based batch.
+
+        The last batch of the run always closes its window, even a short one.
+        """
+        return batch_ordinal % self.gradient_accumulation_steps == 0 or batch_ordinal == self.total_batches
+
+    def epoch_of_batch(self, batch_ordinal: int) -> int:
+        """Return the 1-based epoch the given 1-based batch belongs to."""
+        return (batch_ordinal - 1) // self.batches_per_epoch + 1
+
+    def batch_slice(self, batch_ordinal: int) -> Tuple[int, int]:
+        """Return the ``(start, end)`` example indices covered by the given 1-based batch."""
+        index_in_epoch = (batch_ordinal - 1) % self.batches_per_epoch
+        start = index_in_epoch * self.batch_size
+        return start, min(start + self.batch_size, self.num_examples)
+
+    def logging_steps(self, log_every_n_steps: int) -> List[int]:
+        """Return the ascending steps at which the run logs, i.e. those divisible by N."""
+        if log_every_n_steps < 1:
+            raise StepLedgerError(f"log_every_n_steps must be >= 1, got {log_every_n_steps}")
+        return [step for step in range(1, self.total_steps + 1) if step % log_every_n_steps == 0]
+
+    def loss_history_steps(self, log_every_n_steps: int) -> List[int]:
+        """Return the ascending steps that contribute an entry to ``loss_history``.
+
+        That is the logging steps plus, for every epoch, the step whose window contains
+        that epoch's last batch, so a run always reports a loss for each epoch.
+        """
+        steps = set(self.logging_steps(log_every_n_steps))
+        for epoch in range(1, self.epochs + 1):
+            last_batch_of_epoch = min(self.batches_per_epoch * epoch, self.total_batches)
+            steps.add(self.step_of_batch(last_batch_of_epoch))
+        return sorted(steps)
+
+
+@dataclass(frozen=True)
+class ResumePlan:
+    """Where a validated checkpoint puts the run inside a :class:`StepPlan`.
+
+    Attributes:
+        checkpoint_name: Name of the checkpoint being resumed from.
+        start_batch_ordinal: Number of batches to skip, i.e. the 0-based ordinal of the
+            first batch to run.
+        start_epoch: 1-based epoch the run continues in.
+        start_batch_in_epoch: 0-based batch index within ``start_epoch`` to continue at.
+        completed_steps: Optimizer steps already taken.
+        remaining_batches: Batches still to run.
+    """
+
+    checkpoint_name: str
+    start_batch_ordinal: int
+    start_epoch: int
+    start_batch_in_epoch: int
+    completed_steps: int
+    remaining_batches: int
+
+
+def dataset_signature(examples: Sequence[Mapping[str, Any]]) -> str:
+    """Compute a stable signature of a dataset's content.
+
+    The signature is a function of every example, in order: reordering the examples or
+    editing a single character changes it, while the key order within an example does not.
+
+    Args:
+        examples: The dataset rows, in training order.
+
+    Returns:
+        A signature of the form ``ds1-<count>-<digest>``.
+    """
+    payload = json.dumps(list(examples), sort_keys=True, separators=(",", ":"), default=str, ensure_ascii=True).encode("utf-8")
+    return f"{DATASET_SIGNATURE_PREFIX}-{len(examples)}-{xxh64(payload).hexdigest()}"
+
+
+def plan_steps(
+    num_examples: int,
+    *,
+    batch_size: int,
+    epochs: int,
+    gradient_accumulation_steps: int = 1,
+    dataset_signature: str = "",
+) -> StepPlan:
+    """Build the step plan of a run that walks batches itself.
+
+    The accumulation window is counted over the whole run and is *not* reset at an epoch
+    boundary, so a window may span one; the final window may be short but still counts as
+    one whole optimizer step.
+
+    Args:
+        num_examples: Number of examples in the dataset.
+        batch_size: Number of examples per batch.
+        epochs: Number of passes over the dataset.
+        gradient_accumulation_steps: Batches accumulated per optimizer step.
+        dataset_signature: Signature of the dataset, see :func:`dataset_signature`.
+
+    Returns:
+        The StepPlan for the run.
+
+    Raises:
+        StepLedgerError: If the dataset is empty or any of the sizes is below 1.
+    """
+    if num_examples == 0:
+        raise StepLedgerError("Cannot plan training steps for an empty dataset")
+    if num_examples < 0:
+        raise StepLedgerError(f"num_examples must be >= 0, got {num_examples}")
+    if batch_size < 1:
+        raise StepLedgerError(f"batch_size must be >= 1, got {batch_size}")
+    if epochs < 1:
+        raise StepLedgerError(f"epochs must be >= 1, got {epochs}")
+    if gradient_accumulation_steps < 1:
+        raise StepLedgerError(f"gradient_accumulation_steps must be >= 1, got {gradient_accumulation_steps}")
+
+    batches_per_epoch = math.ceil(num_examples / batch_size)
+    total_batches = batches_per_epoch * epochs
+    total_steps = math.ceil(total_batches / gradient_accumulation_steps)
+    trailing_window_batches = total_batches - (total_steps - 1) * gradient_accumulation_steps
+
+    return StepPlan(
+        step_unit=STEP_UNIT_OPTIMIZER,
+        num_examples=num_examples,
+        batch_size=batch_size,
+        epochs=epochs,
+        gradient_accumulation_steps=gradient_accumulation_steps,
+        batches_per_epoch=batches_per_epoch,
+        total_batches=total_batches,
+        total_steps=total_steps,
+        trailing_window_batches=trailing_window_batches,
+        dataset_signature=dataset_signature,
+    )
+
+
+def plan_steps_for_config(config: "TinkerTrainerConfig", examples: Sequence[Mapping[str, Any]]) -> StepPlan:
+    """Build the step plan of a :class:`~bespokelabs.curator.finetune.config.TinkerTrainerConfig` run.
+
+    Args:
+        config: The trainer configuration the run is driven by.
+        examples: The dataset rows, in training order.
+
+    Returns:
+        The StepPlan for the run, signed with the dataset's signature.
+    """
+    return plan_steps(
+        len(examples),
+        batch_size=config.batch_size,
+        epochs=config.epochs,
+        gradient_accumulation_steps=config.gradient_accumulation_steps,
+        dataset_signature=dataset_signature(examples),
+    )
+
+
+def plan_packed_steps(num_examples: int, *, epochs: int, dataset_signature: str = "") -> StepPlan:
+    """Build the step plan of a managed run that packs one optimizer step per epoch.
+
+    Args:
+        num_examples: Number of examples in the dataset.
+        epochs: Number of passes over the dataset, one packed step each.
+        dataset_signature: Signature of the dataset, see :func:`dataset_signature`.
+
+    Returns:
+        The StepPlan for the run, counted in :data:`STEP_UNIT_PACKED`.
+
+    Raises:
+        StepLedgerError: If the dataset is empty or ``epochs`` is below 1.
+    """
+    if num_examples == 0:
+        raise StepLedgerError("Cannot plan training steps for an empty dataset")
+    if num_examples < 0:
+        raise StepLedgerError(f"num_examples must be >= 0, got {num_examples}")
+    if epochs < 1:
+        raise StepLedgerError(f"epochs must be >= 1, got {epochs}")
+
+    return StepPlan(
+        step_unit=STEP_UNIT_PACKED,
+        num_examples=num_examples,
+        batch_size=num_examples,
+        epochs=epochs,
+        gradient_accumulation_steps=1,
+        batches_per_epoch=1,
+        total_batches=epochs,
+        total_steps=epochs,
+        trailing_window_batches=1,
+        dataset_signature=dataset_signature,
+    )
+
+
+def plan_resume(plan: StepPlan, checkpoint: "CheckpointInfo") -> ResumePlan:
+    """Place a checkpoint inside the plan of the run about to start.
+
+    The checkpoint is validated against the plan in a fixed order -- shape, then
+    exhaustion, then consistency -- and a run that was reshaped since the checkpoint was
+    taken is refused rather than silently restarted. Raising ``epochs`` alone is legal:
+    the plan grows and the schedule continues where the checkpoint left off.
+
+    Args:
+        plan: The plan of the run about to start.
+        checkpoint: The checkpoint to resume from.
+
+    Returns:
+        The ResumePlan describing where the run continues.
+
+    Raises:
+        ResumePlanMismatch: If the checkpoint was taken in a different shape, if the
+            plan holds no batch after it, or if its step disagrees with its batch count.
+    """
+    expected = {
+        "batch_size": plan.batch_size,
+        "dataset_signature": plan.dataset_signature,
+        "gradient_accumulation_steps": plan.gradient_accumulation_steps,
+    }
+    found = {
+        "batch_size": checkpoint.batch_size,
+        "dataset_signature": checkpoint.dataset_signature,
+        "gradient_accumulation_steps": checkpoint.gradient_accumulation_steps,
+    }
+    mismatched = tuple(sorted(name for name in expected if expected[name] != found[name]))
+    if mismatched:
+        raise ResumePlanMismatch(
+            checkpoint_name=checkpoint.name,
+            mismatched_fields=mismatched,
+            expected={name: expected[name] for name in mismatched},
+            found={name: found[name] for name in mismatched},
+        )
+
+    batches_completed = checkpoint.batches_completed
+    if batches_completed >= plan.total_batches:
+        raise ResumePlanMismatch(
+            checkpoint_name=checkpoint.name,
+            mismatched_fields=("epochs",),
+            expected={"epochs": plan.epochs, "total_batches": plan.total_batches},
+            found={"batches_completed": batches_completed},
+        )
+
+    expected_step = plan.step_of_batch(batches_completed)
+    if checkpoint.step != expected_step:
+        raise ResumePlanMismatch(
+            checkpoint_name=checkpoint.name,
+            mismatched_fields=("step",),
+            expected={"step": expected_step},
+            found={"step": checkpoint.step},
+        )
+
+    return ResumePlan(
+        checkpoint_name=checkpoint.name,
+        start_batch_ordinal=batches_completed,
+        start_epoch=batches_completed // plan.batches_per_epoch + 1,
+        start_batch_in_epoch=batches_completed % plan.batches_per_epoch,
+        completed_steps=checkpoint.step,
+        remaining_batches=plan.total_batches - batches_completed,
+    )
+
+
+def learning_rate_at(step: int, total_steps: int, base_lr: float, warmup_steps: int) -> float:
+    """Return the learning rate of an optimizer step: linear warmup, then cosine decay.
+
+    The schedule is stretched over the whole run: the peak is reached at the end of
+    warmup and the rate decays over the remaining steps, so the same step of a longer
+    run gets a higher rate. The last step of a run still trains at a non-zero rate.
+
+    Args:
+        step: The 1-based optimizer step.
+        total_steps: Optimizer steps in the whole run.
+        base_lr: Peak learning rate, reached at the end of warmup.
+        warmup_steps: Optimizer steps spent ramping up to ``base_lr``.
+
+    Returns:
+        The learning rate for that step.
+    """
+    if step <= 0:
+        return 0.0
+    if warmup_steps > 0 and step < warmup_steps:
+        return base_lr * (step / warmup_steps)
+
+    decay_steps = total_steps - warmup_steps
+    if decay_steps <= 0:
+        return base_lr
+
+    progress = min(max((step - 1 - warmup_steps) / decay_steps, 0.0), 1.0)
+    return base_lr * 0.5 * (1.0 + math.cos(math.pi * progress))
