+class BackendParamError(ValueError):
+    """Raised when a backend param is not a field of the config class for the requested mode.
+
+    Attributes:
+        params: The offending backend param names, sorted ascending.
+        expected: Name of the config class for the requested mode.
+        belongs_to: Names of the other config classes that accept all of `params`.
+    """
+
+    def __init__(self, params: tuple[str, ...], expected: str, belongs_to: tuple[str, ...]) -> None:
+        """Initialize the error from the offending params and the classes involved."""
+        self.params = params
+        self.expected = expected
+        self.belongs_to = belongs_to
+        accepted = " or ".join(belongs_to) if belongs_to else "no request processor config"
+        super().__init__(f"backend_params {', '.join(params)} not accepted by {expected}; accepted by {accepted}")
+
+
+class BackendModeError(ValueError):
+    """Raised when a backend cannot serve the requested mode.
+
+    Attributes:
+        backend: Name of the requested backend.
+        mode: The requested mode, one of "batch", "online" or "offline".
+        supported: The modes the backend does support, sorted ascending.
+    """
+
+    def __init__(self, backend: str, mode: str, supported: tuple[str, ...]) -> None:
+        """Initialize the error from the backend, the requested mode and the supported modes."""
+        self.backend = backend
+        self.mode = mode
+        self.supported = supported
+        super().__init__(f"backend {backend!r} does not support {mode} mode; supported modes: {', '.join(supported)}")
+
+
+_MODE_CONFIGS: dict[str, type[RequestProcessorConfig]] = {
+    "batch": BatchRequestProcessorConfig,
+    "online": OnlineRequestProcessorConfig,
+    "offline": OfflineRequestProcessorConfig,
+}
+
+_BACKEND_MODES: dict[str, frozenset[str]] = {
+    "openai": frozenset({"online", "batch"}),
+    "anthropic": frozenset({"online", "batch"}),
+    "klusterai": frozenset({"online", "batch"}),
+    "inference.net": frozenset({"online", "batch"}),
+    "gemini": frozenset({"batch"}),
+    "mistral": frozenset({"batch"}),
+    "azure": frozenset({"batch"}),
+    "litellm": frozenset({"online"}),
+    "vllm": frozenset({"offline"}),
+}
+
+
+def _resolve_mode(batch: bool, backend: str | None) -> str:
+    """Resolve the processing mode implied by a batch flag and a backend name."""
+    if backend == "vllm":
+        return "offline"
+    if batch:
+        return "batch"
+    return "online"
+
+
+# TODO: Redundant move to misc module.
+def _remove_none_values(d: dict) -> dict:
+    """Remove all None values from a dictionary."""
+    return {k: v for k, v in d.items() if v is not None}
+
+
+def _validate_backend_params(
+    params: BackendParamsType,
+    batch: bool = False,
+    backend: str | None = None,
+) -> RequestProcessorConfig:
+    """Validate backend params against the config class of the requested mode.
+
+    Params with a value of None are treated as absent and dropped before validation, so the
+    corresponding fields keep their declared defaults. `params` itself is never mutated.
+
+    Args:
+        params: The backend params to validate.
+        batch: Whether batch mode was requested.
+        backend: The resolved backend name, if any.
+
+    Returns:
+        An instance of the config class for the resolved mode.
+
+    Raises:
+        BackendParamError: If a param is not a field of that config class.
+        pydantic.ValidationError: If a param of that config class has an invalid value.
+    """
+    config_cls = _MODE_CONFIGS[_resolve_mode(batch, backend)]
+    values = _remove_none_values(params)
+
+    unknown = tuple(sorted(key for key in values if key not in config_cls.model_fields))
+    if unknown:
+        belongs_to = tuple(
+            other.__name__
+            for other in (BatchRequestProcessorConfig, OnlineRequestProcessorConfig, OfflineRequestProcessorConfig)
+            if other is not config_cls and all(key in other.model_fields for key in unknown)
+        )
+        raise BackendParamError(unknown, config_cls.__name__, belongs_to)
+
+    return config_cls(**values)
