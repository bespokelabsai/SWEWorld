+class BackendModeError(ValueError):
+    """Raised when a backend cannot serve the requested mode."""
+
+    def __init__(self, backend: str, mode: str, supported: tuple[str, ...]) -> None:
+        """Initialize with the backend, the requested mode and the modes it does support."""
+        self.backend = backend
+        self.mode = mode
+        self.supported = supported
+        super().__init__(f"backend {backend!r} does not support {mode} mode; supported modes: {', '.join(supported)}")
+
+
+class BackendParamError(ValueError):
+    """Raised when backend params are not accepted by the config of the requested mode."""
+
+    def __init__(self, params: tuple[str, ...], expected: str, belongs_to: tuple[str, ...]) -> None:
+        """Initialize with the offending params, the config they were validated against and the ones accepting them."""
+        self.params = params
+        self.expected = expected
+        self.belongs_to = belongs_to
+        accepted_by = " or ".join(belongs_to) if belongs_to else "no request processor config"
+        super().__init__(f"backend_params {', '.join(params)} not accepted by {expected}; accepted by {accepted_by}")
+
+
+def _resolve_mode(batch: bool, backend: str | None) -> str:
+    """Resolve the request processor mode from the batch flag and the backend."""
+    if backend == "vllm":
+        return "offline"
+    if batch:
+        return "batch"
+    return "online"
+
+
+# TODO: Redundant move to misc module.
+def _remove_none_values(d: dict) -> dict:
+    """Remove all None values from a dictionary."""
+    return {k: v for k, v in d.items() if v is not None}
+
+
+def _validate_backend_params(params: BackendParamsType, batch: bool = False, backend: str | None = None) -> RequestProcessorConfig:
+    """Validate backend params against the config class of the resolved mode.
+
+    Args:
+        params: Backend params supplied by the user.
+        batch: Whether batch mode was requested.
+        backend: Optional backend name, which can itself imply a mode (e.g. "vllm").
+
+    Returns:
+        An instance of the config class of the resolved mode.
+
+    Raises:
+        BackendParamError: If a param is not a field of that config class.
+        ValidationError: If a param is a field of that config class but its value is invalid.
+    """
+    config_cls = _MODE_CONFIGS[_resolve_mode(batch, backend)]
+    offending = tuple(sorted(key for key in params if key not in config_cls.model_fields))
+    if offending:
+        belongs_to = tuple(
+            other.__name__
+            for other in (BatchRequestProcessorConfig, OnlineRequestProcessorConfig, OfflineRequestProcessorConfig)
+            if other is not config_cls and all(key in other.model_fields for key in offending)
+        )
+        raise BackendParamError(offending, config_cls.__name__, belongs_to)
+    return config_cls(**_remove_none_values(params))
