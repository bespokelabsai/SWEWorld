diff --git a/src/bespokelabs/curator/code_executor/output_cap.py b/src/bespokelabs/curator/code_executor/output_cap.py
new file mode 100644
index 0000000..28fb8a7
--- /dev/null
+++ b/src/bespokelabs/curator/code_executor/output_cap.py
@@ -0,0 +1,66 @@
+"""Byte budget for sandbox stdout/stderr streams.
+
+A runaway program can write megabytes to stdout, which would otherwise be
+carried verbatim through :class:`CodeExecutionOutput` into the response file.
+The helpers here shorten each stream to a per-stream byte budget and report
+which streams were shortened.
+"""
+
+from dataclasses import dataclass
+from typing import Optional
+
+DEFAULT_MAX_OUTPUT_BYTES: int = 65536
+
+
+@dataclass(frozen=True)
+class CappedStreams:
+    """Streams after applying the byte budget."""
+
+    stdout: Optional[str]
+    stderr: Optional[str]
+    truncated_streams: list[str]
+
+
+def cap_stream(stream: Optional[str], max_output_bytes: int = DEFAULT_MAX_OUTPUT_BYTES) -> tuple[Optional[str], bool]:
+    """Shorten a single stream to the byte budget.
+
+    Args:
+        stream: Stream contents, possibly None.
+        max_output_bytes: Maximum number of UTF-8 bytes to keep.
+
+    Returns:
+        A (stream, truncated) tuple. `truncated` is True only when bytes were dropped.
+    """
+    if not stream:
+        return stream, False
+
+    encoded = stream.encode("utf-8")
+    if len(encoded) <= max_output_bytes:
+        return stream, False
+
+    # A byte-wise cut can land inside a multi-byte character; drop the partial one.
+    return encoded[:max_output_bytes].decode("utf-8", errors="ignore"), True
+
+
+def cap_streams(stdout: Optional[str], stderr: Optional[str], max_output_bytes: int = DEFAULT_MAX_OUTPUT_BYTES) -> CappedStreams:
+    """Shorten stdout and stderr to the byte budget.
+
+    Args:
+        stdout: Standard output contents, possibly None.
+        stderr: Standard error contents, possibly None.
+        max_output_bytes: Maximum number of UTF-8 bytes to keep per stream.
+
+    Returns:
+        The capped streams alongside the alphabetically sorted names of the
+        streams that were shortened.
+    """
+    capped_stdout, stdout_truncated = cap_stream(stdout, max_output_bytes)
+    capped_stderr, stderr_truncated = cap_stream(stderr, max_output_bytes)
+
+    truncated_streams = []
+    if stderr_truncated:
+        truncated_streams.append("stderr")
+    if stdout_truncated:
+        truncated_streams.append("stdout")
+
+    return CappedStreams(stdout=capped_stdout, stderr=capped_stderr, truncated_streams=truncated_streams)
