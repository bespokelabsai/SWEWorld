@@ -0,0 +1,294 @@
+"""Failure-class retry policy for online request processors.
+
+Every failure raised while processing an online request is sorted into one of a
+small number of failure classes, and the class decides how (and whether) the
+request is retried. Keeping that decision here, instead of spread across the
+per-backend processors, means a failure is classified and counted exactly once.
+
+This module is deliberately pure: it only depends on the standard library, and
+it never reads a clock or draws randomness itself. Both are injected into
+:class:`RetryPolicy`, which makes the backoff schedule exactly reproducible in
+tests.
+"""
+
+import enum
+import typing as t
+from dataclasses import dataclass
+
+if t.TYPE_CHECKING:
+    from bespokelabs.curator.status_tracker.online_status_tracker import OnlineStatusTracker
+
+# Seconds to stay quiet after a rate limit error, when the caller doesn't say.
+_DEFAULT_COOLDOWN_SECONDS = 10.0
+
+
+class FailureClass(str, enum.Enum):
+    """The kind of failure a request hit, which determines how it is retried.
+
+    Attributes:
+        THROTTLE: The provider is refusing traffic for now; back off hard.
+        TRANSIENT: A blip (timeout, connection, 5xx); back off gently.
+        CONTRACT: The request or the response violates a contract; retrying it
+            unchanged is cheap but unlikely to help.
+        TERMINAL: Retrying cannot possibly help (auth, missing model).
+    """
+
+    THROTTLE = "throttle"
+    TRANSIENT = "transient"
+    CONTRACT = "contract"
+    TERMINAL = "terminal"
+
+
+# HTTP statuses whose meaning is unambiguous. Anything else in 5xx is transient.
+_STATUS_CLASSES: dict[int, FailureClass] = {
+    400: FailureClass.CONTRACT,
+    413: FailureClass.CONTRACT,
+    422: FailureClass.CONTRACT,
+    401: FailureClass.TERMINAL,
+    403: FailureClass.TERMINAL,
+    404: FailureClass.TERMINAL,
+    408: FailureClass.TRANSIENT,
+    409: FailureClass.TRANSIENT,
+    425: FailureClass.TRANSIENT,
+    429: FailureClass.THROTTLE,
+    529: FailureClass.THROTTLE,
+}
+
+# Exception type names, matched anywhere along the raised type's MRO.
+_TYPE_CLASSES: dict[str, FailureClass] = {
+    "TimeoutError": FailureClass.TRANSIENT,
+    "ConnectionError": FailureClass.TRANSIENT,
+    "ClientConnectorError": FailureClass.TRANSIENT,
+    "ValueError": FailureClass.CONTRACT,
+    "ValidationError": FailureClass.CONTRACT,
+    "JSONDecodeError": FailureClass.CONTRACT,
+    "KeyError": FailureClass.CONTRACT,
+    "PermissionError": FailureClass.TERMINAL,
+    "NotImplementedError": FailureClass.TERMINAL,
+}
+
+# Last resort: providers that wrap everything in a bare Exception still tend to
+# say what went wrong in the message. Scanned in order.
+_MESSAGE_MARKERS: tuple[tuple[str, FailureClass], ...] = (
+    ("rate limit", FailureClass.THROTTLE),
+    ("ratelimit", FailureClass.THROTTLE),
+    ("too many requests", FailureClass.THROTTLE),
+    ("overloaded", FailureClass.THROTTLE),
+    ("quota", FailureClass.THROTTLE),
+    ("timed out", FailureClass.TRANSIENT),
+    ("timeout", FailureClass.TRANSIENT),
+    ("connection reset", FailureClass.TRANSIENT),
+    ("temporarily unavailable", FailureClass.TRANSIENT),
+    ("response is empty", FailureClass.TRANSIENT),
+    ("invalid api key", FailureClass.TERMINAL),
+    ("authentication", FailureClass.TERMINAL),
+    ("permission denied", FailureClass.TERMINAL),
+)
+
+# Per class: (base delay, growth factor, cap) in seconds.
+_SCHEDULE: dict[FailureClass, tuple[float, float, float]] = {
+    FailureClass.THROTTLE: (8.0, 2.0, 60.0),
+    FailureClass.TRANSIENT: (0.5, 3.0, 20.0),
+    FailureClass.CONTRACT: (0.0, 1.0, 0.0),
+    FailureClass.TERMINAL: (0.0, 1.0, 0.0),
+}
+
+
+def _status_of(exc: BaseException) -> t.Any:
+    """Read the HTTP status off an exception, however the provider spells it."""
+    try:
+        status = getattr(exc, "status_code", None)
+        if status is None:
+            status = getattr(exc, "status", None)
+    except Exception:
+        return None
+    return status
+
+
+def classify_failure(exc: BaseException) -> FailureClass:
+    """Sort an exception into a failure class.
+
+    Four signals are consulted in order, and the first one that yields a class
+    wins: the HTTP status, the exception type (matched along its MRO), markers
+    in the exception message, and finally the transient default. Classification
+    is best effort and never raises.
+
+    Args:
+        exc: The exception raised while processing a request
+
+    Returns:
+        The failure class the exception belongs to
+    """
+    status = _status_of(exc)
+    if isinstance(status, int):
+        if status in _STATUS_CLASSES:
+            return _STATUS_CLASSES[status]
+        if 500 <= status <= 599:
+            return FailureClass.TRANSIENT
+
+    for klass in type(exc).__mro__:
+        failure_class = _TYPE_CLASSES.get(klass.__name__)
+        if failure_class is not None:
+            return failure_class
+
+    try:
+        message = str(exc).lower()
+    except Exception:
+        message = ""
+    for marker, failure_class in _MESSAGE_MARKERS:
+        if marker in message:
+            return failure_class
+
+    return FailureClass.TRANSIENT
+
+
+@dataclass(frozen=True)
+class RetryVerdict:
+    """What the policy decided about a single failed attempt.
+
+    Attributes:
+        should_retry: Whether the request should be put back on the retry queue
+        failure_class: The class the failure was sorted into
+        attempt_index: 1-based index of the attempt that just failed
+        delay_seconds: How long to wait before the retry, 0.0 if there is none
+        reason_code: Two-part code, ``"<failure class>:<outcome>"``
+    """
+
+    should_retry: bool
+    failure_class: FailureClass
+    attempt_index: int
+    delay_seconds: float
+    reason_code: str
+
+
+class RetryPolicy:
+    """Decides whether, and how long after, a failed request is retried.
+
+    Args:
+        clock: Returns the current time in seconds, used to stamp rate limits
+        jitter: Returns a jitter factor in ``[0.0, 1.0]``, drawn once per delay
+    """
+
+    def __init__(self, clock: t.Callable[[], float], jitter: t.Callable[[], float]):
+        """Initialize the RetryPolicy."""
+        self._clock = clock
+        self._jitter = jitter
+
+    def delay_for(self, failure_class: FailureClass, attempt_index: int) -> float:
+        """Compute the backoff delay after the given attempt failed.
+
+        The exponential term is capped before jitter is applied, so the cap is
+        a real ceiling. Jitter spreads the delay over the top half of the
+        interval, and is only drawn when there is a delay to spread.
+
+        Args:
+            failure_class: The class of the failure being retried
+            attempt_index: 1-based index of the attempt that just failed
+
+        Returns:
+            Seconds to wait before the next attempt
+
+        Raises:
+            ValueError: If attempt_index is not at least 1
+        """
+        if attempt_index < 1:
+            raise ValueError(f"attempt_index must be at least 1, got {attempt_index}")
+
+        base, factor, cap = _SCHEDULE[failure_class]
+        raw = min(cap, base * factor ** (attempt_index - 1))
+        if raw <= 0:
+            return 0.0
+
+        j = min(1.0, max(0.0, self._jitter()))
+        return round(raw * (0.5 + 0.5 * j), 3)
+
+    def decide(self, exc: BaseException, *, attempts_made: int, attempts_left: int) -> RetryVerdict:
+        """Decide what to do with a request whose attempt just failed.
+
+        Args:
+            exc: The exception the attempt raised
+            attempts_made: Number of attempts that had already failed before this one
+            attempts_left: Remaining retry budget for the request
+
+        Returns:
+            The verdict for this failure
+        """
+        failure_class = classify_failure(exc)
+        attempt_index = attempts_made + 1
+
+        if failure_class is FailureClass.TERMINAL:
+            should_retry, outcome, delay = False, "abort", 0.0
+        elif attempts_left <= 0:
+            should_retry, outcome, delay = False, "exhausted", 0.0
+        else:
+            should_retry, outcome = True, "retry"
+            delay = self.delay_for(failure_class, attempt_index)
+
+        return RetryVerdict(
+            should_retry=should_retry,
+            failure_class=failure_class,
+            attempt_index=attempt_index,
+            delay_seconds=delay,
+            reason_code=f"{failure_class.value}:{outcome}",
+        )
+
+    def record_failure(self, tracker: "OnlineStatusTracker", verdict: RetryVerdict) -> None:
+        """Record a failure on the status tracker, incrementing exactly one counter.
+
+        Args:
+            tracker: Tracker to record the failure on
+            verdict: The verdict for the failure being recorded
+        """
+        if verdict.failure_class is FailureClass.THROTTLE:
+            tracker.num_rate_limit_errors += 1
+            tracker.time_of_last_rate_limit_error = self._clock()
+        elif verdict.failure_class is FailureClass.CONTRACT:
+            tracker.num_other_errors += 1
+        else:
+            tracker.num_api_errors += 1
+
+
+def remaining_cooldown_seconds(tracker: "OnlineStatusTracker", now: float, cooldown_seconds: float = _DEFAULT_COOLDOWN_SECONDS) -> float:
+    """Seconds a caller must still wait before issuing more requests.
+
+    Args:
+        tracker: Tracker holding the time of the last rate limit error
+        now: The current time, on the same clock as the tracker
+        cooldown_seconds: How long a rate limit error keeps traffic paused
+
+    Returns:
+        Seconds left to pause, 0.0 if the cooldown has already elapsed
+    """
+    remaining = cooldown_seconds - (now - tracker.time_of_last_rate_limit_error)
+    return remaining if remaining > 0 else 0.0
+
+
+def format_failure_summary(failure_log: t.Sequence[tuple[FailureClass, str]]) -> list[str]:
+    """Summarize a request's failures, most frequent first.
+
+    Args:
+        failure_log: The (failure class, message) pairs recorded for a request
+
+    Returns:
+        One human readable entry per distinct pair, ordered by count descending
+        with ties broken by first occurrence
+    """
+    counts: dict[tuple[FailureClass, str], int] = {}
+    for entry in failure_log:
+        counts[entry] = counts.get(entry, 0) + 1
+
+    ordered = sorted(counts.items(), key=lambda item: -item[1])
+    return [f"[{failure_class.value}] {message} (x{count})" for (failure_class, message), count in ordered]
+
+
+def format_attempt_label(attempts_made: int, max_retries: int) -> str:
+    """Label the attempt that follows the ones already made.
+
+    Args:
+        attempts_made: Number of attempts that have already failed
+        max_retries: Configured number of retries, on top of the first attempt
+
+    Returns:
+        A label such as ``"attempt #2 of 11"``
+    """
+    return f"attempt #{attempts_made + 1} of {max_retries + 1}"
