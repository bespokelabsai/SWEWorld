diff --git a/src/bespokelabs/curator/run_identity.py b/src/bespokelabs/curator/run_identity.py
new file mode 100644
index 0000000..5358ff8
--- /dev/null
+++ b/src/bespokelabs/curator/run_identity.py
@@ -0,0 +1,471 @@
+"""Versioned run identity for the Curator cache.
+
+A run identity is the explicit, versioned description of everything that makes a
+run distinct: the model, the prompt and parse functions, the dataset and the
+handful of backend parameters that genuinely fork the outputs. The identity is
+hashed into a ``run_hash``, which is the name of the run's cache directory, and
+is written next to the cached artifacts as ``run_identity.json`` so a later run
+can prove that the directory it found belongs to it.
+"""
+
+import json
+import os
+from dataclasses import dataclass
+from io import BytesIO
+from typing import Any, Dict, Optional, Tuple
+
+from xxhash import xxh64
+
+from bespokelabs.curator.log import logger
+
+RUN_IDENTITY_VERSION: int = 3
+RUN_IDENTITY_FILENAME: str = "run_identity.json"
+
+#: The component keys of a run identity, in the order they are written. This is
+#: the single source of truth: everything that builds or compares components
+#: reads it from here.
+IDENTITY_COMPONENT_KEYS: Tuple[str, ...] = (
+    "backend",
+    "backend_params",
+    "batch_mode",
+    "dataset_hash",
+    "generation_params",
+    "model_name",
+    "parse_func_hash",
+    "prompt_func_hash",
+    "response_format",
+    "return_completions_object",
+    "run_id",
+    "system_prompt",
+)
+
+#: The backend params that fork the cache directory. Everything else a backend
+#: takes (retries, timeouts, credentials, ...) is a knob, not an identity.
+IDENTITY_BACKEND_PARAM_KEYS: frozenset[str] = frozenset(
+    {
+        "azure_deployment",
+        "base_url",
+        "batch_size",
+        "completion_window",
+    }
+)
+
+_RUN_HASH_PREFIX = f"v{RUN_IDENTITY_VERSION}-"
+_NOCACHE_RUN_HASH_PREFIX = f"v{RUN_IDENTITY_VERSION}-nocache-"
+
+
+class RunIdentityError(RuntimeError):
+    """Base class for every run identity failure."""
+
+
+class RunIdentityMismatch(RunIdentityError):  # noqa: N818
+    """Raised when a run cache directory belongs to a different run.
+
+    Attributes:
+        path: Path of the run identity stamp that disagrees.
+        expected_run_hash: Run hash of the identity we computed for this run.
+        found_run_hash: Run hash recorded in the stamp on disk.
+        mismatched_components: Component keys that differ, alphabetically sorted.
+    """
+
+    def __init__(self, path: str, expected_run_hash: str, found_run_hash: str, mismatched_components: Tuple[str, ...]):
+        """Initialize the mismatch.
+
+        Args:
+            path: Path of the run identity stamp that disagrees.
+            expected_run_hash: Run hash of the identity we computed for this run.
+            found_run_hash: Run hash recorded in the stamp on disk.
+            mismatched_components: Component keys that differ, alphabetically sorted.
+        """
+        self.path = path
+        self.expected_run_hash = expected_run_hash
+        self.found_run_hash = found_run_hash
+        self.mismatched_components = mismatched_components
+        super().__init__(
+            f"Run identity mismatch at {path}: expected run hash {expected_run_hash}, found {found_run_hash}. "
+            f"Mismatched components: {', '.join(mismatched_components) if mismatched_components else 'none'}."
+        )
+
+
+class CachedResponseMismatch(RunIdentityError):  # noqa: N818
+    """Raised when a cached response does not describe the dataset it is loaded with.
+
+    Attributes:
+        cache_dir: Directory the cached response was loaded from.
+        field: Name of the dataset field that differs.
+        expected: Value of the field for the dataset we were handed.
+        found: Value of the field recorded in the cached response.
+    """
+
+    def __init__(self, cache_dir: str, field: str, expected: Any, found: Any):
+        """Initialize the mismatch.
+
+        Args:
+            cache_dir: Directory the cached response was loaded from.
+            field: Name of the dataset field that differs.
+            expected: Value of the field for the dataset we were handed.
+            found: Value of the field recorded in the cached response.
+        """
+        self.cache_dir = cache_dir
+        self.field = field
+        self.expected = expected
+        self.found = found
+        super().__init__(f"Cached response in {cache_dir} does not match the dataset: {field} is {found!r}, expected {expected!r}.")
+
+
+@dataclass(frozen=True)
+class RunIdentity:
+    """The identity of a single run.
+
+    Attributes:
+        run_hash: Name of the run's cache directory.
+        digest: Hash of the identity components.
+        identity_version: Version of the identity scheme that produced the digest.
+        cache_enabled: Whether the run is cached.
+        components: The identity components, keyed by IDENTITY_COMPONENT_KEYS.
+    """
+
+    run_hash: str
+    digest: str
+    identity_version: int
+    cache_enabled: bool
+    components: Dict[str, Any]
+
+
+@dataclass(frozen=True)
+class RunStamp:
+    """The run identity as it is recorded in a run cache directory.
+
+    Attributes:
+        identity_version: Version of the identity scheme that produced the digest.
+        run_hash: Name of the run's cache directory.
+        digest: Hash of the identity components.
+        components: The identity components, keyed by IDENTITY_COMPONENT_KEYS.
+        created_at: When the directory was first stamped.
+        updated_at: When the directory was last used.
+    """
+
+    identity_version: int
+    run_hash: str
+    digest: str
+    components: Dict[str, Any]
+    created_at: str
+    updated_at: str
+
+    def to_dict(self) -> Dict[str, Any]:
+        """Convert the stamp to its on-disk dictionary form.
+
+        Returns:
+            Dict[str, Any]: The stamp fields, ready to be serialised.
+        """
+        return {
+            "identity_version": self.identity_version,
+            "run_hash": self.run_hash,
+            "digest": self.digest,
+            "components": self.components,
+            "created_at": self.created_at,
+            "updated_at": self.updated_at,
+        }
+
+    @classmethod
+    def from_dict(cls, data: Dict[str, Any]) -> "RunStamp":
+        """Create a stamp from its on-disk dictionary form.
+
+        Args:
+            data: Dictionary containing every stamp field.
+
+        Returns:
+            RunStamp: The stamp described by the dictionary.
+
+        Raises:
+            KeyError: If a stamp field is missing.
+        """
+        return cls(
+            identity_version=data["identity_version"],
+            run_hash=data["run_hash"],
+            digest=data["digest"],
+            components=data["components"],
+            created_at=data["created_at"],
+            updated_at=data["updated_at"],
+        )
+
+
+@dataclass(frozen=True)
+class RunDirectoryCheck:
+    """The outcome of reconciling a run cache directory with a run identity.
+
+    Attributes:
+        status: One of "created", "adopted", "upgraded" or "matched".
+        stamp: The stamp now recorded in the directory.
+        previous_version: Identity version found in the directory, if any.
+    """
+
+    status: str
+    stamp: RunStamp
+    previous_version: Optional[int]
+
+
+def _get_function_hash(func) -> str:
+    # setting recursion limit to avoid random recursion limit error
+    # todo: understand why this is happening and fix it
+    import sys
+
+    sys.setrecursionlimit(10000)
+
+    """Get a hash of a function's source code."""
+    if func is None:
+        return xxh64("").hexdigest()
+
+    # Remove parameter annotations to avoid dill complaining about pickling
+    # pydantic BaseModel: https://github.com/bespokelabsai/curator/issues/229.
+    # For class/instance methods, get the underlying function
+    if hasattr(func, "__func__"):
+        func = func.__func__
+
+    # Clear annotations if they exist
+    if hasattr(func, "__annotations__"):
+        func.__annotations__ = {}
+
+    file = BytesIO()
+
+    from datasets.utils._dill import Pickler
+
+    try:
+        Pickler(file, recurse=True).dump(func)
+    except TypeError:
+        logger.debug("Failed to recursive pickle function, trying non-recursive")
+        Pickler(file, recurse=False).dump(func)
+
+    return xxh64(file.getvalue()).hexdigest()
+
+
+def _canonicalize(components: Dict[str, Any]) -> str:
+    """Serialise identity components canonically for hashing.
+
+    Args:
+        components: The identity components.
+
+    Returns:
+        str: A key-sorted, version-tagged, whitespace-free JSON string.
+    """
+    return json.dumps(
+        {"identity_version": RUN_IDENTITY_VERSION, "components": components},
+        sort_keys=True,
+        separators=(",", ":"),
+        default=str,
+    )
+
+
+def _identity_backend_params(backend_params: Optional[Dict[str, Any]]) -> Dict[str, Any]:
+    """Keep only the backend params that fork the cache directory.
+
+    Args:
+        backend_params: The backend params the LLM was constructed with.
+
+    Returns:
+        Dict[str, Any]: The subset of params that are part of the run identity.
+            Params that were never set stay absent.
+    """
+    return {key: value for key, value in dict(backend_params or {}).items() if key in IDENTITY_BACKEND_PARAM_KEYS}
+
+
+def _response_format_component(response_format) -> str:
+    """Describe a response format for the identity.
+
+    Args:
+        response_format: A Pydantic model, or None when the run is unstructured.
+
+    Returns:
+        str: The JSON schema of the response format, canonically serialised,
+            or "text" when there is no response format at all.
+    """
+    if response_format is None:
+        return "text"
+    return json.dumps(response_format.model_json_schema(), sort_keys=True, separators=(",", ":"))
+
+
+def compute_run_identity(llm, dataset_hash: str, *, cache_enabled: bool = True, run_id: Optional[str] = None) -> RunIdentity:
+    """Compute the run identity of an LLM run.
+
+    Args:
+        llm: The LLM the run belongs to. Only its public surface is used, so any
+            object exposing the same attributes works.
+        dataset_hash: Hash of the input dataset, used exactly as it is handed in.
+        cache_enabled: Whether the run is cached. A cached run is identified by
+            its inputs alone; an uncached one is identified by run_id as well.
+        run_id: Label identifying an uncached run. Required when the cache is
+            disabled, and refused otherwise.
+
+    Returns:
+        RunIdentity: The identity of the run.
+
+    Raises:
+        RunIdentityError: If run_id is given for a cached run, or missing for an
+            uncached one.
+    """
+    if cache_enabled:
+        if run_id is not None:
+            raise RunIdentityError(
+                f"run_id={run_id!r} was given for a cached run. A cached run is identified by its inputs, "
+                "so a run id would not be used. Set CURATOR_DISABLE_CACHE to run with a run id."
+            )
+    elif not run_id:
+        raise RunIdentityError("run_id is required when the cache is disabled, since there is no cacheable input to identify the run by.")
+
+    components = {
+        "backend": llm.backend,
+        "backend_params": _identity_backend_params(llm.backend_params),
+        "batch_mode": llm.batch_mode,
+        "dataset_hash": dataset_hash,
+        "generation_params": dict(llm.prompt_formatter.generation_params or {}),
+        "model_name": llm.prompt_formatter.model_name,
+        "parse_func_hash": _get_function_hash(llm.prompt_formatter.parse_func),
+        "prompt_func_hash": _get_function_hash(llm.prompt_formatter.prompt_func),
+        "response_format": _response_format_component(llm.prompt_formatter.response_format),
+        "return_completions_object": llm.return_completions_object,
+        "run_id": None if cache_enabled else run_id,
+        "system_prompt": llm.prompt_formatter.system_prompt,
+    }
+    components = {key: components[key] for key in IDENTITY_COMPONENT_KEYS}
+
+    serialized = _canonicalize(components)
+    digest = xxh64(serialized.encode("utf-8")).hexdigest()
+    run_hash = f"{_RUN_HASH_PREFIX}{digest}" if cache_enabled else f"{_NOCACHE_RUN_HASH_PREFIX}{digest}"
+
+    logger.debug(f"Curator run identity components: {serialized}")
+    logger.debug(f"Curator run hash: {run_hash}")
+
+    return RunIdentity(
+        run_hash=run_hash,
+        digest=digest,
+        identity_version=RUN_IDENTITY_VERSION,
+        cache_enabled=cache_enabled,
+        components=components,
+    )
+
+
+def _stamp_path(run_cache_dir) -> str:
+    """Get the path of the run identity stamp of a run cache directory."""
+    return os.path.join(str(run_cache_dir), RUN_IDENTITY_FILENAME)
+
+
+def write_run_stamp(run_cache_dir, identity: RunIdentity, *, now: str, created_at: Optional[str] = None) -> RunStamp:
+    """Write the run identity stamp of a run cache directory.
+
+    Args:
+        run_cache_dir: The run cache directory, which is created if missing.
+        identity: The identity to record.
+        now: Timestamp to record as the last use of the directory.
+        created_at: Timestamp the directory was first stamped, when it is
+            already known. Defaults to now.
+
+    Returns:
+        RunStamp: The stamp that was written.
+    """
+    stamp = RunStamp(
+        identity_version=identity.identity_version,
+        run_hash=identity.run_hash,
+        digest=identity.digest,
+        components=identity.components,
+        created_at=created_at if created_at is not None else now,
+        updated_at=now,
+    )
+
+    os.makedirs(str(run_cache_dir), exist_ok=True)
+    with open(_stamp_path(run_cache_dir), "w") as f:
+        f.write(json.dumps(stamp.to_dict(), indent=2, sort_keys=True) + "\n")
+
+    return stamp
+
+
+def read_run_stamp(run_cache_dir) -> Optional[RunStamp]:
+    """Read the run identity stamp of a run cache directory.
+
+    Args:
+        run_cache_dir: The run cache directory to read from.
+
+    Returns:
+        Optional[RunStamp]: The recorded stamp, or None if the directory has no
+            stamp or the stamp cannot be read.
+    """
+    path = _stamp_path(run_cache_dir)
+    if not os.path.exists(path):
+        return None
+
+    try:
+        with open(path, "r") as f:
+            data = json.load(f)
+        return RunStamp.from_dict(data)
+    except (OSError, ValueError, TypeError, KeyError) as e:
+        logger.warning(f"Failed to read run identity stamp {path}: {e}")
+        return None
+
+
+def _mismatched_components(expected: Dict[str, Any], found: Dict[str, Any]) -> Tuple[str, ...]:
+    """Get the component keys two identity component blocks disagree on.
+
+    Args:
+        expected: Components of the identity we computed for this run.
+        found: Components recorded in the stamp on disk.
+
+    Returns:
+        Tuple[str, ...]: The differing keys, alphabetically sorted.
+    """
+    keys = set(expected) | set(found) | set(IDENTITY_COMPONENT_KEYS)
+    return tuple(sorted(key for key in keys if expected.get(key) != found.get(key)))
+
+
+def reconcile_run_directory(run_cache_dir, identity: RunIdentity, *, now: str) -> RunDirectoryCheck:
+    """Reconcile a run cache directory with the identity of the run about to use it.
+
+    A missing or empty directory is created and stamped, a directory left behind
+    by an older Curator is adopted or upgraded in place, and a directory that
+    already belongs to this run has its stamp refreshed. Nothing is ever deleted:
+    a directory belonging to another run is reported instead.
+
+    Args:
+        run_cache_dir: The run cache directory.
+        identity: The identity of the run about to use the directory.
+        now: Timestamp to record as the last use of the directory.
+
+    Returns:
+        RunDirectoryCheck: What was done and the stamp now on disk.
+
+    Raises:
+        RunIdentityMismatch: If the directory is stamped for a different run, or
+            by a newer version of the identity scheme.
+    """
+    run_cache_dir = str(run_cache_dir)
+
+    if not os.path.isdir(run_cache_dir) or not os.listdir(run_cache_dir):
+        stamp = write_run_stamp(run_cache_dir, identity, now=now)
+        return RunDirectoryCheck(status="created", stamp=stamp, previous_version=None)
+
+    found = read_run_stamp(run_cache_dir)
+    if found is None:
+        logger.debug(f"Adopting unstamped run cache directory {run_cache_dir} for run hash {identity.run_hash}")
+        stamp = write_run_stamp(run_cache_dir, identity, now=now)
+        return RunDirectoryCheck(status="adopted", stamp=stamp, previous_version=None)
+
+    if found.identity_version > RUN_IDENTITY_VERSION:
+        raise RunIdentityMismatch(
+            path=_stamp_path(run_cache_dir),
+            expected_run_hash=identity.run_hash,
+            found_run_hash=found.run_hash,
+            mismatched_components=("identity_version",),
+        )
+
+    if found.identity_version < RUN_IDENTITY_VERSION:
+        stamp = write_run_stamp(run_cache_dir, identity, now=now, created_at=found.created_at)
+        return RunDirectoryCheck(status="upgraded", stamp=stamp, previous_version=found.identity_version)
+
+    if found.run_hash != identity.run_hash or found.digest != identity.digest or found.components != identity.components:
+        raise RunIdentityMismatch(
+            path=_stamp_path(run_cache_dir),
+            expected_run_hash=identity.run_hash,
+            found_run_hash=found.run_hash,
+            mismatched_components=_mismatched_components(identity.components, found.components),
+        )
+
+    stamp = write_run_stamp(run_cache_dir, identity, now=now, created_at=found.created_at)
+    return RunDirectoryCheck(status="matched", stamp=stamp, previous_version=found.identity_version)
