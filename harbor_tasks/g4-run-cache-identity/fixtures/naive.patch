diff --git a/src/bespokelabs/curator/run_identity.py b/src/bespokelabs/curator/run_identity.py
new file mode 100644
index 0000000..dd37c19
--- /dev/null
+++ b/src/bespokelabs/curator/run_identity.py
@@ -0,0 +1,395 @@
+"""Versioned run identity for the curator cache.
+
+A run identity is the explicit description of everything that makes a curator
+run unique: the dataset it is applied to, the code and the model behind it, and
+the backend it is sent to. The identity is hashed into a ``run_hash`` which
+names the run's cache directory, and it is written next to the cached artifacts
+as a stamp file so that a later run can tell whether it is looking at its own
+cache or at somebody else's.
+
+This module lives at the top level (rather than under ``llm/``) so that
+``db.py`` can import it without creating an import cycle.
+"""
+
+import json
+import os
+from dataclasses import dataclass
+from io import BytesIO
+from pathlib import Path
+from typing import Any, Dict, Optional, Tuple, Union
+
+from xxhash import xxh64
+
+from bespokelabs.curator.log import logger
+
+RUN_IDENTITY_VERSION: int = 3
+RUN_IDENTITY_FILENAME: str = "run_identity.json"
+
+_STAMP_FIELDS = ("identity_version", "run_hash", "digest", "components", "created_at", "updated_at")
+
+
+class RunIdentityError(RuntimeError):
+    """Base class for errors about the identity of a cached run."""
+
+
+class RunIdentityMismatch(RunIdentityError):  # noqa: N818
+    """Raised when a cache directory is stamped with a different run identity.
+
+    Attributes:
+        path: The cache directory whose stamp disagrees with the current run.
+        expected_run_hash: The run hash of the run that is being started.
+        found_run_hash: The run hash recorded in the stamp file.
+        mismatched_components: The identity components that differ.
+    """
+
+    def __init__(self, path: Union[str, Path], expected_run_hash: str, found_run_hash: str, mismatched_components: Tuple[str, ...]):
+        """Initialize the mismatch.
+
+        Args:
+            path: The cache directory whose stamp disagrees with the current run.
+            expected_run_hash: The run hash of the run that is being started.
+            found_run_hash: The run hash recorded in the stamp file.
+            mismatched_components: The identity components that differ.
+        """
+        self.path = path
+        self.expected_run_hash = expected_run_hash
+        self.found_run_hash = found_run_hash
+        self.mismatched_components = mismatched_components
+        super().__init__(
+            f"Cache directory {path} is stamped with run identity {found_run_hash}, but this run is {expected_run_hash} "
+            f"(differing: {', '.join(mismatched_components)}). Nothing was deleted; remove the directory yourself if it is stale."
+        )
+
+
+class CachedResponseMismatch(RunIdentityError):  # noqa: N818
+    """Raised when a cached response does not describe the dataset it is loaded with.
+
+    Attributes:
+        cache_dir: The cache directory the response was loaded from.
+        field: The name of the dataset field that differs.
+        expected: The value recorded in the cached response.
+        found: The value of the dataset that was handed in.
+    """
+
+    def __init__(self, cache_dir: Union[str, Path], field: str, expected: Any, found: Any):
+        """Initialize the mismatch.
+
+        Args:
+            cache_dir: The cache directory the response was loaded from.
+            field: The name of the dataset field that differs.
+            expected: The value recorded in the cached response.
+            found: The value of the dataset that was handed in.
+        """
+        self.cache_dir = cache_dir
+        self.field = field
+        self.expected = expected
+        self.found = found
+        super().__init__(f"Cached response in {cache_dir} was produced for a different dataset: {field} is {found!r}, cached response has {expected!r}.")
+
+
+@dataclass(frozen=True)
+class RunIdentity:
+    """The identity of a single curator run.
+
+    Attributes:
+        run_hash: The name of the run's cache directory.
+        digest: The hash of the identity components.
+        identity_version: The version of the identity scheme used.
+        cache_enabled: Whether the run is allowed to reuse a previous run's cache.
+        components: The components the digest was computed over.
+    """
+
+    run_hash: str
+    digest: str
+    identity_version: int
+    cache_enabled: bool
+    components: Dict[str, Any]
+
+
+@dataclass(frozen=True)
+class RunStamp:
+    """The contents of a run identity stamp file.
+
+    Attributes:
+        identity_version: The version of the identity scheme used.
+        run_hash: The run hash the directory was stamped with.
+        digest: The hash of the identity components.
+        components: The components the digest was computed over.
+        created_at: When the directory was first stamped.
+        updated_at: When the stamp was last refreshed.
+    """
+
+    identity_version: int
+    run_hash: str
+    digest: str
+    components: Dict[str, Any]
+    created_at: str
+    updated_at: str
+
+    def to_dict(self) -> Dict[str, Any]:
+        """Convert the stamp to a dictionary.
+
+        Returns:
+            Dict[str, Any]: The stamp as it is stored on disk.
+        """
+        return {
+            "identity_version": self.identity_version,
+            "run_hash": self.run_hash,
+            "digest": self.digest,
+            "components": self.components,
+            "created_at": self.created_at,
+            "updated_at": self.updated_at,
+        }
+
+    @classmethod
+    def from_dict(cls, data: Dict[str, Any]) -> "RunStamp":
+        """Create a stamp from its dictionary representation.
+
+        Args:
+            data: A dictionary holding every stamp field.
+
+        Returns:
+            RunStamp: The stamp described by the dictionary.
+        """
+        return cls(
+            identity_version=data["identity_version"],
+            run_hash=data["run_hash"],
+            digest=data["digest"],
+            components=data["components"],
+            created_at=data["created_at"],
+            updated_at=data["updated_at"],
+        )
+
+
+@dataclass(frozen=True)
+class RunDirectoryCheck:
+    """The outcome of reconciling a run's cache directory with its identity.
+
+    Attributes:
+        status: One of "created", "adopted", "upgraded" or "matched".
+        stamp: The stamp the directory carries after reconciliation.
+        previous_version: The identity version found in the directory, if any.
+    """
+
+    status: str
+    stamp: RunStamp
+    previous_version: Optional[int]
+
+
+def _get_function_hash(func) -> str:
+    # setting recursion limit to avoid random recursion limit error
+    # todo: understand why this is happening and fix it
+    import sys
+
+    sys.setrecursionlimit(10000)
+
+    """Get a hash of a function's source code."""
+    if func is None:
+        return xxh64("").hexdigest()
+
+    # Remove parameter annotations to avoid dill complaining about pickling
+    # pydantic BaseModel: https://github.com/bespokelabsai/curator/issues/229.
+    # For class/instance methods, get the underlying function
+    if hasattr(func, "__func__"):
+        func = func.__func__
+
+    # Clear annotations if they exist
+    if hasattr(func, "__annotations__"):
+        func.__annotations__ = {}
+
+    file = BytesIO()
+
+    from datasets.utils._dill import Pickler
+
+    try:
+        Pickler(file, recurse=True).dump(func)
+    except TypeError:
+        logger.debug("Failed to recursive pickle function, trying non-recursive")
+        Pickler(file, recurse=False).dump(func)
+
+    return xxh64(file.getvalue()).hexdigest()
+
+
+def _canonicalize(components: Dict[str, Any], identity_version: int) -> str:
+    """Serialize identity components into a canonical, version-tagged string."""
+    return json.dumps(
+        {"identity_version": identity_version, "components": components},
+        sort_keys=True,
+        separators=(",", ":"),
+        default=str,
+    )
+
+
+def compute_run_identity(
+    llm,
+    dataset_hash: str = "",
+    *,
+    cache_enabled: bool = True,
+    identity_version: int = RUN_IDENTITY_VERSION,
+    extra_components: Optional[Dict[str, Any]] = None,
+) -> RunIdentity:
+    """Compute the identity of a run of `llm` over a dataset.
+
+    The `llm` argument is duck-typed: anything exposing `prompt_formatter`,
+    `batch_mode`, `backend` and `backend_params` can be identified.
+
+    Args:
+        llm: The object whose run is being identified.
+        dataset_hash: The fingerprint of the dataset being mapped over.
+        cache_enabled: Whether the run may reuse a previous run's cache. When
+            False, a nonce is mixed into the components so that the run gets a
+            cache directory of its own.
+        identity_version: The version of the identity scheme to use.
+        extra_components: Additional components to fold into the identity.
+
+    Returns:
+        RunIdentity: The identity of the run.
+    """
+    prompt_formatter = llm.prompt_formatter
+
+    components: Dict[str, Any] = {
+        "dataset_hash": str(dataset_hash),
+        "prompt_func": _get_function_hash(prompt_formatter.prompt_func),
+        "model_name": prompt_formatter.model_name,
+        "response_format": (prompt_formatter.response_format.model_json_schema() if prompt_formatter.response_format else "text"),
+        "generation_params": dict(prompt_formatter.generation_params or {}),
+        "batch_mode": bool(llm.batch_mode),
+        "backend": llm.backend,
+        "backend_params": dict(llm.backend_params or {}),
+    }
+
+    if extra_components:
+        components.update(extra_components)
+
+    if not cache_enabled:
+        # A cache-disabled run must not collide with any other run.
+        components["cache_disabled_nonce"] = xxh64(os.urandom(8)).hexdigest()
+
+    canonical = _canonicalize(components, identity_version)
+    digest = xxh64(canonical.encode("utf-8")).hexdigest()
+    run_hash = f"v{identity_version}-{digest}"
+
+    logger.debug(f"Curator run identity components: {canonical}")
+    logger.debug(f"Curator run hash: {run_hash}")
+
+    return RunIdentity(
+        run_hash=run_hash,
+        digest=digest,
+        identity_version=identity_version,
+        cache_enabled=cache_enabled,
+        components=components,
+    )
+
+
+def write_run_stamp(run_cache_dir: Union[str, Path], identity: RunIdentity, *, now: str, created_at: Optional[str] = None) -> RunStamp:
+    """Write the run identity stamp of a cache directory.
+
+    Args:
+        run_cache_dir: The run's cache directory. It is created if missing.
+        identity: The identity to stamp the directory with.
+        now: The timestamp to record as `updated_at`.
+        created_at: The timestamp to keep as `created_at`. Defaults to `now`.
+
+    Returns:
+        RunStamp: The stamp that was written.
+    """
+    run_cache_dir = Path(run_cache_dir)
+    run_cache_dir.mkdir(parents=True, exist_ok=True)
+
+    stamp = RunStamp(
+        identity_version=identity.identity_version,
+        run_hash=identity.run_hash,
+        digest=identity.digest,
+        components=identity.components,
+        created_at=created_at if created_at is not None else now,
+        updated_at=now,
+    )
+
+    with open(run_cache_dir / RUN_IDENTITY_FILENAME, "w") as f:
+        f.write(json.dumps(stamp.to_dict(), indent=2, sort_keys=True) + "\n")
+
+    return stamp
+
+
+def read_run_stamp(run_cache_dir: Union[str, Path]) -> Optional[RunStamp]:
+    """Read the run identity stamp of a cache directory.
+
+    Args:
+        run_cache_dir: The run's cache directory.
+
+    Returns:
+        Optional[RunStamp]: The stamp, or None if it is absent, unreadable or
+            incomplete.
+    """
+    path = Path(run_cache_dir) / RUN_IDENTITY_FILENAME
+    try:
+        with open(path, "r") as f:
+            data = json.load(f)
+    except (OSError, ValueError):
+        return None
+
+    if not isinstance(data, dict) or any(field not in data for field in _STAMP_FIELDS):
+        logger.debug(f"Ignoring incomplete run identity stamp at {path}")
+        return None
+
+    return RunStamp.from_dict(data)
+
+
+def _mismatched_components(expected: Dict[str, Any], found: Dict[str, Any]) -> Tuple[str, ...]:
+    """Get the alphabetically sorted component keys whose values differ."""
+    keys = set(expected) | set(found)
+    return tuple(sorted(key for key in keys if expected.get(key) != found.get(key)))
+
+
+def reconcile_run_directory(run_cache_dir: Union[str, Path], identity: RunIdentity, *, now: str) -> RunDirectoryCheck:
+    """Make sure a cache directory belongs to a run, stamping it if needed.
+
+    A missing or empty directory is created and stamped, an unstamped directory
+    with contents is adopted, a stamp from an older identity version is
+    rewritten (keeping its creation time), and a stamp that already matches only
+    has its `updated_at` refreshed.
+
+    Args:
+        run_cache_dir: The run's cache directory.
+        identity: The identity of the run that wants to use the directory.
+        now: The timestamp to record as `updated_at`.
+
+    Returns:
+        RunDirectoryCheck: The outcome of the reconciliation.
+
+    Raises:
+        RunIdentityMismatch: If the directory is stamped with a different run of
+            the same identity version, or with a newer identity version. Nothing
+            is deleted; it is up to the caller to decide what to do.
+    """
+    run_cache_dir = Path(run_cache_dir)
+    run_cache_dir.mkdir(parents=True, exist_ok=True)
+
+    stamp = read_run_stamp(run_cache_dir)
+
+    if stamp is None:
+        contents = [entry for entry in run_cache_dir.iterdir() if entry.name != RUN_IDENTITY_FILENAME]
+        status = "adopted" if contents else "created"
+        if status == "adopted":
+            logger.debug(f"Adopting unstamped cache directory {run_cache_dir} for run {identity.run_hash}")
+        return RunDirectoryCheck(status=status, stamp=write_run_stamp(run_cache_dir, identity, now=now), previous_version=None)
+
+    if stamp.identity_version > identity.identity_version:
+        raise RunIdentityMismatch(run_cache_dir, identity.run_hash, stamp.run_hash, ("identity_version",))
+
+    if stamp.identity_version < identity.identity_version:
+        logger.debug(f"Upgrading run identity of {run_cache_dir} from version {stamp.identity_version} to {identity.identity_version}")
+        new_stamp = write_run_stamp(run_cache_dir, identity, now=now, created_at=stamp.created_at)
+        return RunDirectoryCheck(status="upgraded", stamp=new_stamp, previous_version=stamp.identity_version)
+
+    mismatched = _mismatched_components(identity.components, stamp.components)
+    if mismatched or stamp.run_hash != identity.run_hash or stamp.digest != identity.digest:
+        if not mismatched:
+            mismatched = ("digest",) if stamp.digest != identity.digest else ("run_hash",)
+        raise RunIdentityMismatch(run_cache_dir, identity.run_hash, stamp.run_hash, mismatched)
+
+    return RunDirectoryCheck(
+        status="matched",
+        stamp=write_run_stamp(run_cache_dir, identity, now=now, created_at=stamp.created_at),
+        previous_version=stamp.identity_version,
+    )
