diff --git a/src/bespokelabs/curator/run_identity.py b/src/bespokelabs/curator/run_identity.py
new file mode 100644
index 0000000..5e99fda
--- /dev/null
+++ b/src/bespokelabs/curator/run_identity.py
@@ -0,0 +1,463 @@
+"""Explicit, versioned identity for a Curator run.
+
+A run identity is the set of inputs that decide whether two runs may share a
+cache directory. The components are hashed into a short digest, the digest names
+the cache directory, and a stamp file inside that directory records the identity
+that created it so a later run can tell "same run" from "collision" instead of
+silently reusing someone else's responses.
+"""
+
+import json
+import os
+from dataclasses import dataclass
+from io import BytesIO
+from pathlib import Path
+from typing import Any, Dict, Optional, Tuple, Union
+
+from xxhash import xxh64
+
+from bespokelabs.curator.log import logger
+
+RUN_IDENTITY_VERSION: int = 3
+RUN_IDENTITY_FILENAME: str = "run_identity.json"
+
+#: The components hashed into the run digest, in alphabetical order.
+IDENTITY_COMPONENT_KEYS: tuple[str, ...] = (
+    "backend",
+    "backend_params",
+    "batch_mode",
+    "dataset_hash",
+    "generation_params",
+    "model_name",
+    "parse_func_hash",
+    "prompt_func_hash",
+    "response_format",
+    "return_completions_object",
+    "run_id",
+    "system_prompt",
+)
+
+#: The only backend params that are identity. Everything else (retries, timeouts,
+#: credentials, rate limits, ...) tunes how a run executes, not what it produces,
+#: and must not fork the cache directory.
+IDENTITY_BACKEND_PARAM_KEYS: frozenset[str] = frozenset(
+    {
+        "azure_deployment",
+        "base_url",
+        "batch_size",
+        "completion_window",
+    }
+)
+
+_STAMP_KEYS: tuple[str, ...] = (
+    "identity_version",
+    "run_hash",
+    "digest",
+    "components",
+    "created_at",
+    "updated_at",
+)
+
+
+class RunIdentityError(RuntimeError):
+    """Base class for every run identity failure."""
+
+
+class RunIdentityMismatch(RunIdentityError):  # noqa: N818
+    """Raised when a cache directory was stamped by a different run identity.
+
+    Attributes:
+        path: Path of the stamp file that disagrees.
+        expected_run_hash: Run hash of the run being started.
+        found_run_hash: Run hash recorded in the stamp file.
+        mismatched_components: Names of the identity components that differ.
+    """
+
+    def __init__(self, path, expected_run_hash, found_run_hash, mismatched_components):
+        """Initialize the mismatch.
+
+        Args:
+            path: Path of the stamp file that disagrees.
+            expected_run_hash: Run hash of the run being started.
+            found_run_hash: Run hash recorded in the stamp file.
+            mismatched_components: Names of the identity components that differ.
+        """
+        self.path = path
+        self.expected_run_hash = expected_run_hash
+        self.found_run_hash = found_run_hash
+        self.mismatched_components = mismatched_components
+        super().__init__(
+            f"Run identity mismatch in {path}: expected run hash {expected_run_hash}, found {found_run_hash} "
+            f"(differing: {', '.join(mismatched_components)}). Nothing was deleted; remove the directory yourself "
+            "if you are sure the cached responses are no longer wanted."
+        )
+
+
+class CachedResponseMismatch(RunIdentityError):  # noqa: N818
+    """Raised when a cached response does not describe the dataset it is loaded against.
+
+    Attributes:
+        cache_dir: Directory the cached response was loaded from.
+        field: Name of the dataset field that differs.
+        expected: Value recorded in the cached response.
+        found: Value of the dataset handed to the load.
+    """
+
+    def __init__(self, cache_dir, field, expected, found):
+        """Initialize the mismatch.
+
+        Args:
+            cache_dir: Directory the cached response was loaded from.
+            field: Name of the dataset field that differs.
+            expected: Value recorded in the cached response.
+            found: Value of the dataset handed to the load.
+        """
+        self.cache_dir = cache_dir
+        self.field = field
+        self.expected = expected
+        self.found = found
+        super().__init__(f"Cached response in {cache_dir} does not match the dataset: {field} is {found!r}, cached run recorded {expected!r}.")
+
+
+@dataclass(frozen=True)
+class RunIdentity:
+    """The identity of a single run.
+
+    Attributes:
+        run_hash: Name of the cache directory for this run.
+        digest: Hash of the identity components.
+        identity_version: Version of the identity scheme that produced the digest.
+        cache_enabled: Whether this run is allowed to reuse cached responses.
+        components: The components the digest was computed over.
+    """
+
+    run_hash: str
+    digest: str
+    identity_version: int
+    cache_enabled: bool
+    components: Dict[str, Any]
+
+
+@dataclass(frozen=True)
+class RunStamp:
+    """The identity recorded inside a run's cache directory.
+
+    Attributes:
+        identity_version: Version of the identity scheme that wrote the stamp.
+        run_hash: Run hash the directory belongs to.
+        digest: Hash of the identity components.
+        components: The components the digest was computed over.
+        created_at: When the directory was first stamped.
+        updated_at: When the stamp was last refreshed.
+    """
+
+    identity_version: int
+    run_hash: str
+    digest: str
+    components: Dict[str, Any]
+    created_at: str
+    updated_at: str
+
+    def to_dict(self) -> Dict[str, Any]:
+        """Convert the stamp to its serialisable form.
+
+        Returns:
+            Dict[str, Any]: The stamp as written to the stamp file.
+        """
+        return {
+            "identity_version": self.identity_version,
+            "run_hash": self.run_hash,
+            "digest": self.digest,
+            "components": self.components,
+            "created_at": self.created_at,
+            "updated_at": self.updated_at,
+        }
+
+    @classmethod
+    def from_dict(cls, data: Dict[str, Any]) -> "RunStamp":
+        """Build a stamp from its serialisable form.
+
+        Args:
+            data: A dictionary holding every stamp key.
+
+        Returns:
+            RunStamp: The stamp described by ``data``.
+        """
+        return cls(
+            identity_version=data["identity_version"],
+            run_hash=data["run_hash"],
+            digest=data["digest"],
+            components=data["components"],
+            created_at=data["created_at"],
+            updated_at=data["updated_at"],
+        )
+
+
+@dataclass(frozen=True)
+class RunDirectoryCheck:
+    """The outcome of reconciling a run identity with a cache directory.
+
+    Attributes:
+        status: One of "created", "adopted", "upgraded" or "matched".
+        stamp: The stamp the directory now holds.
+        previous_version: Identity version the directory held before, if any.
+    """
+
+    status: str
+    stamp: RunStamp
+    previous_version: Optional[int]
+
+
+def _identity_components(llm, dataset_hash: str, *, cache_enabled: bool = True, run_id: Optional[str] = None) -> Dict[str, Any]:
+    """Build the identity components of a run.
+
+    Args:
+        llm: The object being run. Only its attributes are used, so any object
+            exposing a prompt formatter, a backend and a batch mode works.
+        dataset_hash: Fingerprint of the dataset being mapped over.
+        cache_enabled: Whether this run is allowed to reuse cached responses.
+        run_id: Identifier standing in for the cache when caching is disabled.
+
+    Returns:
+        Dict[str, Any]: The components keyed by IDENTITY_COMPONENT_KEYS.
+
+    Raises:
+        RunIdentityError: If run_id does not agree with cache_enabled.
+    """
+    if cache_enabled:
+        if run_id is not None:
+            raise RunIdentityError("A cached run derives its identity from its inputs, so run_id must be None when caching is enabled.")
+    elif not run_id:
+        raise RunIdentityError("A cache-disabled run needs a run_id to be identified by, set CURATOR_RUN_ID or pass run_id explicitly.")
+
+    prompt_formatter = llm.prompt_formatter
+    response_format = getattr(prompt_formatter, "response_format", None)
+    backend_params = getattr(llm, "backend_params", None) or {}
+
+    return {
+        "backend": llm.backend,
+        "backend_params": {key: value for key, value in backend_params.items() if key in IDENTITY_BACKEND_PARAM_KEYS},
+        "batch_mode": bool(getattr(llm, "batch_mode", False)),
+        "dataset_hash": dataset_hash,
+        "generation_params": dict(getattr(prompt_formatter, "generation_params", None) or {}),
+        "model_name": prompt_formatter.model_name,
+        "parse_func_hash": _get_function_hash(getattr(prompt_formatter, "parse_func", None)),
+        "prompt_func_hash": _get_function_hash(prompt_formatter.prompt_func),
+        "response_format": (json.dumps(response_format.model_json_schema(), sort_keys=True, separators=(",", ":")) if response_format else "text"),
+        "return_completions_object": bool(getattr(llm, "return_completions_object", False)),
+        "run_id": None if cache_enabled else run_id,
+        "system_prompt": getattr(prompt_formatter, "system_prompt", None),
+    }
+
+
+def _serialize_components(components: Dict[str, Any]) -> str:
+    """Serialise identity components canonically.
+
+    Args:
+        components: The identity components to serialise.
+
+    Returns:
+        str: A key-sorted, version-tagged rendering of the components.
+    """
+    return json.dumps(
+        {"identity_version": RUN_IDENTITY_VERSION, "components": components},
+        sort_keys=True,
+        separators=(",", ":"),
+        default=str,
+    )
+
+
+def compute_run_identity(llm, dataset_hash: str, *, cache_enabled: bool = True, run_id: Optional[str] = None) -> RunIdentity:
+    """Compute the identity of a run.
+
+    Args:
+        llm: The object being run. Only its attributes are used, so any object
+            exposing a prompt formatter, a backend and a batch mode works.
+        dataset_hash: Fingerprint of the dataset being mapped over.
+        cache_enabled: Whether this run is allowed to reuse cached responses.
+        run_id: Identifier standing in for the cache when caching is disabled.
+            Replaying the same run_id replays the same directory.
+
+    Returns:
+        RunIdentity: The identity of the run, whose run hash names its cache directory.
+
+    Raises:
+        RunIdentityError: If run_id does not agree with cache_enabled.
+    """
+    components = _identity_components(llm, dataset_hash, cache_enabled=cache_enabled, run_id=run_id)
+    serialized = _serialize_components(components)
+    digest = xxh64(serialized.encode("utf-8")).hexdigest()
+    prefix = f"v{RUN_IDENTITY_VERSION}-" if cache_enabled else f"v{RUN_IDENTITY_VERSION}-nocache-"
+
+    logger.debug(f"Curator run identity components: {serialized}")
+    logger.debug(f"Curator run identity digest: {digest}")
+
+    return RunIdentity(
+        run_hash=f"{prefix}{digest}",
+        digest=digest,
+        identity_version=RUN_IDENTITY_VERSION,
+        cache_enabled=cache_enabled,
+        components=components,
+    )
+
+
+def write_run_stamp(run_cache_dir: Union[str, Path], identity: RunIdentity, *, now: str, created_at: Optional[str] = None) -> RunStamp:
+    """Write the identity stamp of a run into its cache directory.
+
+    Args:
+        run_cache_dir: The run's cache directory. Created if it does not exist.
+        identity: The identity to record.
+        now: Timestamp to record as the stamp's update time.
+        created_at: Creation time to preserve. Defaults to now for a fresh stamp.
+
+    Returns:
+        RunStamp: The stamp that was written.
+    """
+    run_cache_dir = Path(run_cache_dir)
+    run_cache_dir.mkdir(parents=True, exist_ok=True)
+
+    stamp = RunStamp(
+        identity_version=identity.identity_version,
+        run_hash=identity.run_hash,
+        digest=identity.digest,
+        components=identity.components,
+        created_at=created_at if created_at is not None else now,
+        updated_at=now,
+    )
+    with open(run_cache_dir / RUN_IDENTITY_FILENAME, "w") as f:
+        f.write(json.dumps(stamp.to_dict(), indent=2, sort_keys=True) + "\n")
+
+    return stamp
+
+
+def read_run_stamp(run_cache_dir: Union[str, Path]) -> Optional[RunStamp]:
+    """Read the identity stamp of a run's cache directory.
+
+    Args:
+        run_cache_dir: The run's cache directory.
+
+    Returns:
+        Optional[RunStamp]: The recorded stamp, or None if the directory holds no
+            readable stamp.
+    """
+    stamp_path = Path(run_cache_dir) / RUN_IDENTITY_FILENAME
+    try:
+        with open(stamp_path, "r") as f:
+            data = json.load(f)
+    except (OSError, ValueError):
+        return None
+
+    if not isinstance(data, dict) or any(key not in data for key in _STAMP_KEYS):
+        logger.debug(f"Ignoring incomplete run identity stamp at {stamp_path}")
+        return None
+
+    return RunStamp.from_dict(data)
+
+
+def _mismatched_components(stamp: RunStamp, identity: RunIdentity) -> Tuple[str, ...]:
+    """Find the components on which a stamp and an identity disagree.
+
+    Args:
+        stamp: The stamp recorded in the cache directory.
+        identity: The identity of the run being started.
+
+    Returns:
+        Tuple[str, ...]: The differing component names, alphabetically sorted.
+    """
+    components = stamp.components if isinstance(stamp.components, dict) else {}
+    keys = set(components) | set(identity.components)
+    return tuple(sorted(key for key in keys if components.get(key) != identity.components.get(key)))
+
+
+def reconcile_run_directory(run_cache_dir: Union[str, Path], identity: RunIdentity, *, now: str) -> RunDirectoryCheck:
+    """Make a run's cache directory usable by a run identity, or refuse to.
+
+    A missing or empty directory is created and stamped, a non-empty directory
+    left behind by an older Curator is adopted, a stamp from an older identity
+    version is rewritten, and a stamp that already matches is refreshed.
+
+    Args:
+        run_cache_dir: The run's cache directory.
+        identity: The identity of the run being started.
+        now: Timestamp to record as the stamp's update time.
+
+    Returns:
+        RunDirectoryCheck: The outcome, including the stamp the directory now holds.
+
+    Raises:
+        RunIdentityMismatch: If the directory belongs to a different run, or to a
+            newer identity version. Nothing is deleted.
+    """
+    run_cache_dir = Path(run_cache_dir)
+
+    if not run_cache_dir.is_dir() or not os.listdir(run_cache_dir):
+        return RunDirectoryCheck(status="created", stamp=write_run_stamp(run_cache_dir, identity, now=now), previous_version=None)
+
+    stamp = read_run_stamp(run_cache_dir)
+    if stamp is None:
+        logger.debug(f"Adopting unstamped run directory {run_cache_dir}")
+        return RunDirectoryCheck(status="adopted", stamp=write_run_stamp(run_cache_dir, identity, now=now), previous_version=None)
+
+    if stamp.identity_version > identity.identity_version:
+        raise RunIdentityMismatch(
+            path=run_cache_dir / RUN_IDENTITY_FILENAME,
+            expected_run_hash=identity.run_hash,
+            found_run_hash=stamp.run_hash,
+            mismatched_components=("identity_version",),
+        )
+
+    if stamp.identity_version < identity.identity_version:
+        return RunDirectoryCheck(
+            status="upgraded",
+            stamp=write_run_stamp(run_cache_dir, identity, now=now, created_at=stamp.created_at),
+            previous_version=stamp.identity_version,
+        )
+
+    mismatched = _mismatched_components(stamp, identity)
+    if mismatched or stamp.run_hash != identity.run_hash or stamp.digest != identity.digest:
+        raise RunIdentityMismatch(
+            path=run_cache_dir / RUN_IDENTITY_FILENAME,
+            expected_run_hash=identity.run_hash,
+            found_run_hash=stamp.run_hash,
+            mismatched_components=mismatched or ("digest",),
+        )
+
+    return RunDirectoryCheck(
+        status="matched",
+        stamp=write_run_stamp(run_cache_dir, identity, now=now, created_at=stamp.created_at),
+        previous_version=stamp.identity_version,
+    )
+
+
+def _get_function_hash(func) -> str:
+    # setting recursion limit to avoid random recursion limit error
+    # todo: understand why this is happening and fix it
+    import sys
+
+    sys.setrecursionlimit(10000)
+
+    """Get a hash of a function's source code."""
+    if func is None:
+        return xxh64("").hexdigest()
+
+    # Remove parameter annotations to avoid dill complaining about pickling
+    # pydantic BaseModel: https://github.com/bespokelabsai/curator/issues/229.
+    # For class/instance methods, get the underlying function
+    if hasattr(func, "__func__"):
+        func = func.__func__
+
+    # Clear annotations if they exist
+    if hasattr(func, "__annotations__"):
+        func.__annotations__ = {}
+
+    file = BytesIO()
+
+    from datasets.utils._dill import Pickler
+
+    try:
+        Pickler(file, recurse=True).dump(func)
+    except TypeError:
+        logger.debug("Failed to recursive pickle function, trying non-recursive")
+        Pickler(file, recurse=False).dump(func)
+
+    return xxh64(file.getvalue()).hexdigest()
