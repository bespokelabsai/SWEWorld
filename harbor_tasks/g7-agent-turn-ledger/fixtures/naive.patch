new file mode 100644
index 0000000..30ea756
--- /dev/null
+++ b/src/bespokelabs/curator/agent/turn_ledger.py
@@ -0,0 +1,281 @@
+"""The durable record of a multi-turn agent conversation."""
+
+import datetime
+import os
+import typing as t
+from dataclasses import dataclass
+
+from bespokelabs.curator.agent.agent_response import AgentResponse
+from bespokelabs.curator.types.generic_request import GenericRequest
+
+# Name of the JSONL file holding the conversation log inside a working directory.
+RESPONSES_FILENAME: str = "responses_0.jsonl"
+
+# Finish reason written on the seed line, so it is distinguishable from a generated turn.
+SEED_FINISH_REASON: str = "seed"
+
+# Marker an agent can emit to signal that the conversation is over.
+COMPLETION_SENTINEL: str = "[[CONVERSATION_COMPLETE]]"
+
+# Every reason a conversation can be in, "open" meaning it is not completed.
+COMPLETION_REASONS: tuple[str, ...] = ("open", "budget", "agent_signal")
+
+# Provenance of a ledger: freshly seeded, adopted by a status tracker, or read back from disk.
+LEDGER_STATUSES: tuple[str, ...] = ("created", "adopted", "verified")
+
+
+class TurnLedgerError(RuntimeError):
+    """Base class for every turn ledger failure."""
+
+
+class TurnLedgerCorruptError(TurnLedgerError):
+    """Raised when a line of the conversation log cannot be read back.
+
+    Attributes:
+        path (str): Path of the log file that could not be read.
+        line_number (int): 1-based index of the offending physical line.
+        reason (str): Description of why the line could not be parsed.
+    """
+
+    def __init__(self, path: str, line_number: int, reason: str):
+        """Initialize a TurnLedgerCorruptError.
+
+        Args:
+            path (str): Path of the log file that could not be read.
+            line_number (int): 1-based index of the offending physical line.
+            reason (str): Description of why the line could not be parsed.
+        """
+        super().__init__(f"Corrupt turn ledger at {path}:{line_number}: {reason}")
+        self.path = path
+        self.line_number = line_number
+        self.reason = reason
+
+
+@dataclass(frozen=True)
+class TurnEntry:
+    """A single logged turn of a conversation.
+
+    Attributes:
+        turn (int): 0-based index of this entry in the log, the seed being 0.
+        author (str): Name of the agent this line was written under.
+        content (str): The message text of this turn.
+        source (str): "seed" for the seed turn, "response" for a generated one.
+    """
+
+    turn: int
+    author: str
+    content: str
+    source: str
+
+
+@dataclass(frozen=True)
+class TurnLedger:
+    """The state of a conversation, derived entirely from its log.
+
+    Attributes:
+        entries (tuple[TurnEntry, ...]): Every logged turn, in log order.
+        seeder_name (str): Name of the seeder agent.
+        partner_name (str): Name of the partner agent.
+        max_responses (int): Budget of generated responses, the seed excluded.
+        responses (int): Number of generated responses in the log.
+        turns (int): Number of logged turns, the seed included.
+        next_speaker (Optional[str]): Agent that speaks next, None once completed.
+        last_author (Optional[str]): Author of the last logged turn.
+        interleave_faults (int): Number of times an author speaks twice in a row.
+        completed (bool): Whether the conversation is over.
+        completion_reason (str): One of COMPLETION_REASONS.
+        status (str): One of LEDGER_STATUSES.
+    """
+
+    entries: tuple[TurnEntry, ...]
+    seeder_name: str
+    partner_name: str
+    max_responses: int
+    responses: int
+    turns: int
+    next_speaker: t.Optional[str]
+    last_author: t.Optional[str]
+    interleave_faults: int
+    completed: bool
+    completion_reason: str
+    status: str
+
+    def messages(self) -> list[dict[str, str]]:
+        """Render the ledger as a conversation history.
+
+        Returns:
+            list[dict[str, str]]: One {"role": author, "content": content} dict per
+                logged turn, in log order.
+        """
+        return [{"role": entry.author, "content": entry.content} for entry in self.entries]
+
+
+def build_seed_record(*, seeder_name: str, seed_message: str, model_name: str, now: datetime.datetime) -> AgentResponse:
+    """Build the durable log line standing for the seed message.
+
+    Args:
+        seeder_name (str): Name of the agent the seed is attributed to.
+        seed_message (str): The message that starts the conversation.
+        model_name (str): Model name recorded on the seed request.
+        now (datetime.datetime): Timestamp used for both created_at and finished_at.
+
+    Returns:
+        AgentResponse: The record to append to the conversation log.
+    """
+    # AgentResponse takes its fields through validation, its dataclass __init__ only takes a name.
+    return AgentResponse.model_validate(
+        {
+            "name": seeder_name,
+            "response_message": seed_message,
+            "parsed_response_message": None,
+            "response_errors": None,
+            "raw_response": None,
+            "raw_request": None,
+            "generic_request": GenericRequest(
+                model=model_name,
+                messages=[{"role": "user", "content": seed_message}],
+                original_row={"prompt": seed_message},
+                original_row_idx=0,
+                response_format=None,
+                generation_params={},
+                is_multimodal_prompt=False,
+            ),
+            "created_at": now,
+            "finished_at": now,
+            "token_usage": None,
+            "response_cost": 0.0,
+            "finish_reason": SEED_FINISH_REASON,
+        }
+    )
+
+
+def read_log(working_dir: str) -> list[AgentResponse]:
+    """Read the conversation log of a working directory.
+
+    Blank lines are skipped, every other unreadable line is an error.
+
+    Args:
+        working_dir (str): Directory containing the conversation log.
+
+    Returns:
+        list[AgentResponse]: The logged records, in log order. Empty when there is no log.
+
+    Raises:
+        TurnLedgerCorruptError: If a non-blank line cannot be parsed as a record.
+    """
+    path = os.path.join(working_dir, RESPONSES_FILENAME)
+    records: list[AgentResponse] = []
+    if not os.path.exists(path):
+        return records
+
+    with open(path, "r") as f:
+        for line_number, line in enumerate(f, start=1):
+            if not line.strip():
+                continue
+            try:
+                records.append(AgentResponse.model_validate_json(line))
+            except ValueError as e:
+                raise TurnLedgerCorruptError(path, line_number, str(e)) from e
+    return records
+
+
+def build_ledger(
+    records: t.Sequence[AgentResponse],
+    *,
+    seeder_name: str,
+    partner_name: str,
+    max_responses: int,
+    is_completed: t.Callable[[str, t.Any], bool],
+    status: str = "verified",
+) -> TurnLedger:
+    """Derive the state of a conversation from its logged records.
+
+    Args:
+        records (Sequence[AgentResponse]): The logged records, in log order.
+        seeder_name (str): Name of the seeder agent.
+        partner_name (str): Name of the partner agent.
+        max_responses (int): Budget of generated responses, the seed excluded.
+        is_completed (Callable[[str, Any], bool]): Called with the author and content of
+            the last entry to decide whether that agent signalled completion.
+        status (str): One of LEDGER_STATUSES, defaults to "verified".
+
+    Returns:
+        TurnLedger: The state implied by the given records.
+    """
+    entries = tuple(
+        TurnEntry(
+            turn=index,
+            author=record.name,
+            content=record.response_message if isinstance(record.response_message, str) else str(record.response_message),
+            source=SEED_FINISH_REASON if index == 0 else "response",
+        )
+        for index, record in enumerate(records)
+    )
+
+    turns = len(entries)
+    responses = max(0, turns - 1)
+    interleave_faults = sum(1 for i in range(1, turns) if entries[i].author == entries[i - 1].author)
+    last_author = entries[-1].author if entries else None
+
+    if not entries:
+        completion_reason = "open"
+    elif is_completed(last_author, entries[-1].content):
+        completion_reason = "agent_signal"
+    elif responses >= max_responses:
+        completion_reason = "budget"
+    else:
+        completion_reason = "open"
+
+    completed = completion_reason != "open"
+    if completed or not entries:
+        next_speaker = None
+    else:
+        next_speaker = partner_name if last_author == seeder_name else seeder_name
+
+    return TurnLedger(
+        entries=entries,
+        seeder_name=seeder_name,
+        partner_name=partner_name,
+        max_responses=max_responses,
+        responses=responses,
+        turns=turns,
+        next_speaker=next_speaker,
+        last_author=last_author,
+        interleave_faults=interleave_faults,
+        completed=completed,
+        completion_reason=completion_reason,
+        status=status,
+    )
+
+
+def load_ledger(
+    working_dir: str,
+    *,
+    seeder_name: str,
+    partner_name: str,
+    max_responses: int,
+    is_completed: t.Callable[[str, t.Any], bool],
+) -> TurnLedger:
+    """Load the ledger of a working directory without writing anything to disk.
+
+    Args:
+        working_dir (str): Directory containing the conversation log.
+        seeder_name (str): Name of the seeder agent.
+        partner_name (str): Name of the partner agent.
+        max_responses (int): Budget of generated responses, the seed excluded.
+        is_completed (Callable[[str, Any], bool]): Completion check for the last entry.
+
+    Returns:
+        TurnLedger: The state of the logged conversation, "verified" against disk.
+
+    Raises:
+        TurnLedgerCorruptError: If a non-blank line of the log cannot be parsed.
+    """
+    return build_ledger(
+        read_log(working_dir),
+        seeder_name=seeder_name,
+        partner_name=partner_name,
+        max_responses=max_responses,
+        is_completed=is_completed,
+        status="verified",
+    )
