@@ -0,0 +1,408 @@
+"""The durable record of a multi-turn agent conversation."""
+
+import dataclasses
+import datetime
+import json
+import os
+import typing as t
+
+from pydantic import ValidationError
+
+from bespokelabs.curator.agent.agent_response import AgentResponse
+from bespokelabs.curator.types.generic_request import GenericRequest
+
+# Name of the append-only conversation log inside a working directory.
+RESPONSES_FILENAME: str = "responses_0.jsonl"
+
+# Name and format version of the JSON checkpoint sitting beside the log.
+TURN_LEDGER_FILENAME: str = "turn_ledger.json"
+TURN_LEDGER_VERSION: int = 2
+
+# The finish reason carried by the seed line, which is not a generated response.
+SEED_FINISH_REASON: str = "seed"
+
+# The suffix an agent appends to its message to end the conversation.
+COMPLETION_SENTINEL: str = "<<END_OF_CONVERSATION>>"
+
+COMPLETION_REASONS: tuple[str, ...] = ("open", "budget", "agent_signal")
+LEDGER_STATUSES: tuple[str, ...] = ("created", "adopted", "verified")
+
+
+class TurnLedgerError(RuntimeError):
+    """Base class for every turn ledger failure."""
+
+
+class TurnLedgerCorruptError(TurnLedgerError):
+    """Raised when a line of the conversation log cannot be parsed.
+
+    Attributes:
+        path (str): Path of the log holding the offending line.
+        line_number (int): 1-based index of the offending line over physical lines.
+        reason (str): Description of why the line could not be parsed.
+    """
+
+    def __init__(self, path: str, line_number: int, reason: str):
+        """Initialize a TurnLedgerCorruptError instance.
+
+        Args:
+            path (str): Path of the log holding the offending line.
+            line_number (int): 1-based index of the offending line.
+            reason (str): Description of why the line could not be parsed.
+        """
+        super().__init__(f"{path} line {line_number} is not a readable turn: {reason}")
+        self.path = path
+        self.line_number = line_number
+        self.reason = reason
+
+
+class TurnLedgerDesyncError(TurnLedgerError):
+    """Raised when the checkpoint disagrees with the log it describes.
+
+    Attributes:
+        path (str): Path of the checkpoint file.
+        log_responses (int): Number of responses the log holds.
+        recorded_responses (t.Any): Number of responses the checkpoint records.
+        log_last_author (t.Optional[str]): Author of the log's last line.
+        recorded_last_author (t.Any): Author the checkpoint records.
+    """
+
+    def __init__(
+        self,
+        path: str,
+        log_responses: int,
+        recorded_responses: t.Any,
+        log_last_author: t.Optional[str],
+        recorded_last_author: t.Any,
+    ):
+        """Initialize a TurnLedgerDesyncError instance.
+
+        Args:
+            path (str): Path of the checkpoint file.
+            log_responses (int): Number of responses the log holds.
+            recorded_responses (t.Any): Number of responses the checkpoint records.
+            log_last_author (t.Optional[str]): Author of the log's last line.
+            recorded_last_author (t.Any): Author the checkpoint records.
+        """
+        super().__init__(
+            f"{path} records {recorded_responses} response(s) last authored by {recorded_last_author!r}, "
+            f"the log holds {log_responses} last authored by {log_last_author!r}"
+        )
+        self.path = path
+        self.log_responses = log_responses
+        self.recorded_responses = recorded_responses
+        self.log_last_author = log_last_author
+        self.recorded_last_author = recorded_last_author
+
+
+@dataclasses.dataclass(frozen=True)
+class TurnEntry:
+    """A single line of the conversation log.
+
+    Attributes:
+        turn (int): 0-based index into the log. The seed is turn 0.
+        author (str): Name of the agent the line was written under.
+        content (str): The message text of the line.
+        source (str): "seed" for turn 0, "response" otherwise.
+    """
+
+    turn: int
+    author: str
+    content: str
+    source: str
+
+
+@dataclasses.dataclass(frozen=True)
+class TurnLedger:
+    """The state of a conversation, derived from its log.
+
+    Attributes:
+        entries (tuple[TurnEntry, ...]): Every line of the log, in log order.
+        seeder_name (str): Name of the seeder agent.
+        partner_name (str): Name of the partner agent.
+        max_responses (int): Budget of generated responses. The seed is not one.
+        responses (int): Number of generated responses, i.e. every entry but the seed.
+        turns (int): Number of entries in the log.
+        next_speaker (t.Optional[str]): Agent owing the next turn, None once completed.
+        last_author (t.Optional[str]): Author of the last entry, None for an empty log.
+        interleave_faults (int): Number of entries whose author repeats the previous one.
+        completed (bool): Whether the conversation is over.
+        completion_reason (str): One of COMPLETION_REASONS.
+        status (str): One of LEDGER_STATUSES, describing how the ledger was obtained.
+    """
+
+    entries: tuple[TurnEntry, ...]
+    seeder_name: str
+    partner_name: str
+    max_responses: int
+    responses: int
+    turns: int
+    next_speaker: t.Optional[str]
+    last_author: t.Optional[str]
+    interleave_faults: int
+    completed: bool
+    completion_reason: str
+    status: str
+
+    def messages(self) -> list[dict[str, str]]:
+        """Return the conversation as role/content dictionaries in log order.
+
+        Returns:
+            list[dict[str, str]]: One dictionary per entry, keyed by agent name.
+        """
+        return [{"role": entry.author, "content": entry.content} for entry in self.entries]
+
+    def sidecar_state(self) -> dict[str, t.Any]:
+        """Return the checkpoint state describing this ledger.
+
+        Returns:
+            dict[str, t.Any]: The eight keys persisted beside the log.
+        """
+        return {
+            "version": TURN_LEDGER_VERSION,
+            "responses": self.responses,
+            "turns": self.turns,
+            "last_author": self.last_author,
+            "next_speaker": self.next_speaker,
+            "interleave_faults": self.interleave_faults,
+            "completed": self.completed,
+            "completion_reason": self.completion_reason,
+        }
+
+
+def build_seed_record(*, seeder_name: str, seed_message: str, model_name: str, now: datetime.datetime) -> AgentResponse:
+    """Build the log line standing for the seed message.
+
+    Args:
+        seeder_name (str): Name of the agent the seed is written under.
+        seed_message (str): The initial message of the conversation.
+        model_name (str): Model name recorded on the seed's request.
+        now (datetime.datetime): Timestamp used for both creation and completion.
+
+    Returns:
+        AgentResponse: The record to append to the log.
+    """
+    generic_request = GenericRequest(
+        model=model_name,
+        messages=[{"role": "user", "content": seed_message}],
+        original_row={"prompt": seed_message},
+        original_row_idx=0,
+        response_format=None,
+        generation_params={},
+        is_multimodal_prompt=False,
+    )
+    return AgentResponse.model_validate(
+        {
+            "response_message": seed_message,
+            "parsed_response_message": None,
+            "response_errors": None,
+            "raw_response": None,
+            "raw_request": None,
+            "generic_request": generic_request,
+            "created_at": now,
+            "finished_at": now,
+            "token_usage": None,
+            "response_cost": 0.0,
+            "finish_reason": SEED_FINISH_REASON,
+            "name": seeder_name,
+        }
+    )
+
+
+def read_log(working_dir: str) -> list[AgentResponse]:
+    """Read every record of the conversation log.
+
+    Args:
+        working_dir (str): Directory holding the conversation log.
+
+    Returns:
+        list[AgentResponse]: The records, in log order. Empty when there is no log.
+
+    Raises:
+        TurnLedgerCorruptError: If a non-blank line cannot be parsed as a record.
+    """
+    path = os.path.join(working_dir, RESPONSES_FILENAME)
+    records: list[AgentResponse] = []
+    if not os.path.exists(path):
+        return records
+
+    with open(path, "r") as f:
+        for line_number, line in enumerate(f, start=1):
+            if not line.strip():
+                continue
+            try:
+                records.append(AgentResponse.model_validate_json(line))
+            except (ValidationError, ValueError) as e:
+                raise TurnLedgerCorruptError(path, line_number, str(e)) from e
+    return records
+
+
+def build_ledger(
+    records: t.Sequence[AgentResponse],
+    *,
+    seeder_name: str,
+    partner_name: str,
+    max_responses: int,
+    is_completed: t.Callable[[str, t.Any], bool],
+    status: str = "verified",
+) -> TurnLedger:
+    """Derive the state of a conversation from its records.
+
+    Args:
+        records (Sequence[AgentResponse]): The log records, in log order.
+        seeder_name (str): Name of the seeder agent.
+        partner_name (str): Name of the partner agent.
+        max_responses (int): Budget of generated responses.
+        is_completed (Callable[[str, t.Any], bool]): Predicate telling whether the
+            message written by an agent signals the end of the conversation.
+        status (str): How this ledger was obtained. One of LEDGER_STATUSES.
+
+    Returns:
+        TurnLedger: The state derived from the records.
+    """
+    entries = tuple(
+        TurnEntry(
+            turn=index,
+            author=record.name,
+            content=record.response_message if isinstance(record.response_message, str) else str(record.response_message),
+            source="seed" if index == 0 else "response",
+        )
+        for index, record in enumerate(records)
+    )
+
+    turns = len(entries)
+    responses = max(turns - 1, 0)
+    interleave_faults = sum(1 for i in range(1, turns) if entries[i].author == entries[i - 1].author)
+    last_author = entries[-1].author if entries else None
+
+    if entries and is_completed(entries[-1].author, entries[-1].content):
+        completion_reason = "agent_signal"
+    elif entries and responses >= max_responses:
+        completion_reason = "budget"
+    else:
+        completion_reason = "open"
+    completed = completion_reason != "open"
+
+    if not entries or completed:
+        next_speaker = None
+    else:
+        next_speaker = partner_name if last_author == seeder_name else seeder_name
+
+    return TurnLedger(
+        entries=entries,
+        seeder_name=seeder_name,
+        partner_name=partner_name,
+        max_responses=max_responses,
+        responses=responses,
+        turns=turns,
+        next_speaker=next_speaker,
+        last_author=last_author,
+        interleave_faults=interleave_faults,
+        completed=completed,
+        completion_reason=completion_reason,
+        status=status,
+    )
+
+
+def read_sidecar(working_dir: str) -> t.Optional[dict[str, t.Any]]:
+    """Read the checkpoint sitting beside the log.
+
+    Args:
+        working_dir (str): Directory holding the checkpoint.
+
+    Returns:
+        Optional[dict[str, t.Any]]: The recorded state, or None when the file is
+            absent or unreadable as a JSON object.
+    """
+    path = os.path.join(working_dir, TURN_LEDGER_FILENAME)
+    if not os.path.exists(path):
+        return None
+    try:
+        with open(path, "r") as f:
+            state = json.load(f)
+    except (OSError, ValueError):
+        return None
+    if not isinstance(state, dict):
+        return None
+    return state
+
+
+def write_sidecar(working_dir: str, ledger: TurnLedger) -> str:
+    """Write the checkpoint describing a ledger.
+
+    Args:
+        working_dir (str): Directory holding the log.
+        ledger (TurnLedger): The ledger to record.
+
+    Returns:
+        str: Absolute path of the checkpoint file.
+    """
+    path = os.path.join(working_dir, TURN_LEDGER_FILENAME)
+    with open(path, "w") as f:
+        f.write(json.dumps(ledger.sidecar_state(), indent=2, sort_keys=True) + "\n")
+    return os.path.abspath(path)
+
+
+def verify_sidecar(working_dir: str, ledger: TurnLedger) -> TurnLedger:
+    """Check a log-derived ledger against the checkpoint beside the log.
+
+    The log is the authority: no entry is dropped or rewritten to agree with the
+    checkpoint, and only the recorded responses and last author are compared.
+
+    Args:
+        working_dir (str): Directory holding the log and its checkpoint.
+        ledger (TurnLedger): The ledger derived from the log.
+
+    Returns:
+        TurnLedger: The same ledger carrying its verification status.
+
+    Raises:
+        TurnLedgerDesyncError: If a checkpoint of the current version disagrees
+            with the log.
+    """
+    path = os.path.join(working_dir, TURN_LEDGER_FILENAME)
+    state = read_sidecar(working_dir)
+    if state is None or state.get("version") != TURN_LEDGER_VERSION:
+        return dataclasses.replace(ledger, status="adopted")
+
+    recorded_responses = state.get("responses")
+    recorded_last_author = state.get("last_author")
+    if recorded_responses == ledger.responses and recorded_last_author == ledger.last_author:
+        return dataclasses.replace(ledger, status="verified")
+
+    raise TurnLedgerDesyncError(path, ledger.responses, recorded_responses, ledger.last_author, recorded_last_author)
+
+
+def load_ledger(
+    working_dir: str,
+    *,
+    seeder_name: str,
+    partner_name: str,
+    max_responses: int,
+    is_completed: t.Callable[[str, t.Any], bool],
+) -> TurnLedger:
+    """Load the ledger of a working directory without writing to disk.
+
+    Args:
+        working_dir (str): Directory holding the log and its checkpoint.
+        seeder_name (str): Name of the seeder agent.
+        partner_name (str): Name of the partner agent.
+        max_responses (int): Budget of generated responses.
+        is_completed (Callable[[str, t.Any], bool]): Predicate telling whether the
+            message written by an agent signals the end of the conversation.
+
+    Returns:
+        TurnLedger: The state of the conversation.
+
+    Raises:
+        TurnLedgerCorruptError: If a line of the log cannot be parsed.
+        TurnLedgerDesyncError: If the checkpoint disagrees with the log.
+    """
+    records = read_log(working_dir)
+    ledger = build_ledger(
+        records,
+        seeder_name=seeder_name,
+        partner_name=partner_name,
+        max_responses=max_responses,
+        is_completed=is_completed,
+    )
+    return verify_sidecar(working_dir, ledger)
