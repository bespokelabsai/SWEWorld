        "candidates": [
         "page|meetings/weekly-notes-week-of-mar-17.md",
         "page|meetings/weekly-sync-notes-week-of-jun-9-bulk-llm-inference.md|comment|nils",
         "page|meetings/weekly-notes-week-of-may-5.md|comment|nils",
