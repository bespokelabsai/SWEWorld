          "nikolai"
         ],
         "title": "run metadata json is only written when run() returns",
         "prompted_by": "Konrad ctrl-Cs a long examples run partway through, then finds the run's metadata json still reporting the count from before the kill, and cannot tell from it what actually completed"
        },
        "candidates": [
         "mail|<178770618788.2366822.12798610007507427138@world.local>",
         "mail|<178768820891.2117809.13663081213502681161@world.local>",
