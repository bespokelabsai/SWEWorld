@@ -0,0 +1,435 @@
+"""The durable record of a multi-turn agent conversation."""
+
+import dataclasses
+import datetime
+import json
+import os
+import typing as t
+from dataclasses import dataclass
+
+from bespokelabs.curator.agent.agent_response import AgentResponse
+from bespokelabs.curator.types.generic_request import GenericRequest
+
+RESPONSES_FILENAME: str = "responses_0.jsonl"
+TURN_LEDGER_FILENAME: str = "turn_ledger.json"
+TURN_LEDGER_VERSION: int = 2
+SEED_FINISH_REASON: str = "seed"
+COMPLETION_SENTINEL: str = "<<END_OF_CONVERSATION>>"
+COMPLETION_REASONS: tuple[str, ...] = ("open", "budget", "agent_signal")
+LEDGER_STATUSES: tuple[str, ...] = ("created", "adopted", "verified")
+
+
+class TurnLedgerError(RuntimeError):
+    """Base class for every turn ledger failure."""
+
+
+class TurnLedgerCorruptError(TurnLedgerError):
+    """Raised when a line of the response log cannot be read back.
+
+    Attributes:
+        path (str): Path of the response log that could not be read.
+        line_number (int): 1-based number of the offending physical line.
+        reason (str): Why the line could not be read.
+    """
+
+    def __init__(self, path: str, line_number: int, reason: str):
+        """Initialize a TurnLedgerCorruptError.
+
+        Args:
+            path (str): Path of the response log that could not be read.
+            line_number (int): 1-based number of the offending physical line.
+            reason (str): Why the line could not be read.
+        """
+        super().__init__(f"{path} line {line_number} {reason}")
+        self.path = path
+        self.line_number = line_number
+        self.reason = reason
+
+
+class TurnLedgerDesyncError(TurnLedgerError):
+    """Raised when a current-version checkpoint disagrees with the response log.
+
+    Attributes:
+        path (str): Path of the checkpoint that disagrees with the log.
+        recorded_responses (int): Response count held by the checkpoint.
+        recorded_last_author (Optional[str]): Last author held by the checkpoint.
+        log_responses (int): Response count rebuilt from the log.
+        log_last_author (Optional[str]): Last author rebuilt from the log.
+    """
+
+    def __init__(
+        self,
+        path: str,
+        recorded_responses: t.Any,
+        recorded_last_author: t.Any,
+        log_responses: int,
+        log_last_author: t.Optional[str],
+    ):
+        """Initialize a TurnLedgerDesyncError.
+
+        Args:
+            path (str): Path of the checkpoint that disagrees with the log.
+            recorded_responses (Any): Response count held by the checkpoint.
+            recorded_last_author (Any): Last author held by the checkpoint.
+            log_responses (int): Response count rebuilt from the log.
+            log_last_author (Optional[str]): Last author rebuilt from the log.
+        """
+        super().__init__(
+            f"{path} records {recorded_responses} response(s) last authored by {recorded_last_author!r}, "
+            f"the log holds {log_responses} last authored by {log_last_author!r}"
+        )
+        self.path = path
+        self.recorded_responses = recorded_responses
+        self.recorded_last_author = recorded_last_author
+        self.log_responses = log_responses
+        self.log_last_author = log_last_author
+
+
+@dataclass(frozen=True)
+class TurnEntry:
+    """A single line of the response log.
+
+    Attributes:
+        turn (int): 0-based index of the line in the log, the seed being 0.
+        author (str): Name of the agent the line was written under.
+        content (str): Textual content of the response message.
+        source (str): "seed" for the seed turn, "response" for a generated one.
+    """
+
+    turn: int
+    author: str
+    content: str
+    source: str
+
+
+@dataclass(frozen=True)
+class TurnLedger:
+    """The state of a conversation, derived from its response log.
+
+    Attributes:
+        entries (tuple[TurnEntry, ...]): The turns held by the log, in log order.
+        seeder_name (str): Name of the seeder agent.
+        partner_name (str): Name of the partner agent.
+        max_responses (int): Budget of generated responses, the seed excluded.
+        responses (int): Number of generated responses in the log.
+        turns (int): Number of lines in the log, the seed included.
+        next_speaker (Optional[str]): Agent that speaks next, None once completed.
+        last_author (Optional[str]): Agent that wrote the last line.
+        interleave_faults (int): Places where the log doubles back on an author.
+        completed (bool): Whether the conversation is finished.
+        completion_reason (str): One of COMPLETION_REASONS.
+        status (str): One of LEDGER_STATUSES.
+    """
+
+    entries: tuple[TurnEntry, ...]
+    seeder_name: str
+    partner_name: str
+    max_responses: int
+    responses: int
+    turns: int
+    next_speaker: t.Optional[str]
+    last_author: t.Optional[str]
+    interleave_faults: int
+    completed: bool
+    completion_reason: str
+    status: str
+
+    def messages(self) -> list[dict[str, str]]:
+        """Return the conversation as role/content messages, in log order.
+
+        Returns:
+            list[dict[str, str]]: One message per turn, keyed by agent name.
+        """
+        return [{"role": entry.author, "content": entry.content} for entry in self.entries]
+
+    def sidecar_state(self) -> dict[str, t.Any]:
+        """Return the checkpoint record describing this ledger.
+
+        Returns:
+            dict[str, Any]: The record written to the turn ledger checkpoint.
+        """
+        return {
+            "version": TURN_LEDGER_VERSION,
+            "responses": self.responses,
+            "turns": self.turns,
+            "last_author": self.last_author,
+            "next_speaker": self.next_speaker,
+            "interleave_faults": self.interleave_faults,
+            "completed": self.completed,
+            "completion_reason": self.completion_reason,
+        }
+
+
+def build_seed_record(*, seeder_name: str, seed_message: str, model_name: str, now: datetime.datetime) -> AgentResponse:
+    """Build the log line standing for the seed message.
+
+    Args:
+        seeder_name (str): Name of the agent the seed is written under.
+        seed_message (str): The message that starts the conversation.
+        model_name (str): Model name of the seeder agent.
+        now (datetime.datetime): Timestamp stamped on the record.
+
+    Returns:
+        AgentResponse: The seed turn, ready to be appended to the log.
+    """
+    generic_request = GenericRequest(
+        model=model_name,
+        messages=[{"role": "user", "content": seed_message}],
+        original_row={"prompt": seed_message},
+        original_row_idx=0,
+        response_format=None,
+        generation_params={},
+        is_multimodal_prompt=False,
+    )
+    return AgentResponse.model_validate(
+        {
+            "name": seeder_name,
+            "response_message": seed_message,
+            "parsed_response_message": None,
+            "response_errors": None,
+            "raw_response": None,
+            "raw_request": None,
+            "generic_request": generic_request,
+            "created_at": now,
+            "finished_at": now,
+            "token_usage": None,
+            "response_cost": 0.0,
+            "finish_reason": SEED_FINISH_REASON,
+        }
+    )
+
+
+def response_log_path(working_dir: str) -> str:
+    """Return the absolute path of the response log of a working directory.
+
+    Args:
+        working_dir (str): Directory holding the conversation.
+
+    Returns:
+        str: Absolute path of the response log.
+    """
+    return os.path.abspath(os.path.join(working_dir, RESPONSES_FILENAME))
+
+
+def sidecar_path(working_dir: str) -> str:
+    """Return the absolute path of the turn ledger checkpoint of a working directory.
+
+    Args:
+        working_dir (str): Directory holding the conversation.
+
+    Returns:
+        str: Absolute path of the turn ledger checkpoint.
+    """
+    return os.path.abspath(os.path.join(working_dir, TURN_LEDGER_FILENAME))
+
+
+def read_log(working_dir: str) -> list[AgentResponse]:
+    """Read every response held by the log of a working directory.
+
+    Blank lines are skipped, everything else has to parse.
+
+    Args:
+        working_dir (str): Directory holding the conversation.
+
+    Returns:
+        list[AgentResponse]: The records held by the log, in log order.
+
+    Raises:
+        TurnLedgerCorruptError: If a non-blank line cannot be parsed.
+    """
+    path = response_log_path(working_dir)
+    if not os.path.exists(path):
+        return []
+
+    records = []
+    with open(path, "r") as f:
+        for line_number, line in enumerate(f, start=1):
+            if not line.strip():
+                continue
+            try:
+                records.append(AgentResponse.model_validate_json(line))
+            except ValueError as e:
+                raise TurnLedgerCorruptError(path, line_number, "could not be parsed as an agent response") from e
+    return records
+
+
+def build_ledger(
+    records: t.Sequence[AgentResponse],
+    *,
+    seeder_name: str,
+    partner_name: str,
+    max_responses: int,
+    is_completed: t.Callable[[str, t.Any], bool],
+    status: str = "verified",
+) -> TurnLedger:
+    """Derive the state of a conversation from its records.
+
+    Args:
+        records (Sequence[AgentResponse]): The records held by the log, in log order.
+        seeder_name (str): Name of the seeder agent.
+        partner_name (str): Name of the partner agent.
+        max_responses (int): Budget of generated responses, the seed excluded.
+        is_completed (Callable[[str, Any], bool]): Tells whether the content an
+            agent wrote signals the end of the conversation.
+        status (str): The status the ledger is built with.
+
+    Returns:
+        TurnLedger: The state the records add up to.
+    """
+    entries = tuple(
+        TurnEntry(
+            turn=index,
+            author=record.name,
+            content=record.response_message if isinstance(record.response_message, str) else str(record.response_message),
+            source="seed" if index == 0 else "response",
+        )
+        for index, record in enumerate(records)
+    )
+
+    turns = len(entries)
+    responses = max(turns - 1, 0)
+    last_author = entries[-1].author if entries else None
+    interleave_faults = sum(1 for i in range(1, turns) if entries[i].author == entries[i - 1].author)
+
+    if not entries:
+        completion_reason = "open"
+    elif is_completed(entries[-1].author, entries[-1].content):
+        completion_reason = "agent_signal"
+    elif responses >= max_responses:
+        completion_reason = "budget"
+    else:
+        completion_reason = "open"
+
+    completed = completion_reason != "open"
+    if entries and not completed:
+        next_speaker = partner_name if last_author == seeder_name else seeder_name
+    else:
+        next_speaker = None
+
+    return TurnLedger(
+        entries=entries,
+        seeder_name=seeder_name,
+        partner_name=partner_name,
+        max_responses=max_responses,
+        responses=responses,
+        turns=turns,
+        next_speaker=next_speaker,
+        last_author=last_author,
+        interleave_faults=interleave_faults,
+        completed=completed,
+        completion_reason=completion_reason,
+        status=status,
+    )
+
+
+def read_sidecar(working_dir: str) -> t.Optional[dict]:
+    """Read the turn ledger checkpoint of a working directory.
+
+    A missing or unreadable checkpoint is not an error, it is simply nothing to
+    go on.
+
+    Args:
+        working_dir (str): Directory holding the conversation.
+
+    Returns:
+        Optional[dict]: The recorded state, or None if there is none to read.
+    """
+    path = sidecar_path(working_dir)
+    if not os.path.exists(path):
+        return None
+    try:
+        with open(path, "r") as f:
+            record = json.load(f)
+    except (OSError, ValueError):
+        return None
+    return record if isinstance(record, dict) else None
+
+
+def write_sidecar(working_dir: str, ledger: TurnLedger) -> str:
+    """Write the state of a ledger to the turn ledger checkpoint.
+
+    Args:
+        working_dir (str): Directory holding the conversation.
+        ledger (TurnLedger): The ledger whose state is recorded.
+
+    Returns:
+        str: Absolute path of the checkpoint that was written.
+    """
+    path = sidecar_path(working_dir)
+    with open(path, "w") as f:
+        f.write(json.dumps(ledger.sidecar_state(), sort_keys=True, indent=2) + "\n")
+    return path
+
+
+def verify_sidecar(working_dir: str, ledger: TurnLedger) -> TurnLedger:
+    """Check a rebuilt ledger against the turn ledger checkpoint.
+
+    A checkpoint that is missing, unreadable or older than the current version
+    is stale rather than wrong, and the log is adopted as it stands. A
+    current-version checkpoint is compared on its response count and its last
+    author, nothing else. Nothing is written.
+
+    Args:
+        working_dir (str): Directory holding the conversation.
+        ledger (TurnLedger): The ledger rebuilt from the log.
+
+    Returns:
+        TurnLedger: The ledger, adopted or verified.
+
+    Raises:
+        TurnLedgerDesyncError: If a current-version checkpoint disagrees with the log.
+    """
+    record = read_sidecar(working_dir)
+    if record is None or record.get("version") != TURN_LEDGER_VERSION:
+        return dataclasses.replace(ledger, status="adopted")
+
+    recorded_responses = record.get("responses")
+    recorded_last_author = record.get("last_author")
+    if recorded_responses != ledger.responses or recorded_last_author != ledger.last_author:
+        raise TurnLedgerDesyncError(
+            sidecar_path(working_dir),
+            recorded_responses,
+            recorded_last_author,
+            ledger.responses,
+            ledger.last_author,
+        )
+    return dataclasses.replace(ledger, status="verified")
+
+
+def load_ledger(
+    working_dir: str,
+    *,
+    seeder_name: str,
+    partner_name: str,
+    max_responses: int,
+    is_completed: t.Callable[[str, t.Any], bool],
+) -> TurnLedger:
+    """Load the ledger of a working directory, without writing anything.
+
+    Args:
+        working_dir (str): Directory holding the conversation.
+        seeder_name (str): Name of the seeder agent.
+        partner_name (str): Name of the partner agent.
+        max_responses (int): Budget of generated responses, the seed excluded.
+        is_completed (Callable[[str, Any], bool]): Tells whether the content an
+            agent wrote signals the end of the conversation.
+
+    Returns:
+        TurnLedger: The state of the conversation on disk.
+
+    Raises:
+        TurnLedgerCorruptError: If a non-blank line of the log cannot be parsed.
+        TurnLedgerDesyncError: If a current-version checkpoint disagrees with the log.
+    """
+    records = read_log(working_dir)
+    ledger = build_ledger(
+        records,
+        seeder_name=seeder_name,
+        partner_name=partner_name,
+        max_responses=max_responses,
+        is_completed=is_completed,
+        status="created",
+    )
+    if not records:
+        return ledger
+    return verify_sidecar(working_dir, ledger)
