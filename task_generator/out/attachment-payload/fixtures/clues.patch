+# Description: Provider independent description of a single multimodal attachment.
+import hashlib
+import os
+import typing as t
+
+from pydantic import BaseModel, ConfigDict, Field
+
+from bespokelabs.curator.log import logger
+
+# The name used for a block whose attachment has no usable basename.
+_FALLBACK_ATTACHMENT_FILENAME: str = "attachment.bin"
+
+# Longest display name carried on a block. Longer names are shortened, a name
+# that is exactly this long is left alone.
+_MAX_ATTACHMENT_FILENAME_LEN: int = 64
+
+# Image details we forward as-is. Index 0 is the fallback for everything else.
+_SUPPORTED_IMAGE_DETAILS: t.Tuple[str, ...] = ("auto", "low", "high")
+
+# Number of hex characters kept from the payload digest.
+_ATTACHMENT_FINGERPRINT_HEX_LEN: int = 12
+
+# Per-kind ceilings, in MB, for the base64 payload we actually put on the wire.
+_ATTACHMENT_SIZE_LIMIT_MB: t.Dict[str, float] = {"image": 20.0, "document": 24.0}
+
+# Ceiling, in MB, for the base64 payloads of a single prompt summed together.
+_PROMPT_ATTACHMENT_SIZE_LIMIT_MB: float = 45.0
+
+# Most attachments a single prompt may carry. Texts do not count toward it.
+_ATTACHMENT_COUNT_LIMIT: int = 12
+
+
+class AttachmentError(ValueError):
+    """Base class for every attachment rejection."""
+
+
+class UnknownAttachmentMimeType(AttachmentError):  # noqa: N818
+    """Raised when the MIME type of an attachment cannot be determined."""
+
+    def __init__(self, url: str, attachment_type: str):
+        """Initialize the UnknownAttachmentMimeType."""
+        self.url = url
+        self.attachment_type = attachment_type
+        super().__init__(f"Cannot determine MIME type for {attachment_type} attachment: {url!r}")
+
+
+class MissingLocalAttachment(AttachmentError):  # noqa: N818
+    """Raised when a non-remote url does not point at an existing file."""
+
+    def __init__(self, url: str):
+        """Initialize the MissingLocalAttachment."""
+        self.url = url
+        super().__init__(f"Attachment path is neither an http(s) URL nor an existing file: {url!r}")
+
+
+class EmptyAttachment(AttachmentError):  # noqa: N818
+    """Raised when an attachment serializes to an empty payload."""
+
+    def __init__(self, url: str, filename: str):
+        """Initialize the EmptyAttachment."""
+        self.url = url
+        self.filename = filename
+        super().__init__(f"Attachment {filename} has an empty payload: {url!r}")
+
+
+class AttachmentTooLarge(AttachmentError):  # noqa: N818
+    """Raised when a base64 payload is over the ceiling for its kind."""
+
+    def __init__(self, kind: str, size_mb: float, limit_mb: float):
+        """Initialize the AttachmentTooLarge."""
+        self.kind = kind
+        self.size_mb = size_mb
+        self.limit_mb = limit_mb
+        super().__init__(f"{kind} attachment is {size_mb:.1f} MB, over the {limit_mb:.1f} MB limit.")
+
+
+class TooManyAttachments(AttachmentError):  # noqa: N818
+    """Raised when a prompt carries more attachments than we allow."""
+
+    def __init__(self, count: int, limit: int):
+        """Initialize the TooManyAttachments."""
+        self.count = count
+        self.limit = limit
+        super().__init__(f"Prompt has {count} attachments, over the limit of {limit}.")
+
+
+def normalize_mime_type(value: str | None) -> str | None:
+    """Normalize a MIME type to lowercase with any `;` parameters dropped.
+
+    Args:
+        value: The MIME type to normalize, if any.
+
+    Returns:
+        str | None: The normalized MIME type, or None when there is nothing to normalize.
+    """
+    if not value:
+        return None
+    return value.split(";", 1)[0].strip().lower() or None
+
+
+def normalize_detail(value: str | None) -> str:
+    """Normalize an image detail against the details we support.
+
+    Anything that is not one of `_SUPPORTED_IMAGE_DETAILS` falls back to the
+    first of them and is logged once. Nothing set at all logs nothing.
+
+    Args:
+        value: The detail the caller asked for, if any.
+
+    Returns:
+        str: A supported detail.
+    """
+    fallback = _SUPPORTED_IMAGE_DETAILS[0]
+    if value is None:
+        return fallback
+
+    detail = value.strip().lower()
+    if detail in _SUPPORTED_IMAGE_DETAILS:
+        return detail
+
+    logger.warning(f"Unsupported image detail {value!r}, falling back to {fallback!r}.")
+    return fallback
+
+
+def attachment_fingerprint(payload: str) -> str:
+    """Digest a payload so two blocks carrying the same bytes compare equal.
+
+    Remote attachments are never opened, so for those the payload is the url
+    string exactly as we send it, query and anchor included.
+
+    Args:
+        payload: The payload stored on the block.
+
+    Returns:
+        str: The digest, prefixed with the algorithm that produced it.
+    """
+    digest = hashlib.sha256(payload.encode("utf-8")).hexdigest()
+    return f"sha256:{digest[:_ATTACHMENT_FINGERPRINT_HEX_LEN]}"
+
+
+def shorten_attachment_filename(filename: str) -> str:
+    """Shorten a derived display name, keeping any suffix on the end.
+
+    Only the name we derive is shortened; the payload url and the caller's
+    attachment are left untouched.
+
+    Args:
+        filename: The name derived from the attachment.
+
+    Returns:
+        str: A name no longer than `_MAX_ATTACHMENT_FILENAME_LEN`.
+    """
+    if len(filename) <= _MAX_ATTACHMENT_FILENAME_LEN:
+        return filename
+
+    stem, suffix = os.path.splitext(filename)
+    if suffix and len(suffix) < _MAX_ATTACHMENT_FILENAME_LEN:
+        return stem[: _MAX_ATTACHMENT_FILENAME_LEN - len(suffix)] + suffix
+    return filename[:_MAX_ATTACHMENT_FILENAME_LEN]
+
+
+class AttachmentBlock(BaseModel):
+    """A provider independent description of one attachment.
+
+    Every provider renders its own wire format from this block, so nothing
+    below it needs to know which class the attachment came in as.
+    """
+
+    model_config = ConfigDict(frozen=True)
+
+    kind: t.Literal["image", "document"] = Field(..., description="What the attachment is, decided by its MIME type.")
+    source: t.Literal["url", "base64"] = Field(..., description="Where the payload came from.")
+    mime_type: str = Field(..., description="The MIME type of the attachment, lowercase and without parameters.")
+    payload: str = Field(..., description="The URL for a url source, otherwise the base64 text.")
+    filename: str = Field(..., description="The display name of the attachment.")
+    fingerprint: str = Field(..., description="A short digest of the payload.")
+    detail: str | None = Field(None, description="The image detail, None for a document.")
+    size_mb: float | None = Field(None, description="Size of the base64 payload in MB, None for a url source.")
