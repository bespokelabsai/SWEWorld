+def _resolve_mime_type(mime_type: str | None, url: str) -> str | None:
+    """Resolve the MIME type of an attachment, guessing from the url when needed.
+
+    Args:
+        mime_type: The MIME type the caller supplied, if any.
+        url: The url of the attachment, if any.
+
+    Returns:
+        str | None: The normalized MIME type, or None when it cannot be determined.
