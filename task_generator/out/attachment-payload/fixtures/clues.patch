+    normalized = normalize_mime_type(mime_type)
+    if normalized is not None or not url:
+        return normalized
+
+    # Query and fragment are not part of the name we guess from.
+    guessed, _ = mimetypes.guess_type(url.split("?", 1)[0].split("#", 1)[0])
+    if not guessed:
+        logger.warning(f"Failed to guess MIME type for {url}.")
+        return None
+    return normalize_mime_type(guessed)
+
 
