+def _attachment_filename(url: str) -> str:
+    """Derive the file name of an attachment from its URL.
+
+    Args:
+        url: The attachment URL, possibly carrying a query string.
+
+    Returns:
+        The basename of the URL, capped in length, or a fallback name.
+    """
+    name = os.path.basename(url.split("?", 1)[0])
+    if not name:
+        return _FALLBACK_ATTACHMENT_FILENAME
+    if len(name) <= _MAX_ATTACHMENT_FILENAME_LEN:
+        return name
+    extension = os.path.splitext(name)[1]
+    if len(extension) >= _MAX_ATTACHMENT_FILENAME_LEN:
+        return name[:_MAX_ATTACHMENT_FILENAME_LEN]
+    return name[: _MAX_ATTACHMENT_FILENAME_LEN - len(extension)] + extension
+
+
