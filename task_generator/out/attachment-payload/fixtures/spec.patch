+def _resolve_mime_type(value: str | None, url: str) -> str | None:
+    """Apply the shared MIME policy to a supplied or guessed MIME type.
+
+    Args:
+        value: The MIME type supplied by the caller, if any.
+        url: The attachment URL, used to guess the MIME type.
+
+    Returns:
+        The normalized MIME type, or None when it cannot be determined.
+    """
+    mime_type = normalize_mime_type(value)
+    if mime_type is not None:
+        return mime_type
+    if not url:
+        return None
+    guessed, _ = mimetypes.guess_type(url.split("?", 1)[0].split("#", 1)[0])
+    if not guessed:
+        logger.warning(f"Failed to guess MIME type for {url}.")
+        return None
+    return normalize_mime_type(guessed)
+
 
