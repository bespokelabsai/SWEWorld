+# Description: Provider-independent description of a multimodal attachment.
+import hashlib
+import typing as t
+
+from pydantic import BaseModel, ConfigDict, Field
+
+from bespokelabs.curator.log import logger
+
+_FALLBACK_ATTACHMENT_FILENAME: str = "attachment.bin"
+_MAX_ATTACHMENT_FILENAME_LEN: int = 64
+_ATTACHMENT_FINGERPRINT_HEX_LEN: int = 12
+_ATTACHMENT_COUNT_LIMIT: int = 12
+_SUPPORTED_IMAGE_DETAILS: t.Tuple[str, ...] = ("auto", "low", "high")
+
+# Per-kind ceilings (MB) on base64 attachment payloads, and the whole-prompt ceiling.
+_ATTACHMENT_SIZE_LIMITS_MB: t.Dict[str, float] = {"image": 20.0, "document": 24.0}
+_PROMPT_ATTACHMENT_SIZE_LIMIT_MB: float = 45.0
+
+
+class AttachmentBlock(BaseModel):
+    """A provider-independent description of one attachment.
+
+    Providers render their own wire format from this block and never look at the
+    attachment object it was built from.
+    """
+
+    model_config = ConfigDict(frozen=True)
+
+    kind: t.Literal["image", "document"] = Field(..., description="Whether the attachment is an image or a document.")
+    source: t.Literal["url", "base64"] = Field(..., description="Where the payload comes from.")
+    mime_type: str = Field(..., description="The normalized MIME type of the attachment.")
+    payload: str = Field(..., description="The URL when source is 'url', otherwise the base64 text.")
+    filename: str = Field(..., description="The file name derived from the attachment URL.")
+    fingerprint: str = Field(..., description="A short sha256 fingerprint of the payload.")
+    detail: str | None = Field(None, description="The image detail level, None for documents.")
+    size_mb: float | None = Field(None, description="The measured payload size in MB, None for url attachments.")
+
+
+class AttachmentError(ValueError):
+    """Base class for every attachment rejection."""
+
+
+class UnknownAttachmentMimeType(AttachmentError):  # noqa: N818
+    """Raised when the MIME type of an attachment cannot be determined."""
+
+    def __init__(self, url: str, attachment_type: str):
+        """Initialize the UnknownAttachmentMimeType error."""
+        self.url = url
+        self.attachment_type = attachment_type
+        super().__init__(f"Cannot determine MIME type for {attachment_type} attachment: {url!r}")
+
+
+class MissingLocalAttachment(AttachmentError):  # noqa: N818
+    """Raised when a non-remote attachment URL does not point at an existing file."""
+
+    def __init__(self, url: str):
+        """Initialize the MissingLocalAttachment error."""
+        self.url = url
+        super().__init__(f"Attachment path is neither an http(s) URL nor an existing file: {url!r}")
+
+
+class EmptyAttachment(AttachmentError):  # noqa: N818
+    """Raised when an attachment serializes to an empty payload."""
+
+    def __init__(self, url: str, filename: str):
+        """Initialize the EmptyAttachment error."""
+        self.url = url
+        self.filename = filename
+        super().__init__(f"Attachment {filename} has an empty payload: {url!r}")
+
+
+class AttachmentTooLarge(AttachmentError):  # noqa: N818
+    """Raised when a base64 payload is over the ceiling for its kind."""
+
+    def __init__(self, kind: str, size_mb: float, limit_mb: float):
+        """Initialize the AttachmentTooLarge error."""
+        self.kind = kind
+        self.size_mb = size_mb
+        self.limit_mb = limit_mb
+        super().__init__(f"{kind} attachment is {size_mb} MB, over the {limit_mb} MB limit.")
+
+
+class TooManyAttachments(AttachmentError):  # noqa: N818
+    """Raised when a single message carries more attachments than allowed."""
+
+    def __init__(self, count: int, limit: int):
+        """Initialize the TooManyAttachments error."""
+        self.count = count
+        self.limit = limit
+        super().__init__(f"Prompt has {count} attachments, over the limit of {limit}.")
+
+
+def normalize_mime_type(value: str | None) -> str | None:
+    """Lowercase a MIME type and drop its parameters.
+
+    Args:
+        value: The MIME type to normalize, possibly with `;`-parameters.
+
+    Returns:
+        The normalized MIME type, or None when there is nothing to normalize.
+    """
+    if not value:
+        return None
+    return value.split(";", 1)[0].strip().lower() or None
+
+
+def normalize_detail(value: str | None) -> str:
+    """Normalize an image detail level against the supported vocabulary.
+
+    Args:
+        value: The detail level written by the caller.
+
+    Returns:
+        The normalized detail level, falling back to "auto" for unsupported values.
+    """
+    if value is None:
+        return "auto"
+    detail = str(value).strip().lower()
+    if detail in _SUPPORTED_IMAGE_DETAILS:
+        return detail
+    logger.warning(f"Unsupported image detail {value!r}, falling back to 'auto'.")
+    return "auto"
+
+
+def attachment_fingerprint(payload: str) -> str:
+    """Fingerprint an attachment payload.
+
+    Args:
+        payload: The URL or base64 text carried by the block.
+
+    Returns:
+        A short sha256 fingerprint of the payload string.
+    """
+    return "sha256:" + hashlib.sha256(payload.encode("utf-8")).hexdigest()[:_ATTACHMENT_FINGERPRINT_HEX_LEN]
