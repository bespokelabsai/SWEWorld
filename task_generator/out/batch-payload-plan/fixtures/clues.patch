diff --git a/src/bespokelabs/curator/request_processor/batch_payload_planner.py b/src/bespokelabs/curator/request_processor/batch_payload_planner.py
new file mode 100644
index 0000000..1ea92c9
--- /dev/null
+++ b/src/bespokelabs/curator/request_processor/batch_payload_planner.py
@@ -0,0 +1,197 @@
+"""Pure planning of batch payloads.
+
+Splits an ordered sequence of request payload sizes into contiguous batches that
+each fit inside the request count and byte limits a provider imposes on a single
+batch file. Nothing in here touches the network, the filesystem or a dataset, so
+the planning decisions can be exercised on their own.
+"""
+
+import json
+from dataclasses import dataclass
+from typing import Optional, Sequence
+
+
+@dataclass(frozen=True)
+class BatchLimits:
+    """Provider limits that a single batch payload has to fit inside.
+
+    Attributes:
+        max_requests_per_batch: Maximum number of requests allowed in one batch.
+        max_bytes_per_batch: Maximum size in bytes of the uploaded batch file.
+    """
+
+    max_requests_per_batch: int
+    max_bytes_per_batch: int
+
+
+@dataclass(frozen=True)
+class PlannedBatch:
+    """A contiguous span of requests that fits inside the batch limits.
+
+    Attributes:
+        index: Position of this batch in the plan, counting from zero.
+        start_idx: Index of the first request in the batch, inclusive.
+        end_idx: Index one past the last request in the batch, exclusive.
+        num_requests: Number of requests in the batch.
+        num_bytes: Size in bytes of the batch file these requests produce.
+    """
+
+    index: int
+    start_idx: int
+    end_idx: int
+    num_requests: int
+    num_bytes: int
+
+
+class BatchPayloadTooLargeError(ValueError):
+    """Raised when a batch payload is larger than the provider allows.
+
+    Attributes:
+        num_requests: Number of requests in the offending payload.
+        size_bytes: Size in bytes of the offending payload.
+        limit_bytes: Maximum size in bytes the provider allows for one batch.
+    """
+
+    def __init__(self, *, num_requests: int, size_bytes: int, limit_bytes: int, message: Optional[str] = None) -> None:
+        """Initialize the error.
+
+        Args:
+            num_requests: Number of requests in the offending payload.
+            size_bytes: Size in bytes of the offending payload.
+            limit_bytes: Maximum size in bytes the provider allows for one batch.
+            message: Optional message overriding the default byte-based one.
+        """
+        self.num_requests = num_requests
+        self.size_bytes = size_bytes
+        self.limit_bytes = limit_bytes
+        if message is None:
+            message = (
+                f"Batch payload of {num_requests:,} requests is {size_bytes:,} bytes, "
+                f"which is greater than the maximum of {limit_bytes:,} bytes per batch. "
+                f"Please reduce your batch size or request content size (via prompt_func and response_format)."
+            )
+        super().__init__(message)
+
+
+class SingleRequestTooLargeError(BatchPayloadTooLargeError):
+    """Raised when a single request is larger than a whole batch is allowed to be.
+
+    Such a request cannot be placed in any batch, so no plan can be produced at all.
+
+    Attributes:
+        row_idx: Index of the dataset row that does not fit.
+        num_requests: Always one, the offending request is on its own.
+        size_bytes: Size in bytes of the offending request.
+        limit_bytes: Maximum size in bytes the provider allows for one batch.
+    """
+
+    def __init__(self, *, row_idx: int, size_bytes: int, limit_bytes: int) -> None:
+        """Initialize the error.
+
+        Args:
+            row_idx: Index of the dataset row that does not fit.
+            size_bytes: Size in bytes of the offending request.
+            limit_bytes: Maximum size in bytes the provider allows for one batch.
+        """
+        super().__init__(
+            num_requests=1,
+            size_bytes=size_bytes,
+            limit_bytes=limit_bytes,
+            message=(
+                f"Request at row {row_idx:,} is {size_bytes:,} bytes on its own, "
+                f"which is greater than the maximum of {limit_bytes:,} bytes per batch. "
+                f"There is no batch it can be placed in. "
+                f"Please reduce the request content size (via prompt_func and response_format)."
+            ),
+        )
+        self.row_idx = row_idx
+
+
+def payload_size_bytes(api_specific_request: dict) -> int:
+    """Measure the size in bytes a single request contributes to a batch file.
+
+    Args:
+        api_specific_request: API-specific request dictionary.
+
+    Returns:
+        int: Number of bytes the serialized request occupies.
+    """
+    return len(json.dumps(api_specific_request).encode())
+
+
+def payload_bytes(sizes: Sequence[int]) -> int:
+    """Measure the size in bytes of the batch file the given requests produce.
+
+    The requests are joined by newlines, so every request after the first adds a
+    separator byte on top of its own size.
+
+    Args:
+        sizes: Sizes in bytes of the requests making up the batch file.
+
+    Returns:
+        int: Size in bytes of the batch file, zero if there are no requests.
+    """
+    if not sizes:
+        return 0
+    return sum(sizes) + len(sizes) - 1
+
+
+def plan_batches(sizes: Sequence[int], limits: BatchLimits) -> list[PlannedBatch]:
+    """Split requests into contiguous batches that fit inside the given limits.
+
+    Walks the sizes once in index order and greedily fills a batch until adding
+    the next request would take it past either limit. A batch landing exactly on
+    a limit is kept, only going over it starts a new batch. The returned spans
+    are ordered, contiguous and cover every request.
+
+    Args:
+        sizes: Sizes in bytes of the requests, in dataset order.
+        limits: Provider limits a single batch payload has to fit inside.
+
+    Returns:
+        list[PlannedBatch]: The planned batches, empty if there are no requests.
+
+    Raises:
+        SingleRequestTooLargeError: If a request on its own is larger than a batch may be.
+    """
+    for row_idx, size in enumerate(sizes):
+        if size > limits.max_bytes_per_batch:
+            raise SingleRequestTooLargeError(row_idx=row_idx, size_bytes=size, limit_bytes=limits.max_bytes_per_batch)
+
+    plan: list[PlannedBatch] = []
+    start_idx = 0
+    num_requests = 0
+    num_bytes = 0
+
+    for idx, size in enumerate(sizes):
+        # Every request but the first is preceded by a newline separator.
+        with_request = num_bytes + size + (1 if num_requests else 0)
+        if num_requests and (num_requests + 1 > limits.max_requests_per_batch or with_request > limits.max_bytes_per_batch):
+            plan.append(
+                PlannedBatch(
+                    index=len(plan),
+                    start_idx=start_idx,
+                    end_idx=idx,
+                    num_requests=num_requests,
+                    num_bytes=num_bytes,
+                )
+            )
+            start_idx = idx
+            num_requests = 0
+            with_request = size
+
+        num_requests += 1
+        num_bytes = with_request
+
+    if num_requests:
+        plan.append(
+            PlannedBatch(
+                index=len(plan),
+                start_idx=start_idx,
+                end_idx=len(sizes),
+                num_requests=num_requests,
+                num_bytes=num_bytes,
+            )
+        )
+
+    return plan
