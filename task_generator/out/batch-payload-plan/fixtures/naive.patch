diff --git a/src/bespokelabs/curator/request_processor/batch_payload_planner.py b/src/bespokelabs/curator/request_processor/batch_payload_planner.py
new file mode 100644
index 0000000..f6d3fd1
--- /dev/null
+++ b/src/bespokelabs/curator/request_processor/batch_payload_planner.py
@@ -0,0 +1,160 @@
+"""Pure planning helpers for splitting requests into API-sized batch payloads.
+
+The planner is intentionally free of any I/O or provider state: it works on the
+serialized size of each request payload so that it can be reasoned about (and
+tested) independently of the request processors that use it.
+"""
+
+import json
+from dataclasses import dataclass
+from typing import Sequence
+
+
+@dataclass(frozen=True)
+class BatchLimits:
+    """API limits a single batch payload must respect.
+
+    Attributes:
+        max_requests_per_batch: Maximum number of requests in one batch.
+        max_bytes_per_batch: Maximum size in bytes of one batch file.
+    """
+
+    max_requests_per_batch: int
+    max_bytes_per_batch: int
+
+
+@dataclass(frozen=True)
+class PlannedBatch:
+    """A contiguous span of requests that fits within the batch limits.
+
+    Attributes:
+        index: Position of this batch in the plan, starting at 0.
+        start_idx: Index of the first request in the span.
+        end_idx: Index just past the last request in the span.
+        num_requests: Number of requests in the span.
+        num_bytes: Size in bytes of the batch file this span produces.
+    """
+
+    index: int
+    start_idx: int
+    end_idx: int
+    num_requests: int
+    num_bytes: int
+
+
+class BatchPayloadTooLargeError(ValueError):
+    """Raised when a batch payload is larger than the API allows."""
+
+    def __init__(self, *, num_requests: int, size_bytes: int, limit_bytes: int) -> None:
+        """Initialize the error.
+
+        Args:
+            num_requests: Number of requests in the oversized payload.
+            size_bytes: Size in bytes of the oversized payload.
+            limit_bytes: Maximum size in bytes allowed by the API.
+        """
+        self.num_requests = num_requests
+        self.size_bytes = size_bytes
+        self.limit_bytes = limit_bytes
+        super().__init__(
+            f"Batch file content size {size_bytes:,} bytes for {num_requests:,} request(s) "
+            f"is greater than the maximum of {limit_bytes:,} bytes per batch. "
+            "Please reduce your batch size or request content size (via prompt_func and response_format)."
+        )
+
+
+class SingleRequestTooLargeError(BatchPayloadTooLargeError):
+    """Raised when a single request cannot fit in a batch on its own."""
+
+    def __init__(self, *, row_idx: int, size_bytes: int, limit_bytes: int) -> None:
+        """Initialize the error.
+
+        Args:
+            row_idx: Index of the request in the dataset.
+            size_bytes: Size in bytes of the request payload.
+            limit_bytes: Maximum size in bytes allowed by the API.
+        """
+        super().__init__(num_requests=1, size_bytes=size_bytes, limit_bytes=limit_bytes)
+        self.row_idx = row_idx
+
+
+def payload_size_bytes(api_specific_request: dict) -> int:
+    """Measure the serialized size of a single API-specific request.
+
+    Args:
+        api_specific_request: API-specific request dictionary.
+
+    Returns:
+        int: Number of bytes the request occupies in a batch file.
+    """
+    return len(json.dumps(api_specific_request).encode())
+
+
+def payload_bytes(sizes: Sequence[int]) -> int:
+    """Compute the exact size of the batch file the given payloads produce.
+
+    The payloads are joined with newlines, so a batch of ``n`` requests costs
+    ``n - 1`` separator bytes on top of the individual payload sizes.
+
+    Args:
+        sizes: Sizes in bytes of the individual request payloads.
+
+    Returns:
+        int: Size in bytes of the resulting batch file, 0 if there are no payloads.
+    """
+    if not sizes:
+        return 0
+    return sum(sizes) + len(sizes) - 1
+
+
+def plan_batches(sizes: Sequence[int], limits: BatchLimits) -> list[PlannedBatch]:
+    """Greedily split request payloads into batches that respect the API limits.
+
+    The sizes are walked once in index order, so the resulting batches are
+    contiguous, ordered and cover every request exactly once.
+
+    Args:
+        sizes: Sizes in bytes of the individual request payloads, in index order.
+        limits: API limits the planned batches must respect.
+
+    Returns:
+        list[PlannedBatch]: The planned batches, empty if there are no payloads.
+
+    Raises:
+        SingleRequestTooLargeError: If one request alone exceeds the byte limit.
+    """
+    plan: list[PlannedBatch] = []
+    start_idx = 0
+    num_requests = 0
+    num_bytes = 0
+
+    def _flush(end_idx: int) -> None:
+        plan.append(
+            PlannedBatch(
+                index=len(plan),
+                start_idx=start_idx,
+                end_idx=end_idx,
+                num_requests=num_requests,
+                num_bytes=num_bytes,
+            )
+        )
+
+    for idx, size in enumerate(sizes):
+        if size > limits.max_bytes_per_batch:
+            raise SingleRequestTooLargeError(row_idx=idx, size_bytes=size, limit_bytes=limits.max_bytes_per_batch)
+
+        separator = 1 if num_requests else 0
+        if num_requests + 1 > limits.max_requests_per_batch or num_bytes + separator + size > limits.max_bytes_per_batch:
+            _flush(idx)
+            start_idx = idx
+            num_requests = 0
+            num_bytes = 0
+            separator = 0
+
+        num_requests += 1
+        num_bytes += separator + size
+
+    if num_requests:
+        _flush(len(sizes))
+
+    return plan
