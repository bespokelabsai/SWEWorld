diff --git a/src/bespokelabs/curator/finetune/encoding.py b/src/bespokelabs/curator/finetune/encoding.py
new file mode 100644
index 0000000..0cf1388
--- /dev/null
+++ b/src/bespokelabs/curator/finetune/encoding.py
@@ -0,0 +1,151 @@
+"""Encoding policy shared by the fine-tuning data formatters.
+
+This module owns the rules that decide whether a chat example can be encoded at
+all: which roles are allowed and in what order, what a tokenizer has to provide,
+and when a conversation is too long to survive the training window. Every error
+raised here derives from :class:`EncodingError`, which is itself a
+:class:`ValueError`, so existing ``except ValueError`` handlers around the
+encoder keep working.
+
+It also defines :class:`EncodingReport`, the per-batch summary the formatters
+publish on ``self.last_report`` after a batch is encoded.
+"""
+
+from dataclasses import dataclass, field
+from typing import Any, List, Sequence, Tuple
+
+#: Roles a training conversation may contain.
+ALLOWED_ROLES: frozenset = frozenset({"system", "user", "assistant"})
+
+#: Minimum number of prompt tokens that must survive the training window in
+#: front of the final supervised span for an example to be usable.
+MIN_RETAINED_PROMPT_TOKENS: int = 16
+
+#: Rough bytes-per-token ratio used to budget Fireworks JSONL lines, which are
+#: measured in UTF-8 bytes rather than tokens (no tokenizer is loaded there).
+FIREWORKS_BYTES_PER_TOKEN: int = 3
+
+
+class EncodingError(ValueError):
+    """Base class for every error raised by the encoding policy."""
+
+
+class InvalidRoleSequenceError(EncodingError):
+    """Raised when the roles of a conversation do not form a trainable sequence."""
+
+    def __init__(self, *, role_sequence: List[str], position: int, reason: str) -> None:
+        """Initialize the error.
+
+        Args:
+            role_sequence: The roles of the conversation, in message order.
+            position: Index of the message that violates the policy.
+            reason: Short machine-readable reason for the violation.
+        """
+        self.role_sequence = role_sequence
+        self.position = position
+        self.reason = reason
+        super().__init__(f"invalid role sequence at position {position} ({reason}): {role_sequence}")
+
+
+class TokenizerCapabilityError(EncodingError):
+    """Raised when a supplied tokenizer cannot drive the chat encoding."""
+
+    def __init__(self, *, missing_method: str) -> None:
+        """Initialize the error.
+
+        Args:
+            missing_method: Name of the tokenizer method that is missing.
+        """
+        self.missing_method = missing_method
+        super().__init__(f"tokenizer is missing required method {missing_method!r}")
+
+
+class ExampleTooLongError(EncodingError):
+    """Raised when the training window leaves too little prompt in front of the answer."""
+
+    def __init__(self, *, token_count: int, max_seq_length: int, retained_prompt_tokens: int, num_messages: int) -> None:
+        """Initialize the error.
+
+        Args:
+            token_count: Length of the untruncated token sequence.
+            max_seq_length: The training window size the example is measured against.
+            retained_prompt_tokens: Prompt tokens surviving in front of the final supervised span.
+            num_messages: Number of messages in the example. Carried for callers, not printed.
+        """
+        self.token_count = token_count
+        self.max_seq_length = max_seq_length
+        self.retained_prompt_tokens = retained_prompt_tokens
+        self.num_messages = num_messages
+        super().__init__(
+            f"example of {token_count} tokens exceeds max_seq_length={max_seq_length}: "
+            f"{retained_prompt_tokens} prompt tokens would survive, minimum is {MIN_RETAINED_PROMPT_TOKENS}"
+        )
+
+
+@dataclass(frozen=True)
+class EncodingReport:
+    """Counts for one encoding pass over a batch.
+
+    A freshly constructed report is empty, so callers never have to null-check
+    ``last_report``. Reports are frozen: a pass builds one and publishes it, it
+    is never mutated afterwards.
+
+    Attributes:
+        kept: Number of examples that made it into the output.
+        dropped: Number of examples dropped for being too long.
+        windowed: Number of kept examples whose token sequence was windowed.
+        dropped_indices: Indices of the dropped examples, numbered against the
+            input list and in input order.
+        supervised_tokens: Total supervised tokens, summed over kept examples only.
+    """
+
+    kept: int = 0
+    dropped: int = 0
+    windowed: int = 0
+    dropped_indices: Tuple[int, ...] = field(default_factory=tuple)
+    supervised_tokens: int = 0
+
+
+def _role_of(message: Any) -> Any:
+    """Read the role off a ChatMessage-like object or a message dict."""
+    if isinstance(message, dict):
+        return message.get("role")
+    return getattr(message, "role", None)
+
+
+def validate_role_sequence(messages: Sequence[Any]) -> None:
+    """Validate the role sequence of a chat example.
+
+    Accepts ``ChatMessage``-like objects (with a ``role`` attribute) or message
+    dicts (with a ``"role"`` key). A valid sequence is a single optional leading
+    ``system`` message followed by strictly alternating ``user``/``assistant``
+    turns, ending on ``assistant``.
+
+    Args:
+        messages: The messages of the example, in order.
+
+    Raises:
+        InvalidRoleSequenceError: If the sequence violates the policy. The first
+            violation, in the order the rules are documented here, is the one raised.
+    """
+    roles = [_role_of(message) for message in messages]
+
+    if not roles:
+        raise InvalidRoleSequenceError(role_sequence=roles, position=0, reason="empty")
+
+    for index, role in enumerate(roles):
+        if role not in ALLOWED_ROLES:
+            raise InvalidRoleSequenceError(role_sequence=roles, position=index, reason="unknown_role")
+
+    for index, role in enumerate(roles):
+        if role == "system" and index != 0:
+            raise InvalidRoleSequenceError(role_sequence=roles, position=index, reason="misplaced_system")
+
+    start = 1 if roles[0] == "system" else 0
+    for offset, role in enumerate(roles[start:]):
+        expected = "user" if offset % 2 == 0 else "assistant"
+        if role != expected:
+            raise InvalidRoleSequenceError(role_sequence=roles, position=start + offset, reason="non_alternating")
+
+    if roles[-1] != "assistant":
+        raise InvalidRoleSequenceError(role_sequence=roles, position=len(roles) - 1, reason="unterminated")
