diff --git a/src/bespokelabs/curator/finetune/encoding.py b/src/bespokelabs/curator/finetune/encoding.py
new file mode 100644
index 0000000..cbee12f
--- /dev/null
+++ b/src/bespokelabs/curator/finetune/encoding.py
@@ -0,0 +1,144 @@
+"""Shared encoding policy for fine-tuning chat training examples.
+
+Both the Tinker :class:`~bespokelabs.curator.finetune.data_formatter.DataFormatter`
+and the Fireworks
+:class:`~bespokelabs.curator.finetune.fireworks_data_formatter.FireworksDataFormatter`
+encode the same chat training examples, so the rules about what a well-formed
+conversation looks like, what a tokenizer has to provide and what happens to an
+example that does not fit the budget live here instead of in either formatter.
+
+Everything in this module is pure and deterministic: it validates and reports,
+it never tokenizes and never touches the network.
+"""
+
+from dataclasses import dataclass
+from typing import Any, List, Sequence, Tuple
+
+#: Roles a training conversation may use.
+ALLOWED_ROLES: frozenset = frozenset({"system", "user", "assistant"})
+
+#: Bytes-per-token ratio used to budget serialized Fireworks JSONL lines.
+FIREWORKS_BYTES_PER_TOKEN: int = 3
+
+#: Minimum number of prompt tokens that must survive windowing for an example
+#: to still be worth training on.
+MIN_RETAINED_PROMPT_TOKENS: int = 16
+
+
+class EncodingError(ValueError):
+    """Base class for every error raised by the encoding policy."""
+
+
+class InvalidRoleSequenceError(EncodingError):
+    """Raised when a conversation's roles do not form a trainable sequence."""
+
+    def __init__(self, *, role_sequence: List[str], position: int, reason: str) -> None:
+        """Initialize the error.
+
+        Args:
+            role_sequence: The roles of the conversation, in message order.
+            position: Index of the message that violated the policy.
+            reason: Machine-readable reason for the rejection.
+        """
+        self.role_sequence = role_sequence
+        self.position = position
+        self.reason = reason
+        super().__init__(f"invalid role sequence at position {position} ({reason}): {role_sequence}")
+
+
+class TokenizerCapabilityError(EncodingError):
+    """Raised when a tokenizer cannot support the encoding policy."""
+
+    def __init__(self, *, missing_method: str) -> None:
+        """Initialize the error.
+
+        Args:
+            missing_method: Name of the method the tokenizer does not provide.
+        """
+        self.missing_method = missing_method
+        super().__init__(f"tokenizer is missing required method {missing_method!r}")
+
+
+class ExampleTooLongError(EncodingError):
+    """Raised when windowing an example would leave too little prompt context."""
+
+    def __init__(self, *, token_count: int, max_seq_length: int, retained_prompt_tokens: int, num_messages: int) -> None:
+        """Initialize the error.
+
+        Args:
+            token_count: Length of the untruncated token sequence.
+            max_seq_length: Sequence budget the example was windowed to.
+            retained_prompt_tokens: Prompt tokens that would survive windowing.
+            num_messages: Number of messages in the refused example.
+        """
+        self.token_count = token_count
+        self.max_seq_length = max_seq_length
+        self.retained_prompt_tokens = retained_prompt_tokens
+        self.num_messages = num_messages
+        super().__init__(
+            f"example of {token_count} tokens exceeds max_seq_length={max_seq_length}: "
+            f"{retained_prompt_tokens} prompt tokens would survive, minimum is {MIN_RETAINED_PROMPT_TOKENS}"
+        )
+
+
+@dataclass(frozen=True)
+class EncodingReport:
+    """Summary of what a batch-level encoding pass did.
+
+    Attributes:
+        kept: Number of examples that were encoded and returned.
+        dropped: Number of examples the encoding policy refused.
+        windowed: Number of kept examples whose oldest context was dropped.
+        dropped_indices: Input positions of the refused examples, ascending.
+        supervised_tokens: Total supervised tokens across the kept examples.
+    """
+
+    kept: int = 0
+    dropped: int = 0
+    windowed: int = 0
+    dropped_indices: Tuple[int, ...] = ()
+    supervised_tokens: int = 0
+
+
+def _role_of(message: Any) -> Any:
+    """Return the role of a ``ChatMessage``-like object or a message dict."""
+    if isinstance(message, dict):
+        return message.get("role")
+    return getattr(message, "role", None)
+
+
+def validate_role_sequence(messages: Sequence[Any]) -> None:
+    """Validate that a conversation's roles form a trainable sequence.
+
+    A conversation must be non-empty, use only :data:`ALLOWED_ROLES`, carry at
+    most one system message in leading position, alternate ``user``/``assistant``
+    after it, and end on an assistant turn. The first violation is reported and
+    nothing later is checked.
+
+    Args:
+        messages: Sequence of ``ChatMessage``-like objects or message dicts.
+
+    Raises:
+        InvalidRoleSequenceError: If the sequence violates any of the rules.
+    """
+    roles = [_role_of(message) for message in messages]
+
+    if not roles:
+        raise InvalidRoleSequenceError(role_sequence=roles, position=0, reason="empty")
+
+    for index, role in enumerate(roles):
+        if role not in ALLOWED_ROLES:
+            raise InvalidRoleSequenceError(role_sequence=roles, position=index, reason="unknown_role")
+
+    for index, role in enumerate(roles):
+        if role == "system" and index != 0:
+            raise InvalidRoleSequenceError(role_sequence=roles, position=index, reason="misplaced_system")
+
+    body_start = 1 if roles[0] == "system" else 0
+    for offset, role in enumerate(roles[body_start:]):
+        expected = "user" if offset % 2 == 0 else "assistant"
+        if role != expected:
+            raise InvalidRoleSequenceError(role_sequence=roles, position=body_start + offset, reason="non_alternating")
+
+    if roles[-1] != "assistant":
+        raise InvalidRoleSequenceError(role_sequence=roles, position=len(roles) - 1, reason="unterminated")
