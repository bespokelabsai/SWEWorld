+@dataclass(frozen=True)
+class ModelPrice:
+    """A model price with no missing figures in it.
+
+    Attributes:
+        model: Name the price was resolved for.
+        provider: Provider the price was resolved for, if one was given.
+        completion_window: Completion window the price applies to, "*" for any.
+        input_cost_per_million: Dollars per million input tokens.
+        output_cost_per_million: Dollars per million output tokens.
+        source: Where the price came from, either "litellm" or "external".
+        batch: Whether the per million costs are batch rates rather than list prices.
+        output_price_inferred: Whether the output cost was copied from the input cost
+            because the pricing table quotes only one number.
+        max_tokens: Context window the pricing table reports, if it reports one.
+    """
+
+    model: str
+    provider: Optional[str]
+    completion_window: str
+    input_cost_per_million: float
+    output_cost_per_million: float
+    source: str
+    batch: bool
+    output_price_inferred: bool
+    max_tokens: Optional[int]
+
+    def __post_init__(self) -> None:
+        """Round the per million costs, so that prices that are equal compare equal."""
+        object.__setattr__(self, "input_cost_per_million", round(self.input_cost_per_million, 9))
+        object.__setattr__(self, "output_cost_per_million", round(self.output_cost_per_million, 9))
+
+    @property
+    def input_cost_per_token(self) -> float:
+        """Dollars per input token."""
+        return round(self.input_cost_per_million / 1e6, 15)
+
+    @property
+    def output_cost_per_token(self) -> float:
+        """Dollars per output token."""
+        return round(self.output_cost_per_million / 1e6, 15)
+
+
+class UnpricedModelError(LookupError):
+    """Raised when no usable price exists for a model.
+
+    Attributes:
+        model: Name the price was looked up for.
+        provider: Provider the price was looked up for.
+        completion_window: Completion window the price was looked up for.
+        reason: Which of the arguments the lookup fell over on, one of `REASONS`.
+    """
+
+    REASONS = frozenset({"unknown_provider", "unknown_model", "unknown_window"})
+
+    def __init__(self, *, model: str, provider: Optional[str], completion_window: str, reason: str) -> None:
+        """Initialize the error.
+
+        Args:
+            model: Name the price was looked up for.
+            provider: Provider the price was looked up for.
+            completion_window: Completion window the price was looked up for.
+            reason: Which of the arguments the lookup fell over on.
+
+        Raises:
+            ValueError: If `reason` is not one of `REASONS`.
+        """
+        if reason not in self.REASONS:
+            raise ValueError(f"Unrecognized reason {reason!r}, expected one of {sorted(self.REASONS)}.")
+        self.model = model
+        self.provider = provider
+        self.completion_window = completion_window
+        self.reason = reason
+        super().__init__(f"{reason}: model={model!r} provider={provider!r} completion_window={completion_window!r}")
+
+
+def resolve_model_price(model: str, *, provider: Optional[str] = None, completion_window: Optional[str] = None, batch: bool = False) -> ModelPrice:
+    """Resolve what a model costs, from our own pricing tables or from litellm's.
+
+    The arguments are checked in the order they are given: a provider we don't know about is
+    reported without looking at the model, and a model we don't know about is reported without
+    looking at the completion window.
+
+    Args:
+        model: Name of the model to price.
+        provider: Provider serving the model, if known.
+        completion_window: Completion window to price, defaulting to the "*" tier.
+        batch: Whether to return batch rates rather than list prices.
+
+    Returns:
+        ModelPrice: The resolved price.
+
+    Raises:
+        UnpricedModelError: If no usable price exists for these arguments.
+    """
+    window = completion_window or _ANY_WINDOW
+    external_providers = _DEFAULT_COST_MAP["external"]["providers"]
+
+    if provider in external_providers:
+        return _external_price(model, provider, window, external_providers[provider]["cost"], batch)
+
+    price = _litellm_price(model, provider, window, batch)
+    if price is not None:
+        return price
+
+    reason = "unknown_model" if provider is None or provider in _LITELLM_PROVIDERS else "unknown_provider"
+    raise UnpricedModelError(model=model, provider=provider, completion_window=window, reason=reason)
+
+
+def _external_price(model: str, provider: str, window: str, provider_cost: dict, batch: bool) -> ModelPrice:
+    """Resolve a price from one of the provider tables curator ships.
+
+    Those tables already quote batch rates, so `batch` does not discount them any further.
+
+    Args:
+        model: Name of the model to price.
+        provider: Provider whose table `provider_cost` is.
+        window: Completion window to price.
+        provider_cost: The provider's per model pricing table.
+        batch: Whether the caller asked for batch rates.
+
+    Returns:
+        ModelPrice: The resolved price.
+
+    Raises:
+        UnpricedModelError: If the table has no usable number for these arguments.
+    """
+    if model not in provider_cost:
+        raise UnpricedModelError(model=model, provider=provider, completion_window=window, reason="unknown_model")
+
+    entry = provider_cost[model]
+    input_cost = entry["input_cost_per_million"].get(window)
+    if input_cost is None:
+        raise UnpricedModelError(model=model, provider=provider, completion_window=window, reason="unknown_window")
+
+    output_cost = entry.get("output_cost_per_million", {}).get(window)
+    output_price_inferred = output_cost is None
+
+    return ModelPrice(
+        model=model,
+        provider=provider,
+        completion_window=window,
+        input_cost_per_million=input_cost,
+        output_cost_per_million=input_cost if output_price_inferred else output_cost,
+        source="external",
+        batch=batch,
+        output_price_inferred=output_price_inferred,
+        max_tokens=entry.get("max_tokens"),
+    )
+
+
+def _litellm_price(model: str, provider: Optional[str], window: str, batch: bool) -> Optional[ModelPrice]:
+    """Resolve a price from litellm's pricing table.
+
+    Args:
+        model: Name of the model to price.
+        provider: Provider the price is being resolved for, if known.
+        window: Completion window the price is being resolved for.
+        batch: Whether to discount the list prices to batch rates.
+
+    Returns:
+        Optional[ModelPrice]: The resolved price, or None if litellm has no usable row for the
+        model. A row whose input price is null is no more use to us than a missing row.
+    """
+    entry = litellm.model_cost.get(model)
+    if entry is None:
+        return None
+
+    input_cost_per_token = entry.get("input_cost_per_token")
+    if input_cost_per_token is None:
+        return None
+
+    output_cost_per_token = entry.get("output_cost_per_token")
+    output_price_inferred = output_cost_per_token is None
+
+    multiplier = _BATCH_COST_MULTIPLIER if batch else 1.0
+    input_cost = input_cost_per_token * 1e6 * multiplier
+    return ModelPrice(
+        model=model,
+        provider=provider,
+        completion_window=window,
+        input_cost_per_million=input_cost,
+        output_cost_per_million=input_cost if output_price_inferred else output_cost_per_token * 1e6 * multiplier,
+        source="litellm",
+        batch=batch,
+        output_price_inferred=output_price_inferred,
+        max_tokens=entry.get("max_tokens"),
+    )
+
+
+def register_price_with_litellm(price: ModelPrice) -> dict:
+    """Register a price with litellm, so that `litellm.completion_cost` can use it.
+
+    Args:
+        price: The list price to register.
+
+    Returns:
+        dict: The entry written into `litellm.model_cost`.
+
+    Raises:
+        ValueError: If `price` carries batch rates. Batch discounting happens where a cost is
+            reported, so registering a discounted price would take the discount twice.
+    """
+    if price.batch:
+        raise ValueError(f"Cannot register batch rates for {price.model!r} with litellm, register its list price instead.")
+
+    litellm_provider = price.provider if price.provider in _LITELLM_PROVIDERS else _FALLBACK_LITELLM_PROVIDER
+    entry = {
+        "max_tokens": price.max_tokens,
+        "input_cost_per_token": price.input_cost_per_token,
+        "output_cost_per_token": price.output_cost_per_token,
+        "litellm_provider": litellm_provider,
     }
+    litellm.register_model({price.model: entry})
+    return entry
+
