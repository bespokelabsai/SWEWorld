 import litellm
 
@@ -10,6 +14,253 @@ RATE_LIMIT_HEADER = {
     "api.together.xyz": {"request-key": {"key": "x-ratelimit-limit", "type": "rps"}, "token-key": {"key": "x-ratelimit-limit-tokens", "type": "tps"}}
 }
 
+# Batch APIs priced off litellm's online table are billed at half the online rate.
+_BATCH_DISCOUNT = 0.5
+
+# Completion window used when a caller doesn't care about (or doesn't have) one.
+_DEFAULT_COMPLETION_WINDOW = "*"
+
+# Fallback context length for models registered with litellm without one.
+_DEFAULT_MAX_TOKENS = 8192
+
+
+@dataclass(frozen=True)
+class ModelPrice:
+    """Resolved price of a single model, as returned by `resolve_model_price`.
+
+    Attributes:
+        model: Model name the price was resolved for.
+        provider: Provider the price was requested for, if any.
+        completion_window: Completion window the price applies to.
+        input_cost_per_million: Cost in dollars per million input tokens.
+        output_cost_per_million: Cost in dollars per million output tokens.
+        source: Pricing table the price came from, either "litellm" or "external".
+        batch: Whether the prices are batch rates.
+        output_price_inferred: Whether the output price was copied from the input price
+            because the pricing table has no explicit output price.
+        max_tokens: Context length of the model, when the pricing table knows it.
+    """
+
+    model: str
+    provider: Optional[str]
+    completion_window: str
+    input_cost_per_million: float
+    output_cost_per_million: float
+    source: str
+    batch: bool = False
+    output_price_inferred: bool = False
+    max_tokens: Optional[int] = None
+
+    @property
+    def input_cost_per_token(self) -> float:
+        """Cost in dollars per input token."""
+        return round(self.input_cost_per_million / 1e6, 15)
+
+    @property
+    def output_cost_per_token(self) -> float:
+        """Cost in dollars per output token."""
+        return round(self.output_cost_per_million / 1e6, 15)
+
+
+class UnpricedModelError(LookupError):
+    """Raised when no price is available for a model.
+
+    Attributes:
+        REASONS: The reason strings a `UnpricedModelError` is allowed to carry.
+    """
+
+    REASONS = frozenset(
+        {
+            # The requested provider has no pricing table of its own.
+            "unknown_provider",
+            # No pricing table knows the model.
+            "unknown_model",
+            # The model is priced, but not for the requested completion window.
+            "unknown_completion_window",
+            # The model has a pricing entry, but it carries no token price.
+            "missing_price",
+        }
+    )
+
+    def __init__(self, *, model: str, provider: Optional[str], completion_window: Optional[str], reason: str) -> None:
+        """Initialize the error.
+
+        Args:
+            model: Model the price was requested for.
+            provider: Provider the price was requested for, if any.
+            completion_window: Completion window the price was requested for, if any.
+            reason: Why the price is unavailable, one of `UnpricedModelError.REASONS`.
+
+        Raises:
+            ValueError: If `reason` is not one of `UnpricedModelError.REASONS`.
+        """
+        if reason not in self.REASONS:
+            raise ValueError(f"Unknown reason {reason!r}, expected one of {sorted(self.REASONS)}.")
+        self.model = model
+        self.provider = provider
+        self.completion_window = completion_window
+        self.reason = reason
+        super().__init__(f"{reason}: model={model!r} provider={provider!r} completion_window={completion_window!r}")
+
+
+def _external_price(model: str, provider: str, completion_window: str, batch: bool) -> ModelPrice:
+    """Build a `ModelPrice` from an external provider's pricing table."""
+    entry = _DEFAULT_COST_MAP["external"]["providers"][provider]["cost"][model]
+    input_costs = entry.get("input_cost_per_million") or {}
+    if completion_window not in input_costs:
+        raise UnpricedModelError(model=model, provider=provider, completion_window=completion_window, reason="unknown_completion_window")
+
+    input_cost_per_million = input_costs[completion_window]
+    if input_cost_per_million is None:
+        raise UnpricedModelError(model=model, provider=provider, completion_window=completion_window, reason="missing_price")
+
+    output_cost_per_million = (entry.get("output_cost_per_million") or {}).get(completion_window)
+    output_price_inferred = output_cost_per_million is None
+    if output_price_inferred:
+        output_cost_per_million = input_cost_per_million
+
+    # External tables are already quoted per completion window, so batch rates need no discount.
+    return ModelPrice(
+        model=model,
+        provider=provider,
+        completion_window=completion_window,
+        input_cost_per_million=round(input_cost_per_million, 9),
+        output_cost_per_million=round(output_cost_per_million, 9),
+        source="external",
+        batch=batch,
+        output_price_inferred=output_price_inferred,
+        max_tokens=entry.get("max_tokens"),
+    )
+
+
+def _litellm_price(model: str, provider: Optional[str], completion_window: str, batch: bool) -> ModelPrice:
+    """Build a `ModelPrice` from litellm's pricing table."""
+    entry = litellm.model_cost[model]
+    input_cost_per_token = entry.get("input_cost_per_token")
+    if input_cost_per_token is None:
+        raise UnpricedModelError(model=model, provider=provider, completion_window=completion_window, reason="missing_price")
+
+    output_cost_per_token = entry.get("output_cost_per_token")
+    output_price_inferred = output_cost_per_token is None
+    if output_price_inferred:
+        output_cost_per_token = input_cost_per_token
+
+    discount = _BATCH_DISCOUNT if batch else 1.0
+    return ModelPrice(
+        model=model,
+        provider=provider,
+        completion_window=completion_window,
+        input_cost_per_million=round(input_cost_per_token * 1e6 * discount, 9),
+        output_cost_per_million=round(output_cost_per_token * 1e6 * discount, 9),
+        source="litellm",
+        batch=batch,
+        output_price_inferred=output_price_inferred,
+        max_tokens=entry.get("max_tokens"),
+    )
+
+
+def resolve_model_price(model: str, *, provider: Optional[str] = None, completion_window: Optional[str] = None, batch: bool = False) -> ModelPrice:
+    """Resolve the price of a model.
+
+    Provider specific pricing from the external cost map wins over litellm's table, since
+    external providers quote their own (completion window dependent) rates for models that
+    litellm may also know under the same name.
+
+    Args:
+        model: Model to price.
+        provider: Provider serving the model, if any.
+        completion_window: Completion window to price, defaulting to `"*"`.
+        batch: Whether to return batch rates instead of online rates.
+
+    Returns:
+        ModelPrice: The resolved price, never carrying a `None` cost.
+
+    Raises:
+        UnpricedModelError: If no price is available for the model.
+    """
+    completion_window = completion_window or _DEFAULT_COMPLETION_WINDOW
+    external_providers = _DEFAULT_COST_MAP["external"]["providers"]
+
+    if provider in external_providers and model in external_providers[provider]["cost"]:
+        return _external_price(model, provider, completion_window, batch)
+
+    if model in litellm.model_cost:
+        return _litellm_price(model, provider, completion_window, batch)
+
+    if provider is not None and provider not in external_providers:
+        raise UnpricedModelError(model=model, provider=provider, completion_window=completion_window, reason="unknown_provider")
+
+    raise UnpricedModelError(model=model, provider=provider, completion_window=completion_window, reason="unknown_model")
+
+
+def register_price_with_litellm(price: ModelPrice) -> dict:
+    """Register a price with litellm so that `litellm.completion_cost` can use it.
+
+    Args:
+        price: Price to register, which must be an online (non batch) price since litellm
+            applies its own batch discount on top of its table.
+
+    Returns:
+        dict: The entry written into `litellm.model_cost` for `price.model`.
+
+    Raises:
+        ValueError: If `price` is a batch price.
+    """
+    if price.batch:
+        raise ValueError(f"Cannot register batch prices with litellm: model={price.model!r}.")
+
+    entry = {
+        "max_tokens": price.max_tokens or _DEFAULT_MAX_TOKENS,
+        "input_cost_per_token": price.input_cost_per_token,
+        "output_cost_per_token": price.output_cost_per_token,
+        "litellm_provider": litellm.model_cost.get(price.model, {}).get("litellm_provider") or "openai",
+    }
+    litellm.register_model({price.model: entry})
+    return entry
+
+
+def format_cost_strings(price: Optional[ModelPrice], *, rich: bool) -> tuple[str, str]:
+    """Format the per million token prices for display.
+
+    Args:
+        price: Price to format, or None if no price is available.
+        rich: Whether the strings are rendered by rich rather than printed as plain text.
+
+    Returns:
+        tuple[str, str]: The input and output cost strings. The output string is suffixed
+            with `"*"` when the output price was inferred from the input price.
+    """
+    if price is None:
+        unavailable = "[dim]N/A[/dim]" if rich else "N/A"
+        return unavailable, unavailable
+
+    input_cost_str = f"${price.input_cost_per_million:.3f}"
+    output_cost_str = f"${price.output_cost_per_million:.3f}"
+    if rich:
+        input_cost_str = f"[red]{input_cost_str}[/red]"
+        output_cost_str = f"[red]{output_cost_str}[/red]"
+    if price.output_price_inferred:
+        output_cost_str += "*"
+    return input_cost_str, output_cost_str
+
+
+def external_model_cost(model: str, completion_window: str = "*", provider: str = "default") -> dict[str, float]:
+    """Get the cost of the model from the external providers registered.
+
+    Args:
+        model: Model to price.
+        completion_window: Completion window to price.
+        provider: Provider serving the model.
+
+    Returns:
+        dict[str, float]: The per token input and output costs.
+
+    Raises:
+        UnpricedModelError: If no price is available for the model.
+    """
+    price = resolve_model_price(model, provider=provider, completion_window=completion_window, batch=False)
+    return {"input_cost_per_token": price.input_cost_per_token, "output_cost_per_token": price.output_cost_per_token}
+
 
