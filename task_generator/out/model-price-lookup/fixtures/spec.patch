+# Batch APIs bill list-priced models at half of their online price.
+_BATCH_DISCOUNT_FACTOR = 0.5
+
+# Providers priced by curator's own rate table instead of litellm's.
+_EXTERNAL_PROVIDERS = _DEFAULT_COST_MAP["external"]["providers"]
+
+# Providers meaning "this model is priced by litellm's table", on top of the ones litellm knows.
+_LITELLM_PROVIDER_ALIASES = (None, "default")
+
+# litellm provider registered for models it doesn't know about, since it refuses to price a model
+# whose `litellm_provider` isn't one of its own.
+_FALLBACK_LITELLM_PROVIDER = "openai"
+
+# Completion window of models that aren't priced per window.
+_ANY_COMPLETION_WINDOW = "*"
+
+# Context length registered with litellm when the pricing data doesn't list one.
+_DEFAULT_MAX_TOKENS = 8192
+
+
+@dataclass(frozen=True)
+class ModelPrice:
+    """The price of a single model, as resolved from one of the pricing tables.
+
+    Attributes:
+        model: Model the price was resolved for.
+        provider: Provider the price was requested for, if any.
+        completion_window: Completion window the price applies to, "*" when it isn't tiered.
+        input_cost_per_million: Dollars per million input tokens.
+        output_cost_per_million: Dollars per million output tokens.
+        source: Table the price came from, either "litellm" or "external".
+        batch: Whether the per-million prices are batch rates.
+        output_price_inferred: Whether the output price was copied from the input price.
+        max_tokens: Context length listed next to the price, if any.
+    """
+
+    model: str
+    provider: Optional[str]
+    completion_window: str
+    input_cost_per_million: float
+    output_cost_per_million: float
+    source: str
+    batch: bool = False
+    output_price_inferred: bool = False
+    max_tokens: Optional[int] = None
+
+    @property
+    def input_cost_per_token(self) -> float:
+        """Dollars per input token."""
+        return round(self.input_cost_per_million / 1e6, 15)
+
+    @property
+    def output_cost_per_token(self) -> float:
+        """Dollars per output token."""
+        return round(self.output_cost_per_million / 1e6, 15)
+
+
+class UnpricedModelError(LookupError):
+    """Raised when none of the pricing tables can price a model."""
+
+    REASONS = frozenset({"unknown_provider", "unknown_model", "unknown_window"})
+
+    def __init__(self, *, model: str, provider: Optional[str], completion_window: Optional[str], reason: str) -> None:
+        """Initialize the error.
+
+        Args:
+            model: Model that couldn't be priced.
+            provider: Provider the price was requested for, if any.
+            completion_window: Completion window the price was requested for, if any.
+            reason: Why the lookup failed, one of `REASONS`.
+
+        Raises:
+            ValueError: If `reason` is not one of `REASONS`.
+        """
+        if reason not in self.REASONS:
+            raise ValueError(f"Unknown reason {reason!r}, expected one of {sorted(self.REASONS)}.")
+        self.model = model
+        self.provider = provider
+        self.completion_window = completion_window
+        self.reason = reason
+        super().__init__(f"{reason}: model={model!r} provider={provider!r} completion_window={completion_window!r}")
+
+
+def resolve_model_price(model: str, *, provider: Optional[str] = None, completion_window: Optional[str] = None, batch: bool = False) -> ModelPrice:
+    """Resolve the price of a model, from the external rate table or from litellm's.
+
+    The provider decides which table answers: providers listed in curator's own rate table are
+    priced per completion window from it, everything else is priced by litellm.
+
+    Args:
+        model: Model to price.
+        provider: Compatible provider serving the model, if any.
+        completion_window: Completion window to price, defaults to the untiered "*" rate.
+        batch: Whether to return batch rates rather than list prices.
+
+    Returns:
+        ModelPrice: The resolved price, never carrying a `None` price.
+
+    Raises:
+        UnpricedModelError: If the provider, the model or the completion window is unknown.
+    """
+    window = completion_window or _ANY_COMPLETION_WINDOW
+    if provider in _EXTERNAL_PROVIDERS:
+        return _external_model_price(model, provider, window, batch)
+    if provider not in _LITELLM_PROVIDER_ALIASES and provider not in litellm.provider_list:
+        raise UnpricedModelError(model=model, provider=provider, completion_window=window, reason="unknown_provider")
+    return _litellm_model_price(model, provider, window, batch)
+
+
+def _external_model_price(model: str, provider: str, completion_window: str, batch: bool) -> ModelPrice:
+    """Price a model from the external provider's rate table, whose rates are already batch tiers."""
+    provider_cost = _EXTERNAL_PROVIDERS[provider]["cost"]
+    if model not in provider_cost:
+        raise UnpricedModelError(model=model, provider=provider, completion_window=completion_window, reason="unknown_model")
+
+    model_cost = provider_cost[model]
+    input_costs = model_cost["input_cost_per_million"]
+    if completion_window not in input_costs:
+        raise UnpricedModelError(model=model, provider=provider, completion_window=completion_window, reason="unknown_window")
+
+    input_cost_per_million = input_costs[completion_window]
+    output_costs = model_cost.get("output_cost_per_million", {})
+    output_price_inferred = completion_window not in output_costs
+    output_cost_per_million = input_cost_per_million if output_price_inferred else output_costs[completion_window]
+
+    return ModelPrice(
+        model=model,
+        provider=provider,
+        completion_window=completion_window,
+        input_cost_per_million=round(input_cost_per_million, 9),
+        output_cost_per_million=round(output_cost_per_million, 9),
+        source="external",
+        batch=batch,
+        output_price_inferred=output_price_inferred,
+        max_tokens=model_cost.get("max_tokens"),
+    )
+
+
+def _litellm_model_price(model: str, provider: Optional[str], completion_window: str, batch: bool) -> ModelPrice:
+    """Price a model from litellm's cost table, whose rates are list prices."""
+    model_cost = litellm.model_cost.get(model, {})
+    if model_cost.get("input_cost_per_token") is None:
+        raise UnpricedModelError(model=model, provider=provider, completion_window=completion_window, reason="unknown_model")
+
+    input_cost_per_million = round(model_cost["input_cost_per_token"] * 1e6, 9)
+    output_cost_per_token = model_cost.get("output_cost_per_token")
+    output_price_inferred = output_cost_per_token is None
+    output_cost_per_million = input_cost_per_million if output_price_inferred else round(output_cost_per_token * 1e6, 9)
+
+    discount = _BATCH_DISCOUNT_FACTOR if batch else 1.0
+    return ModelPrice(
+        model=model,
+        provider=provider,
+        completion_window=completion_window,
+        input_cost_per_million=input_cost_per_million * discount,
+        output_cost_per_million=output_cost_per_million * discount,
+        source="litellm",
+        batch=batch,
+        output_price_inferred=output_price_inferred,
+        max_tokens=model_cost.get("max_tokens"),
+    )
+
+
+def register_price_with_litellm(price: ModelPrice) -> dict:
+    """Register a list price with litellm, so that `litellm.completion_cost` can bill against it.
+
+    Args:
+        price: List price to register.
+
+    Returns:
+        dict: The entry written into `litellm.model_cost`.
+
+    Raises:
+        ValueError: If `price` carries batch rates, since litellm bills list prices.
+    """
+    if price.batch:
+        raise ValueError(f"Cannot register batch rates for {price.model!r} with litellm, register the list price instead.")
+
+    entry = {
+        "max_tokens": _DEFAULT_MAX_TOKENS if price.max_tokens is None else price.max_tokens,
+        "input_cost_per_token": price.input_cost_per_token,
+        "output_cost_per_token": price.output_cost_per_token,
+        "litellm_provider": price.provider if price.provider in litellm.provider_list else _FALLBACK_LITELLM_PROVIDER,
+    }
+    litellm.register_model({price.model: entry})
+    return entry
+
+
+def format_cost_strings(price: Optional[ModelPrice], *, rich: bool) -> tuple[str, str]:
+    """Format a price for display in the status trackers.
+
+    Args:
+        price: Resolved price, or None when the model couldn't be priced.
+        rich: Whether to wrap the strings in rich markup.
+
+    Returns:
+        tuple[str, str]: The input and output cost strings, the output one marked with a
+            trailing "*" when it was inferred from the input price.
+    """
+    if price is None:
+        return ("[dim]N/A[/dim]", "[dim]N/A[/dim]") if rich else ("N/A", "N/A")
+
+    input_cost_str = _format_cost_string(price.input_cost_per_million, rich)
+    output_cost_str = _format_cost_string(price.output_cost_per_million, rich)
+    if price.output_price_inferred:
+        output_cost_str += "*"
+    return input_cost_str, output_cost_str
+
+
+def _format_cost_string(cost_per_million: float, rich: bool) -> str:
+    """Format a single per-million price for display."""
+    return f"[red]${cost_per_million:.3f}[/red]" if rich else f"${cost_per_million:.3f}"
+
+
+def external_model_cost(model, completion_window="*", provider="default"):
+    """Get the cost of the model from the external providers registered."""
+    price = resolve_model_price(model, provider=provider, completion_window=completion_window, batch=False)
+    return {"input_cost_per_token": price.input_cost_per_token, "output_cost_per_token": price.output_cost_per_token}
+
 
