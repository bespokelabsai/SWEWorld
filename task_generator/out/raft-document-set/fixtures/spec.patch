+@dataclass(frozen=True)
+class RaftSampling:
+    """Sampling knobs used when building the document set of an example.
+
+    Args:
+        sampler: Custom sampling strategy (defaults to the generator's own rng sample)
+        rng: Random number generator driving the oracle coin, sampling and shuffling
+    """
+
+    sampler: Optional[_SamplingStrategy] = None
+    rng: Optional[random.Random] = None
+
+
+@dataclass
+class RaftDrawStats:
+    """Counters describing the document sets a run actually drew.
+
+    Args:
+        document_sets: Number of document sets built
+        with_oracle: Number of those document sets that contain the oracle document
+    """
+
+    document_sets: int = 0
+    with_oracle: int = 0
+
+    def oracle_rate(self) -> float:
+        """Fraction of the built document sets that contain the oracle document."""
+        if self.document_sets == 0:
+            return 0.0
+        return self.with_oracle / self.document_sets
+
+
+class InsufficientDistractorsError(ValueError):
+    """Raised when the corpus is too small to supply the requested distractors."""
+
+    def __init__(self, chunk_id: ChunkId, requested: int, available: int) -> None:
+        """Initialize the error.
+
+        Args:
+            chunk_id: Chunk the document set was being built for
+            requested: Number of distractors needed in the worst case
+            available: Number of chunks that could serve as distractors
+        """
+        super().__init__(f"chunk {chunk_id}: requested {requested} distractors, only {available} available")
+        self.chunk_id = chunk_id
+        self.requested = requested
+        self.available = available
+
