@@ -0,0 +1,473 @@
+"""Durable, file-backed ledger of the responses produced by a run.
+
+A run's working directory holds one ``requests_N.jsonl`` / ``metadata_N.json`` /
+``responses_N.jsonl`` triple per request file. The request files declare which
+dataset rows must be answered, and the response files are an append-only log of
+every terminal outcome for those rows: successes, parses that produced no rows,
+parses that failed, and permanent request failures.
+
+Because the log is append-only, a row may appear several times (a failure from an
+interrupted run followed by a success from a resumed one). This module folds those
+lines down to a single winning record per row, and exposes the resulting counts as
+a single authoritative tally that callers use instead of their own counters.
+"""
+
+import enum
+import glob
+import json
+import os
+from dataclasses import dataclass
+from typing import Dict, List, Optional
+
+from pydantic import BaseModel, ValidationError
+
+from bespokelabs.curator.log import logger
+from bespokelabs.curator.types.generic_response import GenericResponse
+
+LEDGER_SCHEMA_VERSION: int = 1
+ERROR_SAMPLE_LIMIT: int = 10
+
+_REQUEST_FILE_PATTERN = "requests_*.jsonl"
+_RESPONSE_FILE_PATTERN = "responses_*.jsonl"
+
+
+class LedgerStatus(str, enum.Enum):
+    """Terminal status of a single durable record.
+
+    Attributes:
+        SUCCEEDED: The request was answered and the parse produced at least one row.
+        EMPTY: The request was answered and the parse deliberately produced no rows.
+        UNPARSEABLE: The request was answered but the response could not be parsed.
+        FAILED: The request itself failed permanently.
+    """
+
+    SUCCEEDED = "succeeded"
+    EMPTY = "empty"
+    UNPARSEABLE = "unparseable"
+    FAILED = "failed"
+
+
+#: Statuses that are terminal successes, i.e. the row never needs to be reissued.
+_RESOLVED_STATUSES = frozenset({LedgerStatus.SUCCEEDED, LedgerStatus.EMPTY})
+
+#: How good each status is. When a row has several records, the best one wins.
+_STATUS_RANK = {
+    LedgerStatus.FAILED: 0,
+    LedgerStatus.UNPARSEABLE: 1,
+    LedgerStatus.EMPTY: 2,
+    LedgerStatus.SUCCEEDED: 3,
+}
+
+_UNPARSEABLE_ERROR = "Response message could not be parsed into rows"
+
+
+def classify_record(response: GenericResponse) -> LedgerStatus:
+    """Classify a durable record into its terminal status.
+
+    Args:
+        response: The record to classify.
+
+    Returns:
+        LedgerStatus: The terminal status of the record.
+    """
+    if response.response_errors or response.response_message is None:
+        return LedgerStatus.FAILED
+    if response.parsed_response_message is None:
+        return LedgerStatus.UNPARSEABLE
+    if len(response.parsed_response_message) == 0:
+        return LedgerStatus.EMPTY
+    return LedgerStatus.SUCCEEDED
+
+
+def _normalize_parsed_rows(rows: Optional[list]) -> Optional[list]:
+    """Normalize the rows returned by a `parse_func` into JSON serializable dicts.
+
+    Args:
+        rows: The parsed rows to normalize, or None if the response was not parsed.
+
+    Returns:
+        Optional[list]: The normalized rows, or None if there were none.
+
+    Raises:
+        ValueError: If a row is neither a dict nor a pydantic model.
+    """
+    if rows is None:
+        return None
+
+    normalized = []
+    for row in rows:
+        if isinstance(row, BaseModel):
+            normalized.append(row.model_dump(mode="json"))
+        elif isinstance(row, dict):
+            normalized.append(row)
+        else:
+            raise ValueError(f"Got invalid row {row} of type {type(row)} from `parse_func`. This should be type <class 'dict'>.")
+    return normalized
+
+
+def ledger_line(response: GenericResponse) -> str:
+    """Serialize a response into a single canonical ledger line.
+
+    The raw provider `response_message` is written as-is so that the record can be
+    re-parsed later with a different `parse_func`, while the rows in
+    `parsed_response_message` are normalized to plain JSON objects.
+
+    Args:
+        response: The response to serialize.
+
+    Returns:
+        str: The record as one line of JSON, terminated by a single newline.
+
+    Raises:
+        ValueError: If a parsed row is neither a dict nor a pydantic model.
+    """
+    parsed_response_message = _normalize_parsed_rows(response.parsed_response_message)
+    response_message = response.response_message
+    if isinstance(response_message, BaseModel):
+        response_message = response_message.model_dump(mode="json")
+
+    record = response.model_dump(mode="json", exclude={"response_message", "parsed_response_message"})
+    record["response_message"] = response_message
+    record["parsed_response_message"] = parsed_response_message
+    return json.dumps(record, default=str) + "\n"
+
+
+def parse_ledger_line(line: str) -> Optional[GenericResponse]:
+    """Parse a single ledger line back into a response.
+
+    Args:
+        line: The line to parse.
+
+    Returns:
+        Optional[GenericResponse]: The record, or None if the line is blank or invalid.
+    """
+    if not line or not line.strip():
+        return None
+    try:
+        return GenericResponse.model_validate_json(line)
+    except (json.JSONDecodeError, ValidationError, ValueError):
+        logger.warning(f"Skipping response due to error parsing line: {line}")
+        return None
+
+
+class LedgerIntegrityError(ValueError):
+    """Raised when the ledger contradicts the requests that declare the run.
+
+    Attributes:
+        row_idx: The dataset row index of the offending record.
+        source_file: The response file the offending record was read from.
+    """
+
+    def __init__(self, row_idx: int, source_file: str, message: Optional[str] = None):
+        """Initialize the error.
+
+        Args:
+            row_idx: The dataset row index of the offending record.
+            source_file: The response file the offending record was read from.
+            message: Optional message overriding the default one.
+        """
+        self.row_idx = row_idx
+        self.source_file = source_file
+        super().__init__(message or f"Response for row {row_idx} in {source_file} is not declared by any request file.")
+
+
+@dataclass(frozen=True)
+class LedgerTally:
+    """Authoritative counts derived from a loaded ledger.
+
+    Attributes:
+        n_requests: Number of requests declared by the request files.
+        n_declared_requests: Number of requests the metadata files say were written.
+        n_recorded: Number of rows that have a durable record.
+        n_succeeded: Number of rows whose record is a terminal success.
+        n_failed: Number of rows whose record failed or could not be parsed.
+        n_missing: Number of declared rows without any durable record.
+        n_duplicate_lines: Number of response lines superseded by another record.
+        n_malformed_lines: Number of response lines that could not be parsed.
+        n_dataset_rows: Number of dataset rows held by the succeeded records.
+        error_sample: Sample of the first errors encountered.
+        schema_version: Schema version of the ledger the tally was read from.
+    """
+
+    n_requests: int
+    n_declared_requests: int
+    n_recorded: int
+    n_succeeded: int
+    n_failed: int
+    n_missing: int
+    n_duplicate_lines: int
+    n_malformed_lines: int
+    n_dataset_rows: int
+    error_sample: tuple[str, ...]
+    schema_version: int
+
+
+@dataclass(frozen=True)
+class ResumeState:
+    """View of an existing response file used to resume a run.
+
+    Attributes:
+        completed_row_indices: Rows that are terminally successful and must be skipped.
+        retryable_row_indices: Rows that have a record but must be reissued.
+        n_dataset_rows: Number of dataset rows held by the completed records.
+    """
+
+    completed_row_indices: frozenset[int]
+    retryable_row_indices: frozenset[int]
+    n_dataset_rows: int
+
+
+def _fold(records: Dict[int, GenericResponse], response: GenericResponse) -> bool:
+    """Fold a record into the winning records, keeping the best one.
+
+    Args:
+        records: Mapping of row index to the winning record so far, updated in place.
+        response: The record to fold in.
+
+    Returns:
+        bool: True if the record was a duplicate of an already recorded row.
+    """
+    row_idx = response.generic_request.original_row_idx
+    current = records.get(row_idx)
+    if current is None:
+        records[row_idx] = response
+        return False
+
+    # Later lines win ties, so that a retry supersedes the attempt it repeats.
+    if _STATUS_RANK[classify_record(response)] >= _STATUS_RANK[classify_record(current)]:
+        records[row_idx] = response
+    return True
+
+
+def read_resume_state(response_file: str) -> ResumeState:
+    """Read an existing response file to find out what still needs to be requested.
+
+    Args:
+        response_file: Path to the response file to read.
+
+    Returns:
+        ResumeState: The rows to skip, the rows to reissue and the rows already parsed.
+    """
+    if not os.path.exists(response_file):
+        return ResumeState(completed_row_indices=frozenset(), retryable_row_indices=frozenset(), n_dataset_rows=0)
+
+    logger.info(f"Resuming progress by reading existing file: {response_file}")
+    records: Dict[int, GenericResponse] = {}
+    malformed_lines = 0
+    with open(response_file, "r") as f:
+        for line in f:
+            if not line.strip():
+                continue
+            response = parse_ledger_line(line)
+            if response is None:
+                malformed_lines += 1
+                continue
+            _fold(records, response)
+
+    completed = set()
+    retryable = set()
+    n_dataset_rows = 0
+    for row_idx, response in records.items():
+        if classify_record(response) in _RESOLVED_STATUSES:
+            completed.add(row_idx)
+            n_dataset_rows += len(response.parsed_response_message or [])
+        else:
+            retryable.add(row_idx)
+
+    logger.info(
+        f"Found {len(completed)} successful requests and {len(retryable)} "
+        f"previously failed requests and {malformed_lines} parsing errors in {response_file}"
+    )
+    return ResumeState(completed_row_indices=frozenset(completed), retryable_row_indices=frozenset(retryable), n_dataset_rows=n_dataset_rows)
+
+
+class ResponseLedger:
+    """Durable ledger over all request and response files of a single run.
+
+    Attributes:
+        working_dir: Directory holding the request, metadata and response files.
+    """
+
+    def __init__(
+        self,
+        working_dir: str,
+        request_lines: Dict[int, str],
+        n_declared_requests: int,
+        records: Dict[int, GenericResponse],
+        n_duplicate_lines: int,
+        n_malformed_lines: int,
+    ):
+        """Initialize the ledger. Use `ResponseLedger.load` instead.
+
+        Args:
+            working_dir: Directory holding the request, metadata and response files.
+            request_lines: Mapping of declared row index to its raw request line.
+            n_declared_requests: Number of requests the metadata files declare.
+            records: Mapping of row index to its winning record.
+            n_duplicate_lines: Number of response lines superseded by another record.
+            n_malformed_lines: Number of response lines that could not be parsed.
+        """
+        self.working_dir = working_dir
+        self._request_lines = request_lines
+        self._n_declared_requests = n_declared_requests
+        self._records = records
+        self._n_duplicate_lines = n_duplicate_lines
+        self._n_malformed_lines = n_malformed_lines
+
+    @classmethod
+    def load(cls, working_dir: str) -> "ResponseLedger":
+        """Load the ledger of a run from its working directory.
+
+        Args:
+            working_dir: Directory holding the request, metadata and response files.
+
+        Returns:
+            ResponseLedger: The loaded ledger.
+
+        Raises:
+            LedgerIntegrityError: If a record refers to a row no request file declares.
+        """
+        request_lines, n_declared_requests = cls._read_request_files(working_dir)
+
+        records: Dict[int, GenericResponse] = {}
+        n_duplicate_lines = 0
+        n_malformed_lines = 0
+        for response_file in sorted(glob.glob(os.path.join(working_dir, _RESPONSE_FILE_PATTERN))):
+            with open(response_file, "r") as f:
+                for line in f:
+                    if not line.strip():
+                        continue
+                    response = parse_ledger_line(line)
+                    if response is None:
+                        n_malformed_lines += 1
+                        continue
+                    row_idx = response.generic_request.original_row_idx
+                    if row_idx not in request_lines:
+                        raise LedgerIntegrityError(row_idx, response_file)
+                    if _fold(records, response):
+                        n_duplicate_lines += 1
+
+        return cls(
+            working_dir=working_dir,
+            request_lines=request_lines,
+            n_declared_requests=n_declared_requests,
+            records=records,
+            n_duplicate_lines=n_duplicate_lines,
+            n_malformed_lines=n_malformed_lines,
+        )
+
+    @staticmethod
+    def _read_request_files(working_dir: str) -> tuple[Dict[int, str], int]:
+        """Read the request files and their metadata files.
+
+        Args:
+            working_dir: Directory holding the request and metadata files.
+
+        Returns:
+            tuple[Dict[int, str], int]: The raw request line of every declared row,
+                and the number of requests the metadata files declare.
+        """
+        request_lines: Dict[int, str] = {}
+        n_declared_requests = 0
+        for request_file in sorted(glob.glob(os.path.join(working_dir, _REQUEST_FILE_PATTERN))):
+            with open(request_file, "r") as f:
+                for line in f:
+                    if not line.strip():
+                        continue
+                    try:
+                        request = json.loads(line)
+                    except json.JSONDecodeError:
+                        logger.warning(f"Skipping request due to error parsing line in {request_file}: {line}")
+                        continue
+                    row_idx = request.get("original_row_idx")
+                    if row_idx is None:
+                        continue
+                    request_lines[row_idx] = line.rstrip("\n")
+
+            metadata_file = os.path.join(working_dir, os.path.basename(request_file).replace("requests_", "metadata_").replace(".jsonl", ".json"))
+            if not os.path.exists(metadata_file):
+                logger.warning(f"Ledger missing metadata file {metadata_file} for request file {request_file}")
+                continue
+            try:
+                with open(metadata_file, "r") as f:
+                    n_declared_requests += int(json.load(f)["num_jobs"])
+            except (json.JSONDecodeError, KeyError, TypeError, ValueError):
+                logger.warning(f"Ledger could not read the number of jobs from metadata file {metadata_file}")
+
+        return request_lines, n_declared_requests
+
+    def tally(self) -> LedgerTally:
+        """Count the durable state of the run.
+
+        Returns:
+            LedgerTally: The counts derived from the winning records.
+        """
+        n_succeeded = 0
+        n_failed = 0
+        n_dataset_rows = 0
+        error_sample: List[str] = []
+        for _, response in sorted(self._records.items()):
+            status = classify_record(response)
+            if status in _RESOLVED_STATUSES:
+                n_succeeded += 1
+                n_dataset_rows += len(response.parsed_response_message or [])
+                continue
+            n_failed += 1
+            if len(error_sample) < ERROR_SAMPLE_LIMIT:
+                error_sample.append(str(response.response_errors) if response.response_errors else _UNPARSEABLE_ERROR)
+
+        return LedgerTally(
+            n_requests=len(self._request_lines),
+            n_declared_requests=self._n_declared_requests,
+            n_recorded=len(self._records),
+            n_succeeded=n_succeeded,
+            n_failed=n_failed,
+            n_missing=len(self.missing_row_indices()),
+            n_duplicate_lines=self._n_duplicate_lines,
+            n_malformed_lines=self._n_malformed_lines,
+            n_dataset_rows=n_dataset_rows,
+            error_sample=tuple(error_sample),
+            schema_version=LEDGER_SCHEMA_VERSION,
+        )
+
+    def winning_records(self) -> List[GenericResponse]:
+        """Return the winning record of every recorded row.
+
+        Returns:
+            List[GenericResponse]: The records, in ascending row index order.
+        """
+        return [response for _, response in sorted(self._records.items())]
+
+    def missing_row_indices(self) -> List[int]:
+        """Return the declared rows that have no durable record at all.
+
+        Returns:
+            List[int]: The row indices, in ascending order.
+        """
+        return sorted(row_idx for row_idx in self._request_lines if row_idx not in self._records)
+
+    def unresolved_row_indices(self) -> List[int]:
+        """Return the declared rows that did not reach a terminal success.
+
+        These are the rows that are missing a record entirely plus the rows whose
+        record failed or could not be parsed.
+
+        Returns:
+            List[int]: The row indices, in ascending order.
+        """
+        unresolved = [row_idx for row_idx, response in self._records.items() if classify_record(response) not in _RESOLVED_STATUSES]
+        return sorted(unresolved + self.missing_row_indices())
+
+    def request_line(self, row_idx: int) -> str:
+        """Return the raw request line that declared a row.
+
+        Args:
+            row_idx: The dataset row index to look up.
+
+        Returns:
+            str: The request as one line of JSON, terminated by a single newline.
+
+        Raises:
+            KeyError: If no request file declares the row.
+        """
+        return self._request_lines[row_idx] + "\n"
