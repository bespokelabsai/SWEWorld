@@ -0,0 +1,482 @@
+"""Durable ledger over the `responses_*.jsonl` files of a working directory.
+
+A run writes one durable line per terminal request: successes, empty parses,
+unparseable responses and permanent failures alike. This module owns the
+serialisation of those lines (`ledger_line` / `parse_ledger_line`), their
+classification (`classify_record`), the resolution of duplicate lines for the
+same request (`ResponseLedger`), and the two views the request processors need:
+`LedgerTally` for reporting and `ResumeState` for resuming a run.
+
+The ledger never writes and never invents a timestamp: everything it reports
+comes from lines that a request processor already wrote.
+"""
+
+from __future__ import annotations
+
+import dataclasses
+import enum
+import glob
+import json
+import os
+import re
+from typing import Iterable, Optional
+
+from pydantic import BaseModel, ValidationError
+
+from bespokelabs.curator.log import logger
+from bespokelabs.curator.types.generic_request import GenericRequest
+from bespokelabs.curator.types.generic_response import GenericResponse
+
+LEDGER_SCHEMA_VERSION: int = 2
+ERROR_SAMPLE_LIMIT: int = 5
+
+_FILE_INDEX_PATTERN = re.compile(r"_(\d+)\.jsonl$")
+
+
+class LedgerStatus(str, enum.Enum):
+    """The terminal state of a single durable record."""
+
+    SUCCEEDED = "succeeded"
+    EMPTY = "empty"
+    UNPARSEABLE = "unparseable"
+    FAILED = "failed"
+
+
+#: Highest precedence first. A record earlier in this tuple beats a record later
+#: in it when several lines describe the same request.
+STATUS_PRECEDENCE: tuple[LedgerStatus, ...] = (
+    LedgerStatus.SUCCEEDED,
+    LedgerStatus.EMPTY,
+    LedgerStatus.UNPARSEABLE,
+    LedgerStatus.FAILED,
+)
+
+#: Statuses that count as a completed request (they are never retried).
+_COMPLETED_STATUSES = (LedgerStatus.SUCCEEDED, LedgerStatus.EMPTY)
+
+
+class LedgerIntegrityError(ValueError):
+    """A durable record refers to a request that no requests_*.jsonl declares."""
+
+    def __init__(self, message: str, *, row_idx: int, source_file: str) -> None:
+        """Initialize the error.
+
+        Args:
+            message: Human readable description of the orphan record.
+            row_idx: The `original_row_idx` of the offending record.
+            source_file: Basename of the responses file the record came from.
+        """
+        super().__init__(message)
+        self.row_idx = row_idx
+        self.source_file = source_file
+
+
+def classify_record(response: GenericResponse) -> LedgerStatus:
+    """Classify a durable record into exactly one `LedgerStatus`.
+
+    The predicates are applied in this order: errors, then a missing response
+    message, then a missing parse, then an empty parse. Errors therefore
+    dominate rows, and an empty `response_errors` list is not an error.
+
+    Args:
+        response: The record to classify.
+
+    Returns:
+        LedgerStatus: The status of the record.
+    """
+    if response.response_errors:
+        return LedgerStatus.FAILED
+    if response.response_message is None:
+        return LedgerStatus.FAILED
+    if response.parsed_response_message is None:
+        return LedgerStatus.UNPARSEABLE
+    if len(response.parsed_response_message) == 0:
+        return LedgerStatus.EMPTY
+    return LedgerStatus.SUCCEEDED
+
+
+def _normalize_parsed_rows(rows: Optional[list]) -> Optional[list]:
+    """Normalize the rows a `parse_func` produced into JSON-ready dicts.
+
+    Args:
+        rows: The parsed rows, or None if the record has no parse.
+
+    Returns:
+        Optional[list]: The normalized rows, or None.
+
+    Raises:
+        ValueError: If a row is neither a pydantic model nor a dict.
+    """
+    if rows is None:
+        return None
+
+    normalized = []
+    for row in rows:
+        if isinstance(row, BaseModel):
+            normalized.append(row.model_dump(mode="json"))
+        elif isinstance(row, dict):
+            normalized.append(row)
+        else:
+            raise ValueError(f"Got invalid row {row} of type {type(row)} from `parse_func`. This should be type <class 'dict'>.")
+    return normalized
+
+
+def ledger_line(response: GenericResponse) -> str:
+    """Serialize one durable record to its canonical ledger line.
+
+    The `response_message` is kept as the raw value the provider returned, so a
+    structured response stays the JSON string rather than the validated model.
+    The parsed rows are normalized to dicts at write time.
+
+    Args:
+        response: The record to serialize.
+
+    Returns:
+        str: The serialized record, ending with exactly one newline.
+    """
+    payload = response.model_dump(mode="json")
+
+    raw_response_message = response.response_message
+    if isinstance(raw_response_message, BaseModel):
+        raw_response_message = raw_response_message.model_dump(mode="json")
+    payload["response_message"] = raw_response_message
+    payload["parsed_response_message"] = _normalize_parsed_rows(response.parsed_response_message)
+
+    return json.dumps(payload, default=str) + "\n"
+
+
+def parse_ledger_line(line: str) -> Optional[GenericResponse]:
+    """Parse one ledger line back into a `GenericResponse`.
+
+    Args:
+        line: The line to parse.
+
+    Returns:
+        Optional[GenericResponse]: The record, or None if the line is blank or
+            is not a valid `GenericResponse` JSON object.
+    """
+    if line is None or not line.strip():
+        return None
+    try:
+        return GenericResponse.model_validate_json(line)
+    except (json.JSONDecodeError, ValidationError, ValueError):
+        return None
+
+
+@dataclasses.dataclass(frozen=True)
+class LedgerTally:
+    """A count of every request a working directory knows about.
+
+    Every field counts unique `original_row_idx` values except
+    `n_duplicate_lines` and `n_malformed_lines` (which count lines) and
+    `n_dataset_rows` (which counts `parse_func` rows).
+    """
+
+    n_requests: int
+    n_declared_requests: int
+    n_recorded: int
+    n_succeeded: int
+    n_failed: int
+    n_missing: int
+    n_duplicate_lines: int
+    n_malformed_lines: int
+    n_dataset_rows: int
+    error_sample: tuple[str, ...]
+    schema_version: int = LEDGER_SCHEMA_VERSION
+
+
+@dataclasses.dataclass(frozen=True)
+class ResumeState:
+    """The single-file view a request processor needs to resume a run."""
+
+    completed_row_indices: frozenset[int]
+    retryable_row_indices: frozenset[int]
+    n_dataset_rows: int
+
+
+@dataclasses.dataclass(frozen=True)
+class _LedgerRecord:
+    """One durable line, with the position that breaks precedence ties."""
+
+    response: GenericResponse
+    status: LedgerStatus
+    file_index: int
+    line_number: int
+    source_file: str
+
+    @property
+    def row_idx(self) -> int:
+        """The `original_row_idx` of the request this record answers."""
+        return self.response.generic_request.original_row_idx
+
+    @property
+    def rank(self) -> int:
+        """The precedence rank of this record's status, lower is better."""
+        return STATUS_PRECEDENCE.index(self.status)
+
+
+def _natural_sort_key(path: str) -> tuple:
+    """Sort key ordering `responses_2.jsonl` before `responses_10.jsonl`.
+
+    Args:
+        path: Path to a numbered jsonl file.
+
+    Returns:
+        tuple: A key usable with `sorted`.
+    """
+    basename = os.path.basename(path)
+    match = _FILE_INDEX_PATTERN.search(basename)
+    if match is None:
+        return (1, 0, basename)
+    return (0, int(match.group(1)), basename)
+
+
+def _natural_file_index(path: str) -> int:
+    """The integer N parsed out of a `<name>_N.jsonl` path, -1 if there is none.
+
+    Args:
+        path: Path to a numbered jsonl file.
+
+    Returns:
+        int: The natural index of the file.
+    """
+    match = _FILE_INDEX_PATTERN.search(os.path.basename(path))
+    return int(match.group(1)) if match else -1
+
+
+def _iter_file_records(response_file: str) -> Iterable[Optional[_LedgerRecord]]:
+    """Yield every line of one responses file, in the order it was written.
+
+    Args:
+        response_file: Path to the responses file to read.
+
+    Yields:
+        Optional[_LedgerRecord]: The record, or None for a malformed line.
+    """
+    file_index = _natural_file_index(response_file)
+    source_file = os.path.basename(response_file)
+    with open(response_file, "r") as f:
+        for line_number, line in enumerate(f):
+            response = parse_ledger_line(line)
+            if response is None:
+                yield None
+                continue
+            yield _LedgerRecord(
+                response=response,
+                status=classify_record(response),
+                file_index=file_index,
+                line_number=line_number,
+                source_file=source_file,
+            )
+
+
+def _better(candidate: _LedgerRecord, incumbent: Optional[_LedgerRecord]) -> bool:
+    """Whether `candidate` should replace `incumbent` as the winning record.
+
+    Args:
+        candidate: The record being considered.
+        incumbent: The current winner for the same request, if any.
+
+    Returns:
+        bool: True if the candidate wins.
+    """
+    if incumbent is None:
+        return True
+    return candidate.rank < incumbent.rank
+
+
+def read_resume_state(response_file: str) -> ResumeState:
+    """Read a single responses file into a `ResumeState`.
+
+    Never writes to the file and never raises `LedgerIntegrityError`: no request
+    file is consulted, so no record can be an orphan here.
+
+    Args:
+        response_file: Path to the responses file to read.
+
+    Returns:
+        ResumeState: The completed and retryable request indices of that file.
+    """
+    if not os.path.exists(response_file):
+        return ResumeState(completed_row_indices=frozenset(), retryable_row_indices=frozenset(), n_dataset_rows=0)
+
+    winners: dict[int, _LedgerRecord] = {}
+    n_malformed_lines = 0
+    for record in _iter_file_records(response_file):
+        if record is None:
+            n_malformed_lines += 1
+            continue
+        if _better(record, winners.get(record.row_idx)):
+            winners[record.row_idx] = record
+
+    completed = frozenset(idx for idx, record in winners.items() if record.status in _COMPLETED_STATUSES)
+    retryable = frozenset(winners) - completed
+    n_dataset_rows = sum(len(winners[idx].response.parsed_response_message) for idx in completed)
+
+    logger.info(f"Found {len(completed)} completed, {len(retryable)} retryable and {n_malformed_lines} malformed lines in {response_file}")
+
+    return ResumeState(completed_row_indices=completed, retryable_row_indices=retryable, n_dataset_rows=n_dataset_rows)
+
+
+class ResponseLedger:
+    """The durable record of every request and response in a working directory.
+
+    Duplicate lines for one request are folded to a single winning record: the
+    record with the best status wins, and ties go to the earliest line in
+    `(natural file index, line number)` order.
+    """
+
+    def __init__(self, working_dir: str) -> None:
+        """Initialize an empty ledger.
+
+        Args:
+            working_dir: Directory holding the requests, metadata and responses files.
+        """
+        self.working_dir = working_dir
+        self._request_lines: dict[int, str] = {}
+        self._declared_requests: int = 0
+        self._winners: dict[int, _LedgerRecord] = {}
+        self._n_parsed_lines: int = 0
+        self._n_malformed_lines: int = 0
+
+    @classmethod
+    def load(cls, working_dir: str) -> "ResponseLedger":
+        """Read every request, metadata and responses file under a working directory.
+
+        Args:
+            working_dir: Directory to read.
+
+        Returns:
+            ResponseLedger: The loaded ledger, with duplicates already resolved.
+
+        Raises:
+            LedgerIntegrityError: If a durable record refers to a request that no
+                requests file declares.
+        """
+        ledger = cls(working_dir)
+        ledger._load_requests()
+        ledger._load_responses()
+        return ledger
+
+    def _load_requests(self) -> None:
+        """Read the requests and metadata files into the ledger."""
+        request_files = sorted(glob.glob(os.path.join(self.working_dir, "requests_*.jsonl")), key=_natural_sort_key)
+        for request_file in request_files:
+            self._declared_requests += self._read_declared_requests(request_file)
+            with open(request_file, "r") as f:
+                for line in f:
+                    if not line.strip():
+                        continue
+                    try:
+                        request = GenericRequest.model_validate_json(line)
+                    except (json.JSONDecodeError, ValidationError):
+                        logger.warning(f"Skipping request line that could not be parsed in {request_file}")
+                        continue
+                    self._request_lines.setdefault(request.original_row_idx, line.rstrip("\n") + "\n")
+
+    def _read_declared_requests(self, request_file: str) -> int:
+        """Read `num_jobs` from the metadata file of a request file.
+
+        Args:
+            request_file: Path to the request file.
+
+        Returns:
+            int: The declared number of jobs, 0 if the metadata is missing or unreadable.
+        """
+        metadata_file = request_file.replace("requests_", "metadata_").replace(".jsonl", ".json")
+        try:
+            with open(metadata_file, "r") as f:
+                return int(json.load(f)["num_jobs"])
+        except (OSError, json.JSONDecodeError, KeyError, TypeError, ValueError):
+            logger.debug(f"Could not read the number of declared requests from {metadata_file}")
+            return 0
+
+    def _load_responses(self) -> None:
+        """Read every responses file, resolving duplicates as it goes.
+
+        Raises:
+            LedgerIntegrityError: If a record refers to an undeclared request.
+        """
+        response_files = sorted(glob.glob(os.path.join(self.working_dir, "responses_*.jsonl")), key=_natural_sort_key)
+        for response_file in response_files:
+            for record in _iter_file_records(response_file):
+                if record is None:
+                    self._n_malformed_lines += 1
+                    continue
+                if record.row_idx not in self._request_lines:
+                    raise LedgerIntegrityError(
+                        f"Response for request {record.row_idx} in {record.source_file} is not declared by any request file in {self.working_dir}",
+                        row_idx=record.row_idx,
+                        source_file=record.source_file,
+                    )
+                self._n_parsed_lines += 1
+                if _better(record, self._winners.get(record.row_idx)):
+                    self._winners[record.row_idx] = record
+
+    def tally(self) -> LedgerTally:
+        """Count every request the working directory knows about.
+
+        Returns:
+            LedgerTally: The counts, in requests.
+        """
+        succeeded_indices = [idx for idx, record in self._winners.items() if record.status in _COMPLETED_STATUSES]
+        n_recorded = len(self._winners)
+        n_succeeded = len(succeeded_indices)
+        n_dataset_rows = sum(len(self._winners[idx].response.parsed_response_message) for idx in succeeded_indices)
+
+        error_sample = tuple(
+            str(self._winners[idx].response.response_errors) for idx in sorted(self._winners) if self._winners[idx].status is LedgerStatus.FAILED
+        )[:ERROR_SAMPLE_LIMIT]
+
+        return LedgerTally(
+            n_requests=len(self._request_lines),
+            n_declared_requests=self._declared_requests,
+            n_recorded=n_recorded,
+            n_succeeded=n_succeeded,
+            n_failed=n_recorded - n_succeeded,
+            n_missing=len(self._request_lines) - n_recorded,
+            n_duplicate_lines=self._n_parsed_lines - n_recorded,
+            n_malformed_lines=self._n_malformed_lines,
+            n_dataset_rows=n_dataset_rows,
+            error_sample=error_sample,
+        )
+
+    def winning_records(self) -> list[GenericResponse]:
+        """The winning record of every recorded request.
+
+        Returns:
+            list[GenericResponse]: The records, ascending `original_row_idx`.
+        """
+        return [self._winners[idx].response for idx in sorted(self._winners)]
+
+    def missing_row_indices(self) -> list[int]:
+        """Declared requests that have no durable record at all.
+
+        Returns:
+            list[int]: The indices, ascending.
+        """
+        return sorted(set(self._request_lines) - set(self._winners))
+
+    def unresolved_row_indices(self) -> list[int]:
+        """Requests that did not produce an answer: failures, bad parses and missing rows.
+
+        Returns:
+            list[int]: The indices, ascending.
+        """
+        unresolved = {idx for idx, record in self._winners.items() if record.status not in _COMPLETED_STATUSES}
+        unresolved.update(self.missing_row_indices())
+        return sorted(unresolved)
+
+    def request_line(self, row_idx: int) -> str:
+        """The verbatim source line of a request.
+
+        Args:
+            row_idx: The `original_row_idx` of the request.
+
+        Returns:
+            str: The request line, ending with exactly one newline.
+
+        Raises:
+            KeyError: If no request file declares that index.
+        """
+        return self._request_lines[row_idx]
