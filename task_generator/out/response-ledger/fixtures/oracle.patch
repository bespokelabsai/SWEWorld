+def _read_ledger_tally(working_dir: str) -> Optional["LedgerTally"]:
+    """Read the durable response ledger of a run, if it can be read.
+
+    Args:
+        working_dir: The run cache directory holding the request and response files.
+
+    Returns:
+        Optional[LedgerTally]: The tally, or None if the ledger could not be read,
+            in which case the reported stats fall back to the tracker counters.
+    """
+    try:
+        return ResponseLedger.load(working_dir).tally()
+    except (OSError, ValueError) as e:
+        logger.warning(f"Could not read the response ledger in {working_dir}, reporting statistics from the tracker instead :: {e}")
+        return None
+
