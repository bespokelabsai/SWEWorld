@@ -0,0 +1,467 @@
+"""Durable ledger over the request/metadata/response files of a single run.
+
+A run's working directory holds triples of files: ``requests_N.jsonl`` declaring the
+requests that were issued, ``metadata_N.json`` recording how many jobs each request
+file is supposed to hold, and ``responses_N.jsonl`` holding one durable record per
+terminal response. The response files are append-only logs, so the same request can
+show up more than once (a retry, a resubmitted batch, an interrupted run that was
+resumed). This module folds those logs down to exactly one winning record per
+request and reports what is still outstanding.
+"""
+
+import dataclasses
+import enum
+import glob
+import json
+import os
+import re
+import typing as t
+
+from pydantic import BaseModel, ValidationError
+
+from bespokelabs.curator.log import logger
+from bespokelabs.curator.types.generic_response import GenericResponse
+
+LEDGER_SCHEMA_VERSION: int = 1
+"""Version of the on-disk ledger line format, reported by :class:`LedgerTally`."""
+
+ERROR_SAMPLE_LIMIT: int = 10
+"""Maximum number of error strings collected into :attr:`LedgerTally.error_sample`."""
+
+_FILE_INDEX_PATTERN = re.compile(r"_(\d+)\.[^.]+$")
+
+
+class LedgerStatus(str, enum.Enum):
+    """Terminal status of a single durable response record.
+
+    Attributes:
+        SUCCEEDED: The request came back and parsed into at least one dataset row.
+        EMPTY: The request came back and parsed into zero dataset rows.
+        UNPARSEABLE: A response body arrived but never parsed into rows.
+        FAILED: The request errored out or never produced a response message.
+    """
+
+    SUCCEEDED = "succeeded"
+    EMPTY = "empty"
+    UNPARSEABLE = "unparseable"
+    FAILED = "failed"
+
+
+# Lower rank wins when the same request has more than one durable record.
+_STATUS_RANK: t.Dict[LedgerStatus, int] = {
+    LedgerStatus.SUCCEEDED: 0,
+    LedgerStatus.EMPTY: 1,
+    LedgerStatus.UNPARSEABLE: 2,
+    LedgerStatus.FAILED: 3,
+}
+
+# A request is done when its winning record has one of these statuses, and is worth
+# reissuing otherwise.
+_COMPLETED_STATUSES = frozenset({LedgerStatus.SUCCEEDED, LedgerStatus.EMPTY})
+
+
+def classify_record(response: GenericResponse) -> LedgerStatus:
+    """Classify a single durable response record.
+
+    Args:
+        response: The response record to classify.
+
+    Returns:
+        LedgerStatus: The terminal status of the record.
+    """
+    if response.response_errors or response.response_message is None:
+        return LedgerStatus.FAILED
+    if response.parsed_response_message is None:
+        return LedgerStatus.UNPARSEABLE
+    if len(response.parsed_response_message) == 0:
+        return LedgerStatus.EMPTY
+    return LedgerStatus.SUCCEEDED
+
+
+def _normalize_parsed_rows(parsed_response_message: t.Optional[list]) -> t.Optional[list]:
+    """Normalize parsed rows into plain JSON-serializable dicts.
+
+    Args:
+        parsed_response_message: Rows returned by the parse function, or None.
+
+    Returns:
+        The normalized rows, or None if there were none.
+
+    Raises:
+        ValueError: If a row is neither a pydantic model nor a dict.
+    """
+    if parsed_response_message is None:
+        return None
+
+    rows = []
+    for row in parsed_response_message:
+        if isinstance(row, BaseModel):
+            rows.append(row.model_dump(mode="json"))
+        elif isinstance(row, dict):
+            rows.append(row)
+        else:
+            raise ValueError(f"Got invalid row {row} of type {type(row)} from `parse_func`. This should be type <class 'dict'>.")
+    return rows
+
+
+def ledger_line(response: GenericResponse) -> str:
+    """Serialize a response into a single canonical ledger line.
+
+    The raw provider ``response_message`` is preserved as-is so that the record stays
+    replayable, while ``parsed_response_message`` is normalized to plain dicts.
+
+    Args:
+        response: The response to serialize.
+
+    Returns:
+        str: A JSON object terminated by exactly one newline.
+
+    Raises:
+        ValueError: If a parsed row is neither a pydantic model nor a dict.
+    """
+    rows = _normalize_parsed_rows(response.parsed_response_message)
+    dumped = response.model_dump(mode="json", exclude={"parsed_response_message"})
+    payload = {name: rows if name == "parsed_response_message" else dumped[name] for name in GenericResponse.model_fields}
+    return json.dumps(payload, default=str) + "\n"
+
+
+def parse_ledger_line(line: str) -> t.Optional[GenericResponse]:
+    """Parse a single ledger line back into a response.
+
+    Args:
+        line: The line to parse, with or without its trailing newline.
+
+    Returns:
+        Optional[GenericResponse]: The response, or None if the line is blank or invalid.
+    """
+    if not line or not line.strip():
+        return None
+    try:
+        return GenericResponse.model_validate_json(line)
+    except (json.JSONDecodeError, ValidationError, ValueError):
+        return None
+
+
+class LedgerIntegrityError(ValueError):
+    """Raised when the ledger contradicts the requests that were declared on disk.
+
+    Attributes:
+        row_idx: The dataset row index of the offending record.
+        source_file: The file the offending record was read from.
+    """
+
+    def __init__(self, message: str, row_idx: int, source_file: str):
+        """Initialize the error.
+
+        Args:
+            message: Human readable description of the inconsistency.
+            row_idx: The dataset row index of the offending record.
+            source_file: The file the offending record was read from.
+        """
+        super().__init__(message)
+        self.row_idx = row_idx
+        self.source_file = source_file
+
+
+@dataclasses.dataclass(frozen=True)
+class LedgerTally:
+    """Summary of a run's durable records.
+
+    Attributes:
+        n_requests: Number of request lines found across all request files.
+        n_declared_requests: Number of jobs the metadata files claim were written.
+        n_recorded: Number of requests with a durable record.
+        n_succeeded: Number of requests whose winning record succeeded or parsed empty.
+        n_failed: Number of requests whose winning record failed or never parsed.
+        n_missing: Number of declared requests with no durable record at all.
+        n_duplicate_lines: Number of response lines shadowed by a winning record.
+        n_malformed_lines: Number of response lines that could not be parsed.
+        n_dataset_rows: Number of parsed rows held by the winning records.
+        error_sample: Sample of the first errors encountered, for error messages.
+        schema_version: The ledger schema version the tally was produced with.
+    """
+
+    n_requests: int = 0
+    n_declared_requests: int = 0
+    n_recorded: int = 0
+    n_succeeded: int = 0
+    n_failed: int = 0
+    n_missing: int = 0
+    n_duplicate_lines: int = 0
+    n_malformed_lines: int = 0
+    n_dataset_rows: int = 0
+    error_sample: t.Tuple[str, ...] = ()
+    schema_version: int = LEDGER_SCHEMA_VERSION
+
+
+@dataclasses.dataclass(frozen=True)
+class ResumeState:
+    """The view of a single response file used to resume a run.
+
+    Attributes:
+        completed_row_indices: Rows that are done and must not be reissued.
+        retryable_row_indices: Rows that came back unusable and should be reissued.
+        n_dataset_rows: Number of parsed rows already recorded for completed rows.
+    """
+
+    completed_row_indices: t.FrozenSet[int] = frozenset()
+    retryable_row_indices: t.FrozenSet[int] = frozenset()
+    n_dataset_rows: int = 0
+
+
+@dataclasses.dataclass
+class _FoldedResponses:
+    """Winning records folded out of one or more response files."""
+
+    winners: t.Dict[int, GenericResponse] = dataclasses.field(default_factory=dict)
+    statuses: t.Dict[int, LedgerStatus] = dataclasses.field(default_factory=dict)
+    sources: t.Dict[int, str] = dataclasses.field(default_factory=dict)
+    n_duplicate_lines: int = 0
+    n_malformed_lines: int = 0
+
+
+def _file_index(path: str) -> int:
+    """Return the numeric suffix of a ``prefix_N.ext`` file, or -1 if it has none."""
+    match = _FILE_INDEX_PATTERN.search(os.path.basename(path))
+    return int(match.group(1)) if match else -1
+
+
+def _fold_response_files(response_files: t.List[str]) -> _FoldedResponses:
+    """Fold every response line of the given files down to one record per request.
+
+    The winner for a row index is the record with the best status, and ties are broken
+    by the earliest position in the append log rather than by the last line written.
+
+    Args:
+        response_files: Paths of the response files to read, in reading order.
+
+    Returns:
+        _FoldedResponses: The winning records and the counts of shadowed/bad lines.
+    """
+    folded = _FoldedResponses()
+    for response_file in response_files:
+        if not os.path.exists(response_file):
+            continue
+        with open(response_file, "r") as f:
+            for line in f:
+                if not line.strip():
+                    continue
+                response = parse_ledger_line(line)
+                if response is None:
+                    folded.n_malformed_lines += 1
+                    logger.warning(f"Skipping malformed ledger line in {response_file}")
+                    continue
+
+                row_idx = response.generic_request.original_row_idx
+                status = classify_record(response)
+                if row_idx not in folded.winners:
+                    folded.winners[row_idx] = response
+                    folded.statuses[row_idx] = status
+                    folded.sources[row_idx] = response_file
+                    continue
+
+                folded.n_duplicate_lines += 1
+                if _STATUS_RANK[status] < _STATUS_RANK[folded.statuses[row_idx]]:
+                    folded.winners[row_idx] = response
+                    folded.statuses[row_idx] = status
+                    folded.sources[row_idx] = response_file
+    return folded
+
+
+def _count_dataset_rows(response: GenericResponse) -> int:
+    """Return the number of parsed dataset rows held by a record."""
+    return len(response.parsed_response_message) if response.parsed_response_message else 0
+
+
+def read_resume_state(response_file: str) -> ResumeState:
+    """Read a response file to find out which requests still need to be issued.
+
+    The file is only ever read: failed records are left in place instead of being
+    rewritten, so an interrupted run never loses its history.
+
+    Args:
+        response_file: Path to the response file to read.
+
+    Returns:
+        ResumeState: Completed and retryable row indices plus the parsed row count.
+    """
+    if not os.path.exists(response_file):
+        return ResumeState()
+
+    logger.info(f"Resuming progress by reading existing file: {response_file}")
+    folded = _fold_response_files([response_file])
+
+    completed = set()
+    retryable = set()
+    n_dataset_rows = 0
+    for row_idx, status in folded.statuses.items():
+        if status in _COMPLETED_STATUSES:
+            completed.add(row_idx)
+            n_dataset_rows += _count_dataset_rows(folded.winners[row_idx])
+        else:
+            retryable.add(row_idx)
+
+    logger.info(
+        f"Found {len(completed)} completed requests and {len(retryable)} "
+        f"retryable requests and {folded.n_malformed_lines} parsing errors in {response_file}"
+    )
+    return ResumeState(
+        completed_row_indices=frozenset(completed),
+        retryable_row_indices=frozenset(retryable),
+        n_dataset_rows=n_dataset_rows,
+    )
+
+
+class ResponseLedger:
+    """Durable view of every request and response file of a single run.
+
+    Attributes:
+        working_dir: Directory holding the run's request/metadata/response files.
+    """
+
+    def __init__(
+        self,
+        working_dir: str,
+        request_lines: t.Optional[t.Dict[int, str]] = None,
+        n_declared_requests: int = 0,
+        folded: t.Optional[_FoldedResponses] = None,
+    ):
+        """Initialize the ledger. Prefer :meth:`load` over calling this directly.
+
+        Args:
+            working_dir: Directory holding the run's files.
+            request_lines: Map of row index to the request line that declared it.
+            n_declared_requests: Number of jobs the metadata files claim were written.
+            folded: The winning records folded out of the response files.
+        """
+        self.working_dir = working_dir
+        self._request_lines = request_lines if request_lines is not None else {}
+        self._n_declared_requests = n_declared_requests
+        self._folded = folded if folded is not None else _FoldedResponses()
+
+    @classmethod
+    def load(cls, working_dir: str) -> "ResponseLedger":
+        """Load the ledger from a working directory.
+
+        Args:
+            working_dir: Directory holding the run's request/metadata/response files.
+
+        Returns:
+            ResponseLedger: The loaded ledger.
+
+        Raises:
+            LedgerIntegrityError: If a durable record's row index is not declared by
+                any request file.
+        """
+        request_files = sorted(glob.glob(os.path.join(working_dir, "requests_*.jsonl")), key=_file_index)
+        response_files = sorted(glob.glob(os.path.join(working_dir, "responses_*.jsonl")), key=_file_index)
+
+        request_lines: t.Dict[int, str] = {}
+        n_declared_requests = 0
+        for request_file in request_files:
+            with open(request_file, "r") as f:
+                for line in f:
+                    if not line.strip():
+                        continue
+                    try:
+                        row_idx = json.loads(line)["original_row_idx"]
+                    except (json.JSONDecodeError, KeyError, TypeError):
+                        logger.warning(f"Skipping malformed request line in {request_file}")
+                        continue
+                    request_lines[row_idx] = line if line.endswith("\n") else line + "\n"
+
+            metadata_file = request_file.replace("requests_", "metadata_").replace(".jsonl", ".json")
+            if not os.path.exists(metadata_file):
+                logger.warning(f"Missing metadata file {metadata_file} for request file {request_file}")
+                continue
+            try:
+                with open(metadata_file, "r") as f:
+                    n_declared_requests += json.load(f).get("num_jobs", 0)
+            except (json.JSONDecodeError, TypeError, AttributeError):
+                logger.warning(f"Skipping invalid metadata file {metadata_file}")
+
+        folded = _fold_response_files(response_files)
+        for row_idx, source_file in folded.sources.items():
+            if row_idx not in request_lines:
+                raise LedgerIntegrityError(
+                    f"Response for row {row_idx} in {source_file} is not declared by any requests file in {working_dir}.",
+                    row_idx=row_idx,
+                    source_file=source_file,
+                )
+
+        return cls(working_dir, request_lines=request_lines, n_declared_requests=n_declared_requests, folded=folded)
+
+    def tally(self) -> LedgerTally:
+        """Summarize the ledger.
+
+        Returns:
+            LedgerTally: Counts over the declared requests and the winning records.
+        """
+        n_succeeded = 0
+        n_dataset_rows = 0
+        error_sample: t.List[str] = []
+        for row_idx in sorted(self._folded.winners):
+            response = self._folded.winners[row_idx]
+            if self._folded.statuses[row_idx] in _COMPLETED_STATUSES:
+                n_succeeded += 1
+            elif len(error_sample) < ERROR_SAMPLE_LIMIT and response.response_errors:
+                error_sample.append(str(response.response_errors))
+            n_dataset_rows += _count_dataset_rows(response)
+
+        n_recorded = len(self._folded.winners)
+        return LedgerTally(
+            n_requests=len(self._request_lines),
+            n_declared_requests=self._n_declared_requests,
+            n_recorded=n_recorded,
+            n_succeeded=n_succeeded,
+            n_failed=n_recorded - n_succeeded,
+            n_missing=len(self.missing_row_indices()),
+            n_duplicate_lines=self._folded.n_duplicate_lines,
+            n_malformed_lines=self._folded.n_malformed_lines,
+            n_dataset_rows=n_dataset_rows,
+            error_sample=tuple(error_sample),
+            schema_version=LEDGER_SCHEMA_VERSION,
+        )
+
+    def winning_records(self) -> t.List[GenericResponse]:
+        """Return the winning record of every recorded request.
+
+        Returns:
+            list[GenericResponse]: The records, ordered by ascending row index.
+        """
+        return [self._folded.winners[row_idx] for row_idx in sorted(self._folded.winners)]
+
+    def missing_row_indices(self) -> t.List[int]:
+        """Return the declared requests that have no durable record at all.
+
+        Returns:
+            list[int]: The row indices, in ascending order.
+        """
+        return sorted(row_idx for row_idx in self._request_lines if row_idx not in self._folded.winners)
+
+    def unresolved_row_indices(self) -> t.List[int]:
+        """Return the declared requests that did not end in a usable record.
+
+        Returns:
+            list[int]: Row indices that are missing or whose winning record failed or
+                never parsed, in ascending order.
+        """
+        return sorted(
+            row_idx
+            for row_idx in self._request_lines
+            if self._folded.statuses.get(row_idx) is None or self._folded.statuses[row_idx] not in _COMPLETED_STATUSES
+        )
+
+    def request_line(self, row_idx: int) -> str:
+        """Return the request line that declared a row index.
+
+        Args:
+            row_idx: The dataset row index to look up.
+
+        Returns:
+            str: The request line, terminated by exactly one newline.
+
+        Raises:
+            KeyError: If no request file declares that row index.
+        """
+        return self._request_lines[row_idx]
