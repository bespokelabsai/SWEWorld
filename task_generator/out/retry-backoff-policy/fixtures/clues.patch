diff --git a/src/bespokelabs/curator/request_processor/online/retry_policy.py b/src/bespokelabs/curator/request_processor/online/retry_policy.py
new file mode 100644
index 0000000..44162ed
--- /dev/null
+++ b/src/bespokelabs/curator/request_processor/online/retry_policy.py
@@ -0,0 +1,339 @@
+"""Failure classification and retry/backoff policy for online request processors.
+
+This module is deliberately dependency free: it holds the decision making for
+"what kind of failure was that, and what do we do about it" so the online
+request processors only have to hand it an exception and act on the verdict.
+It reads no clocks and draws no randomness of its own, both are injected.
+"""
+
+import enum
+import typing as t
+from dataclasses import dataclass
+
+if t.TYPE_CHECKING:
+    from bespokelabs.curator.status_tracker.online_status_tracker import OnlineStatusTracker
+
+# Number of rate limit failures a request may absorb before they start costing
+# it retry attempts. A throttle says nothing about the request itself, but a
+# permanently throttled key would otherwise re-queue forever.
+DEFAULT_THROTTLE_WAIVERS = 6
+
+
+class FailureClass(str, enum.Enum):
+    """The kind of failure an exception represents.
+
+    Attributes:
+        THROTTLE: The provider asked us to slow down, the request itself is fine.
+        TRANSIENT: Something broke that may well work on the next attempt.
+        CONTRACT: The response came back, but not in a shape we can use.
+        TERMINAL: Retrying cannot help, stop now.
+    """
+
+    THROTTLE = "throttle"
+    TRANSIENT = "transient"
+    CONTRACT = "contract"
+    TERMINAL = "terminal"
+
+
+_STATUS_CLASSES: dict[int, FailureClass] = {
+    400: FailureClass.CONTRACT,
+    413: FailureClass.CONTRACT,
+    422: FailureClass.CONTRACT,
+    401: FailureClass.TERMINAL,
+    403: FailureClass.TERMINAL,
+    404: FailureClass.TERMINAL,
+    408: FailureClass.TRANSIENT,
+    409: FailureClass.TRANSIENT,
+    425: FailureClass.TRANSIENT,
+    429: FailureClass.THROTTLE,
+    529: FailureClass.THROTTLE,
+}
+
+_EXCEPTION_NAME_CLASSES: dict[str, FailureClass] = {
+    "TimeoutError": FailureClass.TRANSIENT,
+    "ConnectionError": FailureClass.TRANSIENT,
+    "ClientConnectorError": FailureClass.TRANSIENT,
+    "ValueError": FailureClass.CONTRACT,
+    "ValidationError": FailureClass.CONTRACT,
+    "JSONDecodeError": FailureClass.CONTRACT,
+    "KeyError": FailureClass.CONTRACT,
+    "PermissionError": FailureClass.TERMINAL,
+    "NotImplementedError": FailureClass.TERMINAL,
+}
+
+_MESSAGE_MARKERS: tuple[tuple[str, FailureClass], ...] = (
+    ("rate limit", FailureClass.THROTTLE),
+    ("ratelimit", FailureClass.THROTTLE),
+    ("too many requests", FailureClass.THROTTLE),
+    ("overloaded", FailureClass.THROTTLE),
+    ("quota", FailureClass.THROTTLE),
+    ("timed out", FailureClass.TRANSIENT),
+    ("timeout", FailureClass.TRANSIENT),
+    ("connection reset", FailureClass.TRANSIENT),
+    ("temporarily unavailable", FailureClass.TRANSIENT),
+    ("response is empty", FailureClass.TRANSIENT),
+    ("invalid api key", FailureClass.TERMINAL),
+    ("authentication", FailureClass.TERMINAL),
+    ("permission denied", FailureClass.TERMINAL),
+)
+
+# base delay, growth factor and ceiling per failure class.
+_BACKOFF_SCHEDULE: dict[FailureClass, tuple[float, float, float]] = {
+    FailureClass.THROTTLE: (8.0, 2.0, 60.0),
+    FailureClass.TRANSIENT: (0.5, 3.0, 20.0),
+    FailureClass.CONTRACT: (0.0, 1.0, 0.0),
+    FailureClass.TERMINAL: (0.0, 1.0, 0.0),
+}
+
+# How much of the retry budget a single failure of each class costs. A throttle
+# is free while the request still has waivers left, see RetryPolicy.decide.
+_ATTEMPT_COSTS: dict[FailureClass, int] = {
+    FailureClass.THROTTLE: 1,
+    FailureClass.TRANSIENT: 1,
+    FailureClass.CONTRACT: 2,
+    FailureClass.TERMINAL: 0,
+}
+
+
+def _status_of(exc: BaseException) -> t.Optional[int]:
+    status = getattr(exc, "status_code", None)
+    if status is None:
+        status = getattr(exc, "status", None)
+    return status if isinstance(status, int) else None
+
+
+def classify_failure(exc: BaseException) -> FailureClass:
+    """Classify an exception into the failure class that decides how we react to it.
+
+    Four signals are consulted in order and the first one that yields a class
+    wins: the HTTP status carried by the exception, the exception type, markers
+    in the exception message, and finally a TRANSIENT default. This never
+    raises, an unrecognisable failure is simply transient.
+
+    Args:
+        exc: The exception raised while processing a request.
+
+    Returns:
+        The failure class of the exception.
+    """
+    try:
+        status = _status_of(exc)
+        if status is not None:
+            if status in _STATUS_CLASSES:
+                return _STATUS_CLASSES[status]
+            if 500 <= status <= 599:
+                return FailureClass.TRANSIENT
+
+        for klass in type(exc).__mro__:
+            failure_class = _EXCEPTION_NAME_CLASSES.get(klass.__name__)
+            if failure_class is not None:
+                return failure_class
+
+        message = str(exc).lower()
+        for marker, failure_class in _MESSAGE_MARKERS:
+            if marker in message:
+                return failure_class
+    except Exception:  # classification must never add a failure of its own
+        return FailureClass.TRANSIENT
+
+    return FailureClass.TRANSIENT
+
+
+@dataclass(frozen=True)
+class RetryVerdict:
+    """What the policy decided about a single failed attempt.
+
+    Attributes:
+        should_retry: Whether the request should go back on the retry queue.
+        failure_class: The class the failure was sorted into.
+        attempt_index: 1-based index of the attempt that just failed.
+        delay_seconds: How long to wait before the retry, 0.0 when not retrying.
+        attempts_left: Retry budget remaining after this failure, never negative.
+        throttle_waivers_after: Free rate limit passes remaining after this failure.
+        reason: Two part reason code, "<failure class>:<retry|exhausted|abort>".
+    """
+
+    should_retry: bool
+    failure_class: FailureClass
+    attempt_index: int
+    delay_seconds: float
+    attempts_left: int
+    throttle_waivers_after: int
+    reason: str
+
+
+class RetryPolicy:
+    """Turns a failure into a retry decision, a backoff and a tracker update.
+
+    Args:
+        clock: Returns the current time in seconds, only read for rate limits.
+        jitter: Returns a jitter factor in [0.0, 1.0], only read for a positive delay.
+    """
+
+    def __init__(self, clock: t.Callable[[], float], jitter: t.Callable[[], float]):
+        """Initialize the RetryPolicy with its injected clock and jitter source."""
+        self._clock = clock
+        self._jitter = jitter
+
+    def delay_for(self, failure_class: FailureClass, attempt_index: int) -> float:
+        """Compute how long to wait before retrying an attempt that just failed.
+
+        The exponential backoff is clamped to the class ceiling before jitter is
+        applied, so the jittered delay never exceeds the ceiling. The jitter
+        source is drawn exactly once, and only when there is a delay to jitter.
+
+        Args:
+            failure_class: The class of the failure being retried.
+            attempt_index: 1-based index of the attempt that just failed.
+
+        Returns:
+            The number of seconds to wait, rounded to milliseconds.
+
+        Raises:
+            ValueError: If attempt_index is not at least 1.
+        """
+        if attempt_index < 1:
+            raise ValueError(f"attempt_index must be >= 1, got {attempt_index}")
+
+        base, factor, cap = _BACKOFF_SCHEDULE[failure_class]
+        raw = min(cap, base * factor ** (attempt_index - 1))
+        if raw <= 0:
+            return 0.0
+
+        jitter = min(1.0, max(0.0, self._jitter()))
+        return round(raw * (0.5 + 0.5 * jitter), 3)
+
+    def decide(
+        self,
+        exc: BaseException,
+        *,
+        attempts_made: int,
+        attempts_left: int,
+        throttle_waivers_left: int = DEFAULT_THROTTLE_WAIVERS,
+    ) -> RetryVerdict:
+        """Decide what to do about a failed attempt.
+
+        The cost of the failure comes off the budget first and the decision is
+        made against what is actually left, so a request can never hand out a
+        retry it cannot pay for. Rate limits are free while the request still
+        holds waivers, but every rate limit spends one.
+
+        Args:
+            exc: The exception raised by the attempt.
+            attempts_made: How many attempts had already failed before this one.
+            attempts_left: Retry budget the request held before this failure.
+            throttle_waivers_left: Free rate limit passes the request held.
+
+        Returns:
+            The verdict for this failure.
+        """
+        failure_class = classify_failure(exc)
+        attempt_index = attempts_made + 1
+
+        if failure_class is FailureClass.TERMINAL:
+            # Nothing to retry into, so whatever budget is left is worth nothing.
+            return RetryVerdict(
+                should_retry=False,
+                failure_class=failure_class,
+                attempt_index=attempt_index,
+                delay_seconds=0.0,
+                attempts_left=0,
+                throttle_waivers_after=throttle_waivers_left,
+                reason=f"{failure_class.value}:abort",
+            )
+
+        throttle_waivers_after = throttle_waivers_left
+        cost = _ATTEMPT_COSTS[failure_class]
+        if failure_class is FailureClass.THROTTLE:
+            throttle_waivers_after = max(0, throttle_waivers_left - 1)
+            if throttle_waivers_left > 0:
+                cost = 0
+
+        remaining = attempts_left - cost
+        if remaining < 0:
+            return RetryVerdict(
+                should_retry=False,
+                failure_class=failure_class,
+                attempt_index=attempt_index,
+                delay_seconds=0.0,
+                attempts_left=0,
+                throttle_waivers_after=throttle_waivers_after,
+                reason=f"{failure_class.value}:exhausted",
+            )
+
+        return RetryVerdict(
+            should_retry=True,
+            failure_class=failure_class,
+            attempt_index=attempt_index,
+            delay_seconds=self.delay_for(failure_class, attempt_index),
+            attempts_left=remaining,
+            throttle_waivers_after=throttle_waivers_after,
+            reason=f"{failure_class.value}:retry",
+        )
+
+    def record_verdict(self, status_tracker: "OnlineStatusTracker", verdict: RetryVerdict) -> None:
+        """Record a verdict on the status tracker, bumping exactly one counter.
+
+        Only a rate limit moves the throttle window, and it takes a single clock
+        reading for both the stamp and the end of the window.
+
+        Args:
+            status_tracker: Tracker to record the failure on.
+            verdict: The verdict to record.
+        """
+        if verdict.failure_class is FailureClass.THROTTLE:
+            now = self._clock()
+            status_tracker.num_rate_limit_errors += 1
+            status_tracker.time_of_last_rate_limit_error = now
+            # The window only ever moves further out, a short throttle landing
+            # behind a long one must not pull it back in.
+            status_tracker.throttle_cooldown_until = max(status_tracker.throttle_cooldown_until, now + verdict.delay_seconds)
+        elif verdict.failure_class is FailureClass.CONTRACT:
+            status_tracker.num_other_errors += 1
+        else:
+            status_tracker.num_api_errors += 1
+
+
+def remaining_cooldown_seconds(status_tracker: "OnlineStatusTracker", now: float) -> float:
+    """Seconds a caller must still wait before issuing more requests.
+
+    Args:
+        status_tracker: Tracker holding the throttle window.
+        now: The current time, in the same units as the window.
+
+    Returns:
+        The remaining cooldown, 0.0 once the window has passed or was never set.
+    """
+    return round(max(0.0, status_tracker.throttle_cooldown_until - now), 3)
+
+
+def format_failure_summary(failure_log: t.Sequence[tuple[FailureClass, str]]) -> list[str]:
+    """Summarise a request's failures, most frequent first.
+
+    Args:
+        failure_log: The (failure class, message) pairs recorded for a request.
+
+    Returns:
+        One entry per distinct pair, ordered by count descending with ties
+        broken by first occurrence.
+    """
+    counts: dict[tuple[FailureClass, str], int] = {}
+    for failure_class, message in failure_log:
+        key = (failure_class, message)
+        counts[key] = counts.get(key, 0) + 1
+
+    ordered = sorted(counts.items(), key=lambda item: -item[1])
+    return [f"[{failure_class.value}] {message} (x{count})" for (failure_class, message), count in ordered]
+
+
+def format_attempt_label(attempts_made: int, max_retries: int) -> str:
+    """Label the attempt that is about to be made, or that just failed.
+
+    Args:
+        attempts_made: How many attempts have already failed.
+        max_retries: The configured number of retries.
+
+    Returns:
+        A label of the form "attempt #2 of 6".
+    """
+    return f"attempt #{attempts_made + 1} of {max_retries + 1}"
