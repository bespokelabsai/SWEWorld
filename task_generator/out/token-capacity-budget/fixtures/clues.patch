--- /dev/null
+++ b/src/bespokelabs/curator/status_tracker/capacity_budget.py
@@ -0,0 +1,159 @@
+"""Capacity budget primitives for the online request path.
+
+This module owns the two halves of rate limit bookkeeping: decoding the limit
+headers a provider sends back, and the constants the status tracker uses to
+seed, refill and settle its per-minute buckets.
+"""
+
+import math
+import re
+import typing as t
+from dataclasses import dataclass
+from enum import Enum
+
+from bespokelabs.curator.types.token_usage import _TokenUsage
+
+# Limits used when nobody told us what the provider allows.
+DEFAULT_MAX_REQUESTS_PER_MINUTE = 200
+DEFAULT_MAX_TOKENS_PER_MINUTE_COMBINED = 100_000
+DEFAULT_MAX_INPUT_TOKENS_PER_MINUTE = 100_000
+DEFAULT_MAX_OUTPUT_TOKENS_PER_MINUTE = 40_000
+
+# Where an effective limit came from.
+LIMIT_ORIGIN_CONFIGURED = "configured"
+LIMIT_ORIGIN_DEFAULTED = "defaulted"
+LIMIT_ORIGIN_UNLIMITED = "unlimited"
+
+# An under estimate is carried into the next minute as debt, but only down to
+# this share of the axis' per-minute limit.
+CAPACITY_DEBT_FLOOR_FRACTION = 0.25
+
+# Limit headers we know about, in the order they are consulted.
+REQUEST_LIMIT_HEADERS = ("x-ratelimit-limit-requests", "anthropic-ratelimit-requests-limit")
+INPUT_TOKEN_LIMIT_HEADERS = ("x-ratelimit-limit-input-tokens", "anthropic-ratelimit-input-tokens-limit")
+OUTPUT_TOKEN_LIMIT_HEADERS = ("x-ratelimit-limit-output-tokens", "anthropic-ratelimit-output-tokens-limit")
+TOTAL_TOKEN_LIMIT_HEADERS = ("x-ratelimit-limit-tokens", "anthropic-ratelimit-tokens-limit")
+
+_LIMIT_VALUE_PATTERN = re.compile(r"^(\d+(?:\.\d+)?)([kKmM]?)$")
+_LIMIT_SUFFIX_MULTIPLIERS = {"": 1, "k": 1_000, "m": 1_000_000}
+
+
+class TokenLimitStrategy(str, Enum):
+    """Token limit Strategy enum."""
+
+    combined = "combined"
+    seperate = "seperate"
+    default = "combined"
+
+
+class CapacityExceedsLimitError(ValueError):
+    """Raised when a request could never fit inside a per-minute limit.
+
+    Attributes:
+        axis: The capacity axis that cannot hold the request
+        requested: Capacity the request asked for on that axis
+        limit: Per-minute limit of that axis
+    """
+
+    def __init__(self, axis: str, requested: int, limit: float):
+        """Initialize the CapacityExceedsLimitError."""
+        self.axis = axis
+        self.requested = requested
+        self.limit = limit
+        super().__init__(f"request needs {requested} {axis} capacity but the per-minute limit is {int(limit)}")
+
+
+@dataclass(frozen=True)
+class RateLimitReading:
+    """Rate limits decoded from a provider's response headers.
+
+    Attributes:
+        max_requests_per_minute: Request limit, or None when no header carried one
+        max_tokens_per_minute: Token limit, split per axis under the `seperate` strategy
+        token_limit_strategy: Strategy the decoded token limits are expressed in
+        source_headers: Names of the headers the reading was built from
+    """
+
+    max_requests_per_minute: int | None
+    max_tokens_per_minute: int | _TokenUsage | None
+    token_limit_strategy: TokenLimitStrategy
+    source_headers: tuple[str, ...]
+
+
+def parse_limit_value(raw: object) -> int | None:
+    """Decode a single rate limit header value.
+
+    Args:
+        raw: The raw header value, typically a string such as "1.5k"
+
+    Returns:
+        The limit as a positive int, or None when the value carries no usable
+        limit. A malformed header is absent, not fatal, so nothing is raised.
+    """
+    if isinstance(raw, bool):
+        return None
+    if isinstance(raw, int):
+        return raw if raw > 0 else None
+    if not isinstance(raw, str):
+        return None
+
+    match = _LIMIT_VALUE_PATTERN.match(raw.strip())
+    if match is None:
+        return None
+
+    value = math.floor(float(match.group(1)) * _LIMIT_SUFFIX_MULTIPLIERS[match.group(2).lower()])
+    return value if value > 0 else None
+
+
+def _first_parsed_header(headers: t.Mapping[str, object], names: tuple[str, ...]) -> tuple[str | None, int | None]:
+    """Return the first header name in `names` that carries a usable limit."""
+    for name in names:
+        if name in headers:
+            value = parse_limit_value(headers[name])
+            if value is not None:
+                return name, value
+    return None, None
+
+
+def read_rate_limit_headers(headers: t.Mapping[str, object]) -> RateLimitReading:
+    """Decode the rate limit headers of a provider response.
+
+    Args:
+        headers: Response headers, matched case insensitively
+
+    Returns:
+        RateLimitReading: The limits the headers carried. Only limit headers are
+            consulted, and no defaults are substituted, that is the tracker's job.
+    """
+    lowered = {str(name).lower(): value for name, value in headers.items()}
+
+    request_header, max_requests_per_minute = _first_parsed_header(lowered, REQUEST_LIMIT_HEADERS)
+    input_header, input_tokens = _first_parsed_header(lowered, INPUT_TOKEN_LIMIT_HEADERS)
+    output_header, output_tokens = _first_parsed_header(lowered, OUTPUT_TOKEN_LIMIT_HEADERS)
+    total_header, total_tokens = _first_parsed_header(lowered, TOTAL_TOKEN_LIMIT_HEADERS)
+
+    source_headers = () if request_header is None else (request_header,)
+
+    # A full input/output pair is a separate limit, anything else is combined.
+    if input_tokens is not None and output_tokens is not None:
+        return RateLimitReading(
+            max_requests_per_minute=max_requests_per_minute,
+            max_tokens_per_minute=_TokenUsage(input=input_tokens, output=output_tokens),
+            token_limit_strategy=TokenLimitStrategy.seperate,
+            source_headers=source_headers + (input_header, output_header),
+        )
+
+    if total_tokens is not None:
+        return RateLimitReading(
+            max_requests_per_minute=max_requests_per_minute,
+            max_tokens_per_minute=total_tokens,
+            token_limit_strategy=TokenLimitStrategy.combined,
+            source_headers=source_headers + (total_header,),
+        )
+
+    return RateLimitReading(
+        max_requests_per_minute=max_requests_per_minute,
+        max_tokens_per_minute=None,
+        token_limit_strategy=TokenLimitStrategy.combined,
+        source_headers=source_headers,
+    )
