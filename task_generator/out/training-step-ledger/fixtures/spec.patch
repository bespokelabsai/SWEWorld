@@ -0,0 +1,417 @@
+"""Step ledger: one definition of a training step, checkpoint identity, and resume contract.
+
+A training run is described by a :class:`StepPlan`, built once at the start of
+``train()`` from the dataset and the trainer config. The plan is the single source of
+truth for what a *step* means: batches are the unit of work, optimizer steps are the
+unit of the schedule (``total_steps``, ``warmup_steps``, ``log_every_n_steps``,
+``checkpoint_every_n_steps``), and a gradient accumulation window may span an epoch
+boundary because it is counted over the whole run.
+
+Checkpoints record the shape they were taken in (batch size, accumulation width, and a
+content signature of the dataset), so :func:`plan_resume` can refuse a run that was
+reshaped underneath a checkpoint instead of silently restarting it.
+
+This module is a leaf: it imports nothing from the rest of ``finetune`` at runtime, and
+draws on no clock and no random source.
+"""
+
+import json
+import math
+from dataclasses import dataclass
+from typing import TYPE_CHECKING, Any, Dict, Mapping, Sequence, Tuple
+
+from xxhash import xxh64
+
+if TYPE_CHECKING:
+    from bespokelabs.curator.finetune.config import TinkerTrainerConfig
+    from bespokelabs.curator.finetune.types import CheckpointInfo
+
+# The unit of `StepPlan.total_steps`: one Adam update over an accumulation window.
+STEP_UNIT_OPTIMIZER = "optimizer_step"
+# The Fireworks unit: one managed, server-side packed pass per epoch.
+STEP_UNIT_PACKED = "packed_epoch_step"
+
+# Version tag of the dataset signature format, so a future format is never mistaken
+# for this one when an old checkpoint is validated against a new plan.
+DATASET_SIGNATURE_PREFIX = "ds1"
+
+# The complete vocabulary of checkpoint triggers, in ledger order (see
+# `canonical_reasons`): interval before epoch before final.
+CHECKPOINT_REASONS: Tuple[str, str, str] = ("interval", "epoch", "final")
+
+# Checkpoint names are derived from the step alone, zero-padded so they sort
+# lexicographically in the same order they were written.
+CHECKPOINT_NAME_TEMPLATE = "{prefix}-s{step:06d}"
+
+# Floor of the post-warmup linear decay, as a fraction of the base learning rate.
+MIN_LR_RATIO: float = 0.1
+
+
+class StepLedgerError(ValueError):
+    """Raised when a step plan cannot be built or a resume is not admissible."""
+
+
+class ResumePlanMismatch(StepLedgerError):  # noqa: N818 - named for the contract it enforces, not the failure it is
+    """Raised when a checkpoint does not describe a position in the current plan.
+
+    Attributes:
+        checkpoint_name: Name of the offending checkpoint.
+        mismatched_fields: Names of the fields that disagree, sorted alphabetically.
+        expected: The values the current plan implies.
+        found: The values recorded on the checkpoint.
+    """
+
+    def __init__(
+        self,
+        checkpoint_name: str,
+        mismatched_fields: Tuple[str, ...],
+        expected: Dict[str, Any],
+        found: Dict[str, Any],
+    ):
+        """Initialize the mismatch with the checkpoint and the fields that disagree."""
+        self.checkpoint_name = checkpoint_name
+        self.mismatched_fields = mismatched_fields
+        self.expected = expected
+        self.found = found
+        super().__init__(
+            f"Checkpoint {checkpoint_name!r} does not match the current training plan "
+            f"(mismatched: {', '.join(mismatched_fields)}; expected {expected}, found {found})"
+        )
+
+
+@dataclass(frozen=True)
+class StepPlan:
+    """The full shape of a training run, computed once before the first batch.
+
+    Attributes:
+        step_unit: What one step means (`STEP_UNIT_OPTIMIZER` or `STEP_UNIT_PACKED`).
+        num_examples: Number of examples in the dataset.
+        batch_size: Examples per batch.
+        epochs: Number of passes over the dataset.
+        gradient_accumulation_steps: Batches per optimizer step.
+        batches_per_epoch: Batches in one epoch (the last one may be short).
+        total_batches: Batches over the whole run.
+        total_steps: Optimizer steps over the whole run.
+        trailing_window_batches: Batches in the final accumulation window.
+        dataset_signature: Content signature of the dataset the plan was built from.
+    """
+
+    step_unit: str
+    num_examples: int
+    batch_size: int
+    epochs: int
+    gradient_accumulation_steps: int
+    batches_per_epoch: int
+    total_batches: int
+    total_steps: int
+    trailing_window_batches: int
+    dataset_signature: str
+
+    def step_of_batch(self, batch_ordinal: int) -> int:
+        """Return the 1-based optimizer step whose window contains a 1-based batch."""
+        return math.ceil(batch_ordinal / self.gradient_accumulation_steps)
+
+    def is_step_boundary(self, batch_ordinal: int) -> bool:
+        """Whether a 1-based batch closes its accumulation window (the final batch always does)."""
+        return batch_ordinal % self.gradient_accumulation_steps == 0 or batch_ordinal == self.total_batches
+
+    def epoch_of_batch(self, batch_ordinal: int) -> int:
+        """Return the 1-based epoch a 1-based batch belongs to."""
+        return (batch_ordinal - 1) // self.batches_per_epoch + 1
+
+    def batch_slice(self, batch_ordinal: int) -> Tuple[int, int]:
+        """Return the ``[start, end)`` slice of the example list covered by a 1-based batch."""
+        offset_in_epoch = (batch_ordinal - 1) % self.batches_per_epoch
+        start = offset_in_epoch * self.batch_size
+        return start, min(start + self.batch_size, self.num_examples)
+
+    def logging_steps(self, log_every_n_steps: int) -> Tuple[int, ...]:
+        """Return the steps at which the run logs, i.e. those divisible by ``log_every_n_steps``."""
+        if log_every_n_steps < 1:
+            return ()
+        return tuple(step for step in range(1, self.total_steps + 1) if step % log_every_n_steps == 0)
+
+    def loss_history_steps(self, log_every_n_steps: int) -> Tuple[int, ...]:
+        """Return the steps that contribute a loss-history entry.
+
+        These are the logging steps together with, for each epoch, the step that closes
+        the accumulation window containing that epoch's last batch — so every epoch is
+        represented even when it does not land on a logging step.
+
+        Args:
+            log_every_n_steps: Logging period, in optimizer steps.
+
+        Returns:
+            Ascending tuple of unique 1-based optimizer steps.
+        """
+        steps = set(self.logging_steps(log_every_n_steps))
+        for epoch in range(1, self.epochs + 1):
+            last_batch = min(epoch * self.batches_per_epoch, self.total_batches)
+            steps.add(self.step_of_batch(last_batch))
+        return tuple(sorted(steps))
+
+
+@dataclass(frozen=True)
+class ResumePlan:
+    """Where a resumed run picks up, derived from a checkpoint and the current plan.
+
+    Attributes:
+        checkpoint_name: Name of the checkpoint being resumed from.
+        start_batch_ordinal: Batches already done, i.e. the 0-based index of the next batch.
+        start_epoch: 1-based epoch of the next batch.
+        start_batch_in_epoch: 0-based position of the next batch inside its epoch.
+        completed_steps: Optimizer steps completed before the resume.
+        remaining_batches: Batches still to run.
+    """
+
+    checkpoint_name: str
+    start_batch_ordinal: int
+    start_epoch: int
+    start_batch_in_epoch: int
+    completed_steps: int
+    remaining_batches: int
+
+
+def dataset_signature(examples: Sequence[Mapping[str, Any]]) -> str:
+    """Compute a content signature of a dataset.
+
+    The signature is a function of the content of every example, in order: reordering
+    the examples or editing a single character changes it, while dict key order does not.
+
+    Args:
+        examples: The dataset rows, in training order.
+
+    Returns:
+        A signature of the form ``"ds1-<count>-<digest>"``.
+    """
+    payload = json.dumps(list(examples), sort_keys=True, separators=(",", ":"), default=str, ensure_ascii=True).encode("utf-8")
+    return f"{DATASET_SIGNATURE_PREFIX}-{len(examples)}-{xxh64(payload).hexdigest()}"
+
+
+def plan_steps(
+    num_examples: int,
+    *,
+    batch_size: int,
+    epochs: int,
+    gradient_accumulation_steps: int = 1,
+    dataset_signature: str = "",
+) -> StepPlan:
+    """Build the step plan for a batched training run.
+
+    The accumulation window is counted over the whole run and is not reset at an epoch
+    boundary, so a window may span one. A short final window still counts as one whole
+    optimizer step.
+
+    Args:
+        num_examples: Number of examples in the dataset.
+        batch_size: Examples per batch.
+        epochs: Number of passes over the dataset.
+        gradient_accumulation_steps: Batches per optimizer step.
+        dataset_signature: Content signature of the dataset, from `dataset_signature`.
+
+    Returns:
+        The StepPlan for the run.
+
+    Raises:
+        StepLedgerError: If the dataset is empty or any of the shape arguments is < 1.
+    """
+    if num_examples == 0:
+        raise StepLedgerError("Cannot plan a training run over an empty dataset.")
+    if batch_size < 1:
+        raise StepLedgerError(f"batch_size must be >= 1, got {batch_size}")
+    if epochs < 1:
+        raise StepLedgerError(f"epochs must be >= 1, got {epochs}")
+    if gradient_accumulation_steps < 1:
+        raise StepLedgerError(f"gradient_accumulation_steps must be >= 1, got {gradient_accumulation_steps}")
+
+    batches_per_epoch = math.ceil(num_examples / batch_size)
+    total_batches = batches_per_epoch * epochs
+    total_steps = math.ceil(total_batches / gradient_accumulation_steps)
+
+    return StepPlan(
+        step_unit=STEP_UNIT_OPTIMIZER,
+        num_examples=num_examples,
+        batch_size=batch_size,
+        epochs=epochs,
+        gradient_accumulation_steps=gradient_accumulation_steps,
+        batches_per_epoch=batches_per_epoch,
+        total_batches=total_batches,
+        total_steps=total_steps,
+        trailing_window_batches=total_batches - (total_steps - 1) * gradient_accumulation_steps,
+        dataset_signature=dataset_signature,
+    )
+
+
+def plan_steps_for_config(config: "TinkerTrainerConfig", examples: Sequence[Mapping[str, Any]]) -> StepPlan:
+    """Build the step plan for a TinkerTrainer run over a dataset.
+
+    Args:
+        config: The trainer config supplying the run's shape.
+        examples: The dataset rows, in training order.
+
+    Returns:
+        The StepPlan for the run.
+
+    Raises:
+        StepLedgerError: If the dataset is empty or the config's shape is not usable.
+    """
+    return plan_steps(
+        len(examples),
+        batch_size=config.batch_size,
+        epochs=config.epochs,
+        gradient_accumulation_steps=config.gradient_accumulation_steps,
+        dataset_signature=dataset_signature(examples),
+    )
+
+
+def plan_packed_steps(num_examples: int, *, epochs: int, dataset_signature: str = "") -> StepPlan:
+    """Build the step plan for a managed run that packs each epoch into a single step.
+
+    Args:
+        num_examples: Number of examples in the dataset.
+        epochs: Number of passes over the dataset, i.e. the number of packed steps.
+        dataset_signature: Content signature of the dataset, from `dataset_signature`.
+
+    Returns:
+        The StepPlan for the run, with `step_unit` `STEP_UNIT_PACKED`.
+
+    Raises:
+        StepLedgerError: If the dataset is empty or ``epochs`` is < 1.
+    """
+    if num_examples == 0:
+        raise StepLedgerError("Cannot plan a training run over an empty dataset.")
+    if epochs < 1:
+        raise StepLedgerError(f"epochs must be >= 1, got {epochs}")
+
+    return StepPlan(
+        step_unit=STEP_UNIT_PACKED,
+        num_examples=num_examples,
+        batch_size=num_examples,
+        epochs=epochs,
+        gradient_accumulation_steps=1,
+        batches_per_epoch=1,
+        total_batches=epochs,
+        total_steps=epochs,
+        trailing_window_batches=1,
+        dataset_signature=dataset_signature,
+    )
+
+
+def canonical_reasons(reasons: Sequence[str]) -> Tuple[str, ...]:
+    """Deduplicate checkpoint trigger names and order them by the ledger's vocabulary.
+
+    Args:
+        reasons: Trigger names, in any order and with any repetitions.
+
+    Returns:
+        The unique triggers in `CHECKPOINT_REASONS` order.
+
+    Raises:
+        StepLedgerError: If any name is outside `CHECKPOINT_REASONS`.
+    """
+    unknown = [reason for reason in reasons if reason not in CHECKPOINT_REASONS]
+    if unknown:
+        raise StepLedgerError(f"Unknown checkpoint reason(s) {unknown}; expected any of {list(CHECKPOINT_REASONS)}")
+    return tuple(reason for reason in CHECKPOINT_REASONS if reason in reasons)
+
+
+def checkpoint_name(prefix: str, step: int) -> str:
+    """Return the deterministic checkpoint name for a step.
+
+    Args:
+        prefix: Configured checkpoint name prefix.
+        step: The 1-based optimizer step the checkpoint was taken at.
+
+    Returns:
+        The checkpoint name, with the step zero-padded so names sort lexicographically.
+    """
+    return CHECKPOINT_NAME_TEMPLATE.format(prefix=prefix, step=step)
+
+
+def learning_rate_at(step: int, total_steps: int, base_lr: float, warmup_steps: int, *, min_lr_ratio: float = MIN_LR_RATIO) -> float:
+    """Return the learning rate of a 1-based optimizer step.
+
+    Warmup is inclusive and 1-based, so the first optimizer step is never zero and the
+    step numbered ``warmup_steps`` is the first one at the full base rate. After warmup
+    the rate decays linearly to ``min_lr_ratio * base_lr``, reached exactly at
+    ``total_steps`` and clamped there beyond the end of the run. A ``warmup_steps``
+    longer than the run is clipped to the run length.
+
+    Args:
+        step: The 1-based optimizer step.
+        total_steps: Optimizer steps in the whole run.
+        base_lr: The configured (peak) learning rate.
+        warmup_steps: Optimizer steps of linear warmup.
+        min_lr_ratio: Floor of the decay, as a fraction of ``base_lr``.
+
+    Returns:
+        The learning rate for that step.
+    """
+    effective_warmup = min(warmup_steps, total_steps)
+
+    if effective_warmup > 0 and step <= effective_warmup:
+        return base_lr * step / effective_warmup
+
+    progress = min((step - effective_warmup) / max(total_steps - effective_warmup, 1), 1.0)
+    return base_lr * (1.0 - (1.0 - min_lr_ratio) * progress)
+
+
+def plan_resume(plan: StepPlan, checkpoint: "CheckpointInfo") -> ResumePlan:
+    """Validate a checkpoint against the current plan and locate where the run continues.
+
+    Validation happens in a fixed order: the shape the checkpoint was taken in, then
+    whether the plan still has batches left, then whether the checkpoint's step agrees
+    with its batch count. Raising ``epochs`` alone is a legal resume: the plan grows and
+    the schedule continues from ``completed_steps + 1``.
+
+    Args:
+        plan: The plan for the run about to start.
+        checkpoint: The checkpoint the run is resuming from.
+
+    Returns:
+        The ResumePlan describing where the run picks up.
+
+    Raises:
+        ResumePlanMismatch: If the checkpoint was taken in a different shape, the plan
+            is already exhausted, or the checkpoint is internally inconsistent.
+    """
+    shape_fields = {
+        "batch_size": (plan.batch_size, checkpoint.batch_size),
+        "dataset_signature": (plan.dataset_signature, checkpoint.dataset_signature),
+        "gradient_accumulation_steps": (plan.gradient_accumulation_steps, checkpoint.gradient_accumulation_steps),
+    }
+    mismatched = tuple(sorted(name for name, (expected, found) in shape_fields.items() if expected != found))
+    if mismatched:
+        raise ResumePlanMismatch(
+            checkpoint_name=checkpoint.name,
+            mismatched_fields=mismatched,
+            expected={name: shape_fields[name][0] for name in mismatched},
+            found={name: shape_fields[name][1] for name in mismatched},
+        )
+
+    if checkpoint.batches_completed >= plan.total_batches:
+        raise ResumePlanMismatch(
+            checkpoint_name=checkpoint.name,
+            mismatched_fields=("epochs",),
+            expected={"epochs": plan.epochs, "total_batches": plan.total_batches},
+            found={"batches_completed": checkpoint.batches_completed},
+        )
+
+    expected_step = plan.step_of_batch(checkpoint.batches_completed)
+    if checkpoint.step != expected_step:
+        raise ResumePlanMismatch(
+            checkpoint_name=checkpoint.name,
+            mismatched_fields=("step",),
+            expected={"step": expected_step},
+            found={"step": checkpoint.step},
+        )
+
+    batches_completed = checkpoint.batches_completed
+    return ResumePlan(
+        checkpoint_name=checkpoint.name,
+        start_batch_ordinal=batches_completed,
+        start_epoch=batches_completed // plan.batches_per_epoch + 1,
+        start_batch_in_epoch=batches_completed % plan.batches_per_epoch,
+        completed_steps=checkpoint.step,
+        remaining_batches=plan.total_batches - batches_completed,
+    )
