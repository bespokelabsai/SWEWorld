#!/usr/bin/env bash
# world-verify — acceptance gate for the SWEWorld image.
#
# Runs INSIDE the container. Asserts every service answers, the vhost ingress
# routes, the privilege model actually holds, and the deploy path is wired.
# Exits non-zero on any failure, so `make bake-image` refuses to commit a world
# that does not clear the floor.
set -uo pipefail
DOMAIN="${WORLD_DOMAIN:-world.local}"
PASS=0; FAIL=0
ok()  { printf '  \033[32mPASS\033[0m  %s\n' "$*"; PASS=$((PASS+1)); }
bad() { printf '  \033[31mFAIL\033[0m  %s\n' "$*"; FAIL=$((FAIL+1)); }
note(){ printf '        \033[90m%s\033[0m\n' "$*"; }
head_(){ printf '\n\033[1;36m%s\033[0m\n' "$*"; }

head_ "Supervised services"
# Let any STARTING program finish its startsecs window first. Mattermost
# answers its API well before supervisord promotes it to RUNNING, so checking
# immediately reports a failure that is really just a race.
for _ in $(seq 1 15); do
  supervisorctl -c /etc/supervisor/supervisord.conf status 2>/dev/null \
    | grep -q STARTING || break
  sleep 2
done
for p in postgres mariadb php-fpm nginx gitea maddy mattermost act-runner deploy-daemon; do
  # entries print as "group:program" (app:curator) or bare "init-runtime"
  st="$(supervisorctl -c /etc/supervisor/supervisord.conf status 2>/dev/null \
        | awk -v p="$p" '$1==p || $1 ~ (":" p "$") {print $2; exit}')"
  [[ "$st" == "RUNNING" ]] && ok "$p RUNNING" || bad "$p is ${st:-MISSING}"
done

head_ "Vhost ingress (nginx :80)"
check() { # check <label> <host> <path> <expect>
  local body code
  # -L: BookStack 302s to /login, so the landing body is what matters
  body="$(curl -sL --max-time 15 -H "Host: $2" -w '\n%{http_code}' "http://127.0.0.1$3" 2>/dev/null)"
  code="$(printf '%s' "$body" | tail -1)"; body="$(printf '%s' "$body" | sed '$d')"
  if [[ "$code" != 200 && "$code" != 302 ]]; then bad "$1 — HTTP $code"; return; fi
  if [[ -n "${4:-}" ]] && ! printf '%s' "$body" | grep -qi -- "$4"; then bad "$1 — missing '$4'"; return; fi
  ok "$1"
}
check "git.$DOMAIN  -> Gitea"      "git.$DOMAIN"  "/" "gitea"
check "chat.$DOMAIN -> Mattermost" "chat.$DOMAIN" "/" "mattermost"
check "docs.$DOMAIN -> BookStack"  "docs.$DOMAIN" "/" "bookstack"
check "mail.$DOMAIN -> Roundcube"  "mail.$DOMAIN" "/" "webmail\|roundcube\|login"
check "pass.$DOMAIN -> passstore"  "pass.$DOMAIN" "/" "credentials"

head_ "Service APIs"
check "Gitea /api/v1/version"        "git.$DOMAIN"  "/api/v1/version"     "version"
check "Mattermost /api/v4/system/ping" "chat.$DOMAIN" "/api/v4/system/ping" "OK"

head_ "Mail (raw ports, not proxied)"
python3 - <<'PY'
import imaplib, smtplib, sys, os
G,R,X="\033[32m","\033[31m","\033[0m"
def ok(m): print(f"  {G}PASS{X}  {m}")
def bad(m): print(f"  {R}FAIL{X}  {m}"); sys.exit(1)
try:
    M=imaplib.IMAP4("127.0.0.1",143); ok("IMAP :143 greeting")
    M.login("worldadmin@"+os.environ.get("WORLD_DOMAIN","world.local"),
            os.environ.get("WORLD_ADMIN_PASSWORD","worldadmin"))
    ok("IMAP login as worldadmin"); M.logout()
except Exception as e: bad(f"IMAP: {e}")
try:
    S=smtplib.SMTP("127.0.0.1",587,timeout=10); S.ehlo(); ok("SMTP :587 greeting"); S.quit()
except Exception as e: bad(f"SMTP: {e}")
PY
[[ $? -eq 0 ]] && PASS=$((PASS+1)) || FAIL=$((FAIL+1))

head_ "Curator repository"
TOKEN="$(cat /etc/sweworld/gitea-token 2>/dev/null)"
REPO="$(curl -s --max-time 10 -H "Authorization: token $TOKEN" \
  http://127.0.0.1:3300/api/v1/repos/worldadmin/curator 2>/dev/null)"
if printf '%s' "$REPO" | grep -q '"name":"curator"'; then
  ok "curator repo exists in Gitea"
  CNT="$(curl -s -H "Authorization: token $TOKEN" \
    'http://127.0.0.1:3300/api/v1/repos/worldadmin/curator/commits?limit=5' 2>/dev/null | grep -c '"sha"')"
  note "commits visible: $CNT"
else
  bad "curator repo missing from Gitea"
fi

head_ "Privilege model"
# The whole point: the agent cannot escalate, deploy, or inspect world state.
su -s /bin/bash ubuntu -c 'sudo -n true' >/dev/null 2>&1 \
  && bad "agent (ubuntu) HAS sudo — privilege model broken" \
  || ok "agent has no sudo"
su -s /bin/bash ubuntu -c 'supervisorctl -c /etc/supervisor/supervisord.conf status' >/dev/null 2>&1 \
  && bad "agent can reach supervisord — privilege model broken" \
  || ok "agent cannot reach supervisord"
su -s /bin/bash ubuntu -c 'ls /opt/sweworld/deploy-queue' >/dev/null 2>&1 \
  && bad "agent can read the deploy spool — privilege model broken" \
  || ok "agent cannot read the deploy spool"
su -s /bin/bash ubuntu -c 'ls /opt/world-state' >/dev/null 2>&1 \
  && bad "agent can read /opt/world-state — privilege model broken" \
  || ok "agent cannot read /opt/world-state"
[[ -x /usr/local/bin/request-deploy ]] && ok "request-deploy present (CI deploy path)" \
  || bad "request-deploy missing"
[[ -L /opt/sweworld/curator/current ]] && ok "curator has a current release symlink" \
  || bad "curator current symlink missing"

head_ "Summary"
printf '  %d passed, %d failed\n\n' "$PASS" "$FAIL"
[[ $FAIL -eq 0 ]] || exit 1
printf '\033[1;32mWorld verified.\033[0m\n'
