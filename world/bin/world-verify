#!/usr/bin/env bash
# world-verify — acceptance gate for the SWEWorld image.
#
# Runs INSIDE the container. Asserts every service answers, the vhost ingress
# routes, the privilege model actually holds, and the deploy path is wired.
# Exits non-zero on any failure, so `make bake-image` refuses to commit a world
# that does not clear the floor.
set -uo pipefail
DOMAIN="${WORLD_DOMAIN:-world.local}"
PASS=0; FAIL=0
ok()  { printf '  \033[32mPASS\033[0m  %s\n' "$*"; PASS=$((PASS+1)); }
bad() { printf '  \033[31mFAIL\033[0m  %s\n' "$*"; FAIL=$((FAIL+1)); }
note(){ printf '        \033[90m%s\033[0m\n' "$*"; }
head_(){ printf '\n\033[1;36m%s\033[0m\n' "$*"; }

head_ "Supervised services"
# Let any STARTING program finish its startsecs window first. Mattermost
# answers its API well before supervisord promotes it to RUNNING, so checking
# immediately reports a failure that is really just a race.
for _ in $(seq 1 15); do
  supervisorctl -c /etc/supervisor/supervisord.conf status 2>/dev/null \
    | grep -q STARTING || break
  sleep 2
done
for p in postgres mariadb php-fpm nginx gitea maddy mattermost act-runner deploy-daemon; do
  # entries print as "group:program" (app:curator) or bare "init-runtime"
  st="$(supervisorctl -c /etc/supervisor/supervisord.conf status 2>/dev/null \
        | awk -v p="$p" '$1==p || $1 ~ (":" p "$") {print $2; exit}')"
  [[ "$st" == "RUNNING" ]] && ok "$p RUNNING" || bad "$p is ${st:-MISSING}"
done

head_ "Vhost ingress (nginx :80)"
check() { # check <label> <host> <path> <expect>
  local body code
  # -L: BookStack 302s to /login, so the landing body is what matters
  body="$(curl -sL --max-time 15 -H "Host: $2" -w '\n%{http_code}' "http://127.0.0.1$3" 2>/dev/null)"
  code="$(printf '%s' "$body" | tail -1)"; body="$(printf '%s' "$body" | sed '$d')"
  if [[ "$code" != 200 && "$code" != 302 ]]; then bad "$1 — HTTP $code"; return; fi
  if [[ -n "${4:-}" ]] && ! printf '%s' "$body" | grep -qi -- "$4"; then bad "$1 — missing '$4'"; return; fi
  ok "$1"
}
check "git.$DOMAIN  -> Gitea"      "git.$DOMAIN"  "/" "gitea"
check "chat.$DOMAIN -> Mattermost" "chat.$DOMAIN" "/" "mattermost"
check "docs.$DOMAIN -> BookStack"  "docs.$DOMAIN" "/" "bookstack"
check "mail.$DOMAIN -> Roundcube"  "mail.$DOMAIN" "/" "webmail\|roundcube\|login"
check "pass.$DOMAIN -> passstore"  "pass.$DOMAIN" "/" "credentials"

head_ "Service APIs"
check "Gitea /api/v1/version"        "git.$DOMAIN"  "/api/v1/version"     "version"
check "Mattermost /api/v4/system/ping" "chat.$DOMAIN" "/api/v4/system/ping" "OK"

head_ "Mail (raw ports, not proxied)"
python3 - <<'PY'
import imaplib, smtplib, sys, os
G,R,X="\033[32m","\033[31m","\033[0m"
def ok(m): print(f"  {G}PASS{X}  {m}")
def bad(m): print(f"  {R}FAIL{X}  {m}"); sys.exit(1)
try:
    M=imaplib.IMAP4("127.0.0.1",143); ok("IMAP :143 greeting")
    M.login("worldadmin@"+os.environ.get("WORLD_DOMAIN","world.local"),
            os.environ.get("WORLD_ADMIN_PASSWORD","worldadmin"))
    ok("IMAP login as worldadmin"); M.logout()
except Exception as e: bad(f"IMAP: {e}")
try:
    S=smtplib.SMTP("127.0.0.1",587,timeout=10); S.ehlo(); ok("SMTP :587 greeting"); S.quit()
except Exception as e: bad(f"SMTP: {e}")
PY
[[ $? -eq 0 ]] && PASS=$((PASS+1)) || FAIL=$((FAIL+1))

head_ "Admin can actually sign in"
# Not just "the service responds": a world whose credentials do not work is
# unusable, and looks perfectly healthy from every other check here.
ADMIN_USER="${WORLD_ADMIN_USER:-worldadmin}"
ADMIN_PASS="${WORLD_ADMIN_PASSWORD:-worldadmin}"
ADMIN_MAIL="${WORLD_ADMIN_EMAIL:-worldadmin@${DOMAIN}}"

curl -s --max-time 10 -u "${ADMIN_USER}:${ADMIN_PASS}" http://127.0.0.1:3300/api/v1/user 2>/dev/null \
  | grep -q '"login"' && ok "Gitea login as ${ADMIN_USER}" || bad "Gitea login as ${ADMIN_USER} failed"

curl -s --max-time 15 -X POST -H "Content-Type: application/json" \
  -d "{\"login_id\":\"${ADMIN_USER}\",\"password\":\"${ADMIN_PASS}\"}" \
  http://127.0.0.1:8065/api/v4/users/login 2>/dev/null \
  | grep -q '"id"' && ok "Mattermost login as ${ADMIN_USER}" || bad "Mattermost login as ${ADMIN_USER} failed"

# BookStack: POST the real login form. Its password is set through the model at
# build time, and an unexported ADMIN_PASS once hashed the empty string here —
# every other check still passed while no one could log in.
BS_JAR="$(mktemp)"
BS_TOKEN="$(curl -s -c "$BS_JAR" http://127.0.0.1:7090/login 2>/dev/null \
  | grep -oE 'name="_token" value="[^"]+"' | sed 's/.*value="//;s/"//')"
BS_CODE="$(curl -s -b "$BS_JAR" -c "$BS_JAR" -o /dev/null -w '%{redirect_url}' -X POST \
  http://127.0.0.1:7090/login \
  -d "_token=${BS_TOKEN}" -d "email=${ADMIN_MAIL}" -d "password=${ADMIN_PASS}" 2>/dev/null)"
rm -f "$BS_JAR"
# A rejected login redirects back to /login; a good one goes to the root.
if [[ -n "$BS_CODE" && "$BS_CODE" != *"/login"* ]]; then
  ok "BookStack login as ${ADMIN_MAIL}"
else
  bad "BookStack login as ${ADMIN_MAIL} failed (landed at ${BS_CODE:-nowhere})"
fi

# Roundcube: the webmail login is a separate question from IMAP working. Its
# php-fpm user (www-data) differs from every other service's, so a permissions
# slip breaks the browser login while imaplib still succeeds.
RC_JAR="$(mktemp)"
RC_TOKEN="$(curl -s -c "$RC_JAR" http://127.0.0.1:7080/ 2>/dev/null \
  | grep -oE 'name="_token" value="[^"]*"' | sed 's/.*value="//;s/"//')"
RC_REDIR="$(curl -s -b "$RC_JAR" -c "$RC_JAR" -o /dev/null -w '%{redirect_url}' -X POST \
  "http://127.0.0.1:7080/?_task=login" \
  -d "_token=${RC_TOKEN}" -d "_task=login" -d "_action=login" \
  -d "_user=${ADMIN_MAIL}" -d "_pass=${ADMIN_PASS}" 2>/dev/null)"
rm -f "$RC_JAR"
if [[ "$RC_REDIR" == *"_task=mail"* ]]; then
  ok "Roundcube webmail login as ${ADMIN_MAIL}"
else
  bad "Roundcube webmail login failed (landed at ${RC_REDIR:-nowhere})"
fi

head_ "Curator repository"
TOKEN="$(cat /etc/sweworld/gitea-token 2>/dev/null)"
REPO="$(curl -s --max-time 10 -H "Authorization: token $TOKEN" \
  http://127.0.0.1:3300/api/v1/repos/worldadmin/curator 2>/dev/null)"
if printf '%s' "$REPO" | grep -q '"name":"curator"'; then
  ok "curator repo exists in Gitea"
  # The real count comes from the pagination header, not from counting "sha" in
  # a page of five: a commit object mentions several, so the old grep reported a
  # number that was neither the page size nor the total.
  CNT="$(curl -sI -H "Authorization: token $TOKEN" \
    'http://127.0.0.1:3300/api/v1/repos/worldadmin/curator/commits?limit=1' 2>/dev/null \
    | tr -d '\r' | awk -F': ' '/^[Xx]-Total:/ {print $2; exit}')"
  BRANCHES="$(curl -s -H "Authorization: token $TOKEN" \
    'http://127.0.0.1:3300/api/v1/repos/worldadmin/curator/branches?limit=100' \
    2>/dev/null | grep -o '"user_can_push"' | wc -l)"
  TAGS="$(curl -s -H "Authorization: token $TOKEN" \
    'http://127.0.0.1:3300/api/v1/repos/worldadmin/curator/tags?limit=100' \
    2>/dev/null | grep -o '"zipball_url"' | wc -l)"
  note "commits on the default branch: ${CNT:-?}, branches: $BRANCHES, tags: $TAGS"
  if [ "${BRANCHES:-0}" -gt 1 ]; then
    ok "history has been ingested (more than the bootstrap baseline)"
  else
    note "only the bootstrap baseline is present — run scripts/ingest_history.py"
  fi
else
  bad "curator repo missing from Gitea"
fi

head_ "The corpus"
# Everything above this line passes on an EMPTY world. Services answer, the
# vhosts route, the admin can log in, the privilege model holds — and BookStack
# has no pages, Mattermost no messages, the mailboxes nothing. That is exactly
# the world `make run` gives you, by design, and for a long time it was also a
# world `make bake-image` would happily commit and publish.
#
# So these are the checks that make a baked image mean something. Thresholds
# sit well under the real numbers on purpose: the question is "did the corpus
# get in", not "is it byte-identical to the one I generated".
#
# Each query is the one the service itself uses, not the one that looks right:
# BookStack keeps books and pages in ONE `entities` table discriminated by
# `type`, maddy keeps mail in an SQLite store and not in maildirs, and there is
# no `sudo` in this image — postgres is reached the way 10-datastores.sh does.
#
# Set WORLD_EXPECT_CORPUS=0 to bake a deliberately empty, services-only image.
if [ "${WORLD_EXPECT_CORPUS:-1}" = "0" ]; then
  note "WORLD_EXPECT_CORPUS=0 — not checking for corpus content"
else
  MARIA="mariadb --socket=/run/mysqld/mysqld.sock -N -B -s -D bookstack"
  PAGES="$($MARIA -e "SELECT COUNT(*) FROM entities WHERE type='page' AND deleted_at IS NULL;" 2>/dev/null)"
  BOOKS="$($MARIA -e "SELECT COUNT(*) FROM entities WHERE type='book' AND deleted_at IS NULL;" 2>/dev/null)"
  if [ "${PAGES:-0}" -ge "${CORPUS_MIN_PAGES:-100}" ] \
     && [ "${BOOKS:-0}" -ge "${CORPUS_MIN_BOOKS:-5}" ]; then
    ok "wiki has $PAGES page(s) across $BOOKS book(s)"
  else
    bad "wiki has ${PAGES:-0} page(s) in ${BOOKS:-0} book(s) — expected at least ${CORPUS_MIN_PAGES:-100} in ${CORPUS_MIN_BOOKS:-5}; did ingest_docs.py run?"
  fi

  # Posts, not channels: an empty world already HAS the channels, because the
  # bootstrap creates them. Only the posts prove the chat corpus landed.
  POSTS="$(su -s /bin/bash postgres -c \
    "psql -h /tmp -tAq -d mattermost -c 'SELECT COUNT(*) FROM posts WHERE deleteat = 0;'" \
    2>/dev/null | tr -d ' ')"
  if [ "${POSTS:-0}" -ge "${CORPUS_MIN_POSTS:-9000}" ]; then
    ok "chat has $POSTS message(s)"
  else
    bad "chat has ${POSTS:-0} message(s) — expected at least ${CORPUS_MIN_POSTS:-9000}; did ingest_chat.py run?"
  fi

  MAILS="$(sqlite3 /var/lib/world/maddy/imapsql.db 'SELECT COUNT(*) FROM msgs;' 2>/dev/null)"
  if [ "${MAILS:-0}" -ge "${CORPUS_MIN_MAILS:-500}" ]; then
    ok "mail store holds $MAILS message(s)"
  else
    bad "mail store holds ${MAILS:-0} message(s) — expected at least ${CORPUS_MIN_MAILS:-500}; did ingest_mail.py run?"
  fi

  ISSUES="$(sqlite3 /var/lib/world/gitea/gitea.db 'SELECT COUNT(*) FROM issue;' 2>/dev/null)"
  if [ "${ISSUES:-0}" -ge "${CORPUS_MIN_ISSUES:-100}" ]; then
    ok "forge has $ISSUES issue(s) and pull request(s)"
  else
    bad "forge has ${ISSUES:-0} issue(s)/PR(s) — expected at least ${CORPUS_MIN_ISSUES:-100}; did ingest_forge.py run?"
  fi
fi

head_ "Privilege model"
# The whole point: the agent cannot escalate, deploy, or inspect world state.
su -s /bin/bash ubuntu -c 'sudo -n true' >/dev/null 2>&1 \
  && bad "agent (ubuntu) HAS sudo — privilege model broken" \
  || ok "agent has no sudo"
su -s /bin/bash ubuntu -c 'supervisorctl -c /etc/supervisor/supervisord.conf status' >/dev/null 2>&1 \
  && bad "agent can reach supervisord — privilege model broken" \
  || ok "agent cannot reach supervisord"
su -s /bin/bash ubuntu -c 'ls /opt/sweworld/deploy-queue' >/dev/null 2>&1 \
  && bad "agent can read the deploy spool — privilege model broken" \
  || ok "agent cannot read the deploy spool"
su -s /bin/bash ubuntu -c 'ls /opt/world-state' >/dev/null 2>&1 \
  && bad "agent can read /opt/world-state — privilege model broken" \
  || ok "agent cannot read /opt/world-state"
[[ -x /usr/local/bin/request-deploy ]] && ok "request-deploy present (CI deploy path)" \
  || bad "request-deploy missing"
[[ -L /opt/sweworld/curator/current ]] && ok "curator has a current release symlink" \
  || bad "curator current symlink missing"

head_ "Summary"
printf '  %d passed, %d failed\n\n' "$PASS" "$FAIL"
[[ $FAIL -eq 0 ]] || exit 1
printf '\033[1;32mWorld verified.\033[0m\n'
